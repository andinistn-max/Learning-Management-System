        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% SUB-ALUR ADMIN\n    KeHal2Admin([Konektor: Masuk Panel Admin]) --&gt; DashAdmin[Dashboard Admin]\n    DashAdmin --&gt; AksisAdmin[/Pilih Menu: Kelola User / Monitoring Kelas/]\n    AksisAdmin --&gt; SaveAdminDB[(UPDATE / INSERT ke Database)]\n    SaveAdminDB --&gt; Selesai([SELESAI])\n\n    %% SUB-ALUR GURU\n    KeHal2Guru([Konektor: Masuk Panel Guru]) --&gt; DashGuru[Dashboard Guru]\n    DashGuru --&gt; MenuGuru{if pilih Input Nilai?}\n    MenuGuru -- False --&gt; UploadModul[(INSERT Materi / Kuis ke Database)] --&gt; Selesai\n    MenuGuru -- True --&gt; InputNilai[/Input Nilai Tugas &amp; Kuis Siswa/]\n    InputNilai --&gt; UpdateNilaiDB[(UPDATE Tbl_Nilai)] --&gt; Selesai\n\n    %% SUB-ALUR SISWA\n    KeHal2Siswa([Konektor: Masuk Panel Siswa]) --&gt; DashSiswa[Dashboard Siswa: Tahap Pondasi]\n    DashSiswa --&gt; Belajar[/Kirim Presensi, Kerjakan Kuis, Upload Tugas/]\n    Belajar --&gt; SimpanAktivitasDB[(INSERT Tugas &amp; Kuis ke Database)]\n    \n    %% LOGIKA EVALUASI NILAI\n    SimpanAktivitasDB --&gt; HitungRataRata[Hitung Rata-rata: Tugas + Kuis + Presensi]\n    HitungRataRata --&gt; CekLulus{if nilaiAkhir &gt;= 70?}\n    \n    CekLulus -- False --&gt; StatusRemedial[Set Status: Tidak Lulus / Remedial]\n    StatusRemedial --&gt; Selesai\n\n    CekLulus -- True --&gt; SortRanking[Query ORDER BY nilaiAkhir DESC]\n    \n    %% PENJURUSAN TIER\n    SortRanking --&gt; CekTier1{if ranking &lt;= Kuota Java?}\n    CekTier1 -- True --&gt; SimpanJava[(UPDATE DB: Spesialisasi Java)] --&gt; CetakTranskrip\n    \n    CekTier1 -- False --&gt; CekTier2{if ranking &lt;= Kuota C#?}\n    CekTier2 -- True --&gt; SimpanCSharp[(UPDATE DB: Spesialisasi C# .NET)] --&gt; CetakTranskrip\n    CekTier2 -- False --&gt; SimpanReact[(UPDATE DB: Spesialisasi React)] --&gt; CetakTranskrip\n\n    CetakTranskrip[Terbitkan Transkrip Nilai &amp; Portofolio] --&gt; Selesai&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="96ltbdssx2p2jHHYmxWj-28">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
