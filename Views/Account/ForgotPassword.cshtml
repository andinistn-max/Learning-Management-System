@model Learning_Management_System.Models.ViewModel.ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lupa Password - PUB Learning Hub";
    ViewBag.IsPublicPage = true;
}

@section styles {
    <style>
        .forgot-container {
            min-height: calc(100vh - 180px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 1rem;
            background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        }

        .forgot-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(15, 23, 42, 0.06);
            width: 100%;
            max-width: 450px;
            padding: 2.5rem 2rem;
        }

        .forgot-brand {
            text-align: center;
            margin-bottom: 1.75rem;
        }

        .forgot-brand-icon {
            width: 52px;
            height: 52px;
            background: #eff6ff;
            color: #2563eb;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin: 0 auto 0.85rem auto;
            border: 1px solid #dbeafe;
        }

        .forgot-brand-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.6rem;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.5px;
            margin-bottom: 0.35rem;
        }

        .forgot-brand-subtitle {
            font-size: 0.9rem;
            color: #64748b;
            line-height: 1.5;
        }

        .form-label-custom {
            font-weight: 600;
            font-size: 0.875rem;
            color: #334155;
            margin-bottom: 0.4rem;
        }

        .input-group-custom {
            position: relative;
        }

        .input-group-custom .form-control {
            border-radius: 12px;
            border: 1.5px solid #cbd5e1;
            padding: 0.7rem 1rem 0.7rem 2.6rem;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .input-group-custom .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
        }

        .input-group-icon {
            position: absolute;
            left: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.2rem;
            z-index: 5;
            pointer-events: none;
        }

        .btn-forgot-submit {
            background: #2563eb;
            color: #ffffff !important;
            font-weight: 700;
            font-size: 1rem;
            padding: 0.85rem;
            border-radius: 12px;
            border: none;
            width: 100%;
            box-shadow: 0 6px 18px rgba(37, 99, 235, 0.3);
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-forgot-submit:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(37, 99, 235, 0.4);
        }

        .forgot-footer-text {
            text-align: center;
            font-size: 0.9rem;
            color: #64748b;
            margin-top: 1.75rem;
        }

        .forgot-footer-text a {
            color: #2563eb;
            font-weight: 700;
            text-decoration: none;
        }

        .forgot-footer-text a:hover {
            text-decoration: underline;
        }
    </style>
}

<div class="forgot-container">
    <div class="forgot-card">
        <!-- Brand Header -->
        <div class="forgot-brand">
            <div class="forgot-brand-icon">
                <i class="ti ti-key"></i>
            </div>
            <h1 class="forgot-brand-title">Lupa Password?</h1>
            <p class="forgot-brand-subtitle">Masukkan alamat email Anda untuk menerima tautan pemulihan kata sandi.</p>
        </div>

        <!-- Success Alert Flash Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3 p-3" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="ti ti-circle-check fs-2 text-success"></i>
                    <div class="text-dark small">@TempData["SuccessMessage"]</div>
                </div>
            </div>
        }

        <!-- Development Mode Link Preview -->
        @if (TempData["ResetLinkPreview"] != null)
        {
            <div class="alert alert-info rounded-3 mb-4 p-3 border-info">
                <div class="d-flex align-items-start gap-2">
                    <i class="ti ti-info-circle fs-2 text-info mt-1"></i>
                    <div>
                        <strong class="d-block text-dark small mb-1">Simulasi Tautan Reset (Development Mode):</strong>
                        <a href="@TempData["ResetLinkPreview"]" class="btn btn-sm btn-primary rounded-2 px-3 py-1">
                            <i class="ti ti-external-link me-1"></i> Buka Tautan Reset Password
                        </a>
                    </div>
                </div>
            </div>
        }

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { id = "forgot-form" }))
        {
            @Html.AntiForgeryToken()

            <!-- Validation Summary Error Message -->
            if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3 p-3" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti ti-alert-circle fs-2 text-danger"></i>
                        <div class="small">@Html.ValidationSummary(true, "", new { @class = "mb-0 text-danger" })</div>
                    </div>
                </div>
            }

            <!-- Email Input -->
            <div class="mb-4">
                <label for="Email" class="form-label-custom">Alamat Email Terdaftar</label>
                <div class="input-group-custom">
                    <i class="ti ti-mail input-group-icon"></i>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "nama@domain.com", id = "Email", autocomplete = "email" })
                </div>
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-forgot-submit" id="btn-submit-forgot">
                <span>Kirim Tautan Reset</span>
                <i class="ti ti-send fs-2"></i>
            </button>
        }

        <!-- Footer Link -->
        <div class="forgot-footer-text">
            Ingat kata sandi? <a href="@Url.Action("Login", "Account")" id="link-to-login">Kembali ke Login</a>
        </div>
    </div>
</div>
