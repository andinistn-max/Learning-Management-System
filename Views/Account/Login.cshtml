@model Learning_Management_System.Models.ViewModel.LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Masuk Ke Akun - PUB Learning Hub";
    ViewBag.IsPublicPage = true;
    string returnUrl = ViewBag.ReturnUrl as string;
}

@section styles {
    <style>
        /* Kanvas Utama: Warna Biru Box Register (Gradient #395886 ke #638ECB dengan Pola Halus) */
        body {
            background-color: #395886 !important;
            background-image: radial-gradient(rgba(255, 255, 255, 0.15) 1.2px, transparent 1.2px), linear-gradient(135deg, #395886 0%, #638ECB 100%) !important;
            background-size: 24px 24px, 100% 100% !important;
            background-attachment: fixed !important;
            min-height: 100vh;
            margin: 0;
            overflow-x: hidden;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #0F172A;
        }

        /* Container Penyelarasan Simetris */
        .login-page-container {
            min-height: calc(100vh - 72px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 0;
            position: relative;
            z-index: 1;
        }

        /* Sisi Kiri: Visual Lepas (Menempel Langsung di Kanvas Biru) */
        .login-left-visual {
            color: #FFFFFF;
            padding-right: 2rem;
        }

        .login-hero-img {
            max-height: 270px;
            width: auto;
            filter: drop-shadow(0 15px 25px rgba(15, 23, 42, 0.3));
            transition: transform 0.3s ease;
        }

        .login-hero-img:hover {
            transform: translateY(-4px);
        }

        /* Sisi Kanan: Kartu Form Login Transparan (Glassmorphism Elegan) */
        .login-floating-card {
            background: rgba(255, 255, 255, 0.16);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 28px;
            padding: 2.75rem 2.25rem;
            box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.35);
            width: 100%;
            max-width: 410px;
            position: relative;
            z-index: 10;
        }

        @@media (max-width: 767.98px) {
            .login-floating-card {
                padding: 2.25rem 1.5rem;
            }
        }

        /* Form Labels & Controls (Disamakan dengan Register: Input Putih Bersih) */
        .form-label-custom {
            font-weight: 600;
            font-size: 0.85rem;
            color: #FFFFFF;
            margin-bottom: 0.4rem;
        }

        .input-group-custom {
            position: relative;
        }

        .input-group-custom .form-control {
            border-radius: 12px;
            border: 1.5px solid #CBD5E1;
            background-color: #FFFFFF;
            padding: 0.7rem 2.85rem 0.7rem 2.65rem;
            font-size: 0.925rem;
            color: #0F172A;
            transition: all 0.2s ease;
        }

        .input-group-custom .form-control::placeholder {
            color: #94A3B8;
            opacity: 1;
        }

        .input-group-custom .form-control:focus {
            background-color: #FFFFFF;
            border-color: #395886;
            color: #0F172A;
            box-shadow: 0 0 0 4px rgba(57, 88, 134, 0.2);
            outline: none;
        }

        .input-group-icon {
            position: absolute;
            left: 0.95rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 1.15rem;
            z-index: 5;
            pointer-events: none;
        }

        .toggle-password-btn {
            position: absolute;
            right: 0.95rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 1.15rem;
            background: transparent;
            border: none;
            cursor: pointer;
            z-index: 5;
            padding: 0;
            transition: color 0.2s ease;
        }

        .toggle-password-btn:hover {
            color: #395886;
        }

        /* Checkbox & Text Error di dalam Card */
        .login-floating-card .form-check-input {
            background-color: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.6);
        }

        .login-floating-card .form-check-input:checked {
            background-color: #395886;
            border-color: #395886;
        }

        .login-floating-card .text-danger {
            color: #FFB4B4 !important;
            font-weight: 500;
        }

        /* Tombol Masuk (Brand Blue PUB #395886 seperti Register) */
        .btn-screenshot-submit {
            background-color: #395886;
            color: #FFFFFF !important;
            font-weight: 700;
            font-size: 0.975rem;
            padding: 0.8rem;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.25);
            transition: all 0.25s ease;
        }

        .btn-screenshot-submit:hover {
            background-color: #2B4366;
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.35);
        }

        /* Divider "atau masuk dengan" */
        .hr-text-custom {
            display: flex;
            align-items: center;
            color: #94A3B8;
            font-size: 0.8rem;
            margin: 1.25rem 0;
        }

        .hr-text-custom::before, .hr-text-custom::after {
            content: "";
            flex: 1;
            border-top: 1px solid #E2E8F0;
        }

        .hr-text-custom::before {
            margin-right: 0.75rem;
        }

        .hr-text-custom::after {
            margin-left: 0.75rem;
        }

        /* Tombol Google Login */
        .btn-google-screenshot {
            background: #FFFFFF;
            border: 1px solid #CBD5E1;
            color: #334155;
            font-weight: 500;
            font-size: 0.9rem;
            padding: 0.65rem 1.25rem;
            border-radius: 10px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-google-screenshot:hover {
            background: #F8FAFC;
            border-color: #94A3B8;
            color: #0F172A;
        }
    </style>
}

<div class="login-page-container">
    <div class="container-xl px-4 px-lg-5 my-auto">
        <div class="row align-items-center justify-content-between g-4 g-lg-5">
            
            <!-- SISI KIRI: Visual Lepas di Atas Kanvas Biru (Persis Screenshot) -->
            <div class="col-lg-6 col-xl-6 d-none d-lg-flex flex-column justify-content-center login-left-visual">
                <!-- Brand Header / Logo PUB -->
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="avatar rounded-circle shadow-sm border overflow-hidden bg-white d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px; min-width: 48px; border-color: #B1C9EF !important;">
                        <img src="@Url.Content("~/Content/images/logo-pub.png")" alt="Logo PUB" class="w-100 h-100 object-fit-contain" style="padding: 2px;" onerror="this.outerHTML='<span class=\'fw-bold text-white fs-4 w-100 h-100 rounded-circle d-flex align-items-center justify-content-center\' style=\'background-color: #395886;\'>PUB</span>';" />
                    </span>
                    <div>
                        <span class="fw-bold fs-3 text-white d-block lh-1">PUB Learning Hub</span>
                        <span class="text-white-50 small">Pemberdayaan Umat Berkelanjutan</span>
                    </div>
                </div>

                <!-- Copywriting Identitas Program Beasiswa -->
                <div class="mb-2">
                    <span class="badge rounded-pill px-3 py-1 mb-2 fw-normal" style="background: rgba(255, 255, 255, 0.18); color: #ffffff; font-size: 0.8rem; border: 1px solid rgba(255, 255, 255, 0.25);">
                        <i class="ti ti-shield-check me-1"></i> Portal Resmi Beasiswa
                    </span>
                    <h1 class="fw-bold text-white mb-2" style="font-size: 2.2rem; letter-spacing: -0.5px; line-height: 1.25;">
                        Pusat Pelatihan Pemrograman Terpadu
                    </h1>
                    <p class="text-white-50 mb-0" style="font-size: 0.95rem; line-height: 1.5; max-width: 460px;">
                        Khusus Awardee Beasiswa PUB &amp; Instruktur
                    </p>
                </div>

                <!-- Ilustrasi Koding 3D Workspace -->
                <div class="my-4">
                    <img src="@Url.Content("~/Content/images/hero-pub3.png")" 
                         alt="Ilustrasi Pelatihan Beasiswa PUB" 
                         class="img-fluid login-hero-img" 
                         onerror="this.style.display='none';" />
                </div>

                <!-- Feature Highlight Ringkas di Bawah Garis Pembatas -->
                <div class="pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.2) !important; max-width: 460px;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="background: rgba(255, 255, 255, 0.2); width: 36px; height: 36px;">
                            <i class="ti ti-code fs-3"></i>
                        </div>
                        <div class="small text-white-50 lh-sm">
                            Platform terpadu untuk materi modul, praktikum kuis coding, dan presensi otomatis.
                        </div>
                    </div>
                </div>
            </div>

            <!-- SISI KANAN: Kartu Form Login Putih Mengambang (Persis Screenshot) -->
            <div class="col-12 col-lg-5 col-xl-5 d-flex justify-content-center justify-content-lg-end">
                <div class="login-floating-card">
                    
                    <!-- Header Kartu: Judul Rata Tengah -->
                    <div class="mb-4 text-center">
                        <div class="d-lg-none mb-3">
                            <span class="avatar rounded-circle shadow-sm border overflow-hidden bg-white d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px; border-color: rgba(255, 255, 255, 0.4) !important;">
                                <img src="@Url.Content("~/Content/images/logo-pub.png")" alt="Logo PUB" class="w-100 h-100 object-fit-contain" style="padding: 2px;" />
                            </span>
                        </div>
                        <h2 class="fw-bold mb-0 text-center text-white" style="font-size: 1.65rem; letter-spacing: -0.5px;">Masuk ke Akun</h2>
                    </div>

                    <!-- Flash Message Sukses -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3 p-3" role="alert">
                            <div class="d-flex align-items-center gap-2">
                                <i class="ti ti-circle-check fs-2 text-success"></i>
                                <div class="text-dark small">@TempData["SuccessMessage"]</div>
                            </div>
                        </div>
                    }

                    <!-- Form Login -->
                    @using (Html.BeginForm("Login", "Account", new { returnUrl = returnUrl }, FormMethod.Post, new { id = "login-form" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Validation Summary Global Error -->
                        if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
                        {
                            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3 p-2.5" role="alert">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="ti ti-alert-circle fs-2 text-danger"></i>
                                    <div class="small">@Html.ValidationSummary(true, "", new { @class = "mb-0 text-danger" })</div>
                                </div>
                            </div>
                        }

                        <!-- 1. Alamat Email -->
                        <div class="mb-3">
                            <label for="Email" class="form-label-custom">Alamat Email</label>
                            <div class="input-group-custom">
                                <i class="ti ti-mail input-group-icon"></i>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "nama@domain.com", id = "Email", autocomplete = "email" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- 2. Password with Toggle Show/Hide -->
                        <div class="mb-3">
                            <label for="Password" class="form-label-custom">Password</label>
                            <div class="input-group-custom">
                                <i class="ti ti-lock input-group-icon"></i>
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Masukkan password", id = "Password", autocomplete = "current-password" })
                                <button type="button" class="toggle-password-btn" id="togglePassword" title="Tampilkan/Sembunyikan Password" tabindex="-1">
                                    <i class="ti ti-eye" id="eyeIcon"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- 3. Ingat Saya & Lupa Password -->
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <label class="form-check m-0 d-flex align-items-center gap-2">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input mt-0", id = "RememberMe" })
                                <span class="form-check-label text-white small" style="cursor: pointer; user-select: none;">Ingat Saya</span>
                            </label>
                            <a href="@Url.Action("ForgotPassword", "Account")" class="small text-white text-decoration-underline" id="link-forgot-password">Lupa Password?</a>
                        </div>

                        <!-- 4. Tombol Submit -->
                        <button type="submit" class="btn btn-screenshot-submit mb-3" id="btn-submit-login">
                            <span>Masuk ke Akun</span>
                            <i class="ti ti-login fs-3"></i>
                        </button>
                    }

                    <!-- Footer Link -->
                    <div class="text-center small text-white-50 mt-3">
                        Belum punya akun? <a href="@Url.Action("Register", "Account")" class="fw-bold text-white text-decoration-underline" id="link-to-register">Daftar sekarang</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Google Identity Services (GSI) SDK -->
<script src="https://accounts.google.com/gsi/client" async defer></script>

@section scripts {
    <script>
        function handleGoogleCredentialResponse(response) {
            if (response && response.credential) {
                var formData = new FormData();
                formData.append('credential', response.credential);

                fetch('@Url.Action("GoogleLogin", "Account")', {
                    method: 'POST',
                    body: formData
                })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (data.success) {
                        window.location.href = data.redirectUrl || '@Url.Action("Index", "Home")';
                    } else {
                        alert(data.message || 'Gagal autentikasi dengan akun Google.');
                    }
                })
                .catch(function (err) {
                    console.error('Error Google Login:', err);
                    alert('Terjadi kesalahan koneksi saat memproses login Google.');
                });
            }
        }

        window.onload = function () {
            if (typeof google !== 'undefined') {
                google.accounts.id.initialize({
                    client_id: "721759606132-juj9l004v2c069b22e1iuf0qghb8h78s.apps.googleusercontent.com",
                    callback: handleGoogleCredentialResponse
                });

                var btn = document.getElementById("btn-google-login");
                if (btn) {
                    btn.addEventListener("click", function () {
                        google.accounts.id.prompt();
                    });
                }
            }
        };

        // Toggle Show / Hide Password
        document.addEventListener("DOMContentLoaded", function () {
            var toggleBtn = document.getElementById("togglePassword");
            var passwordInput = document.getElementById("Password");
            var eyeIcon = document.getElementById("eyeIcon");

            if (toggleBtn && passwordInput && eyeIcon) {
                toggleBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (passwordInput.type === "password") {
                        passwordInput.type = "text";
                        eyeIcon.classList.remove("ti-eye");
                        eyeIcon.classList.add("ti-eye-off");
                    } else {
                        passwordInput.type = "password";
                        eyeIcon.classList.remove("ti-eye-off");
                        eyeIcon.classList.add("ti-eye");
                    }
                });
            }
        });
    </script>
}