@model Learning_Management_System.Models.ViewModel.ResetPasswordViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Atur Ulang Password - PUB Learning Hub";
    ViewBag.IsPublicPage = true;
}

@section styles {
    <style>
        .reset-container {
            min-height: calc(100vh - 180px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 1rem;
            background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        }

        .reset-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(15, 23, 42, 0.06);
            width: 100%;
            max-width: 450px;
            padding: 2.5rem 2rem;
        }

        .reset-brand {
            text-align: center;
            margin-bottom: 1.75rem;
        }

        .reset-brand-icon {
            width: 52px;
            height: 52px;
            background: #eff6ff;
            color: #2563eb;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin: 0 auto 0.85rem auto;
            border: 1px solid #dbeafe;
        }

        .reset-brand-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.6rem;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.5px;
            margin-bottom: 0.35rem;
        }

        .reset-brand-subtitle {
            font-size: 0.9rem;
            color: #64748b;
            line-height: 1.5;
        }

        .form-label-custom {
            font-weight: 600;
            font-size: 0.875rem;
            color: #334155;
            margin-bottom: 0.4rem;
        }

        .input-group-custom {
            position: relative;
        }

        .input-group-custom .form-control {
            border-radius: 12px;
            border: 1.5px solid #cbd5e1;
            padding: 0.7rem 2.8rem 0.7rem 2.6rem;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .input-group-custom .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
        }

        .input-group-icon {
            position: absolute;
            left: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.2rem;
            z-index: 5;
            pointer-events: none;
        }

        .toggle-password-btn {
            position: absolute;
            right: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.15rem;
            background: transparent;
            border: none;
            cursor: pointer;
            z-index: 5;
            padding: 0;
            transition: color 0.2s ease;
        }

        .toggle-password-btn:hover {
            color: #2563eb;
        }

        .btn-reset-submit {
            background: #2563eb;
            color: #ffffff !important;
            font-weight: 700;
            font-size: 1rem;
            padding: 0.85rem;
            border-radius: 12px;
            border: none;
            width: 100%;
            box-shadow: 0 6px 18px rgba(37, 99, 235, 0.3);
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-reset-submit:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(37, 99, 235, 0.4);
        }

        .reset-footer-text {
            text-align: center;
            font-size: 0.9rem;
            color: #64748b;
            margin-top: 1.75rem;
        }

        .reset-footer-text a {
            color: #2563eb;
            font-weight: 700;
            text-decoration: none;
        }

        .reset-footer-text a:hover {
            text-decoration: underline;
        }
    </style>
}

<div class="reset-container">
    <div class="reset-card">
        <!-- Brand Header -->
        <div class="reset-brand">
            <div class="reset-brand-icon">
                <i class="ti ti-lock-check"></i>
            </div>
            <h1 class="reset-brand-title">Atur Ulang Kata Sandi</h1>
            <p class="reset-brand-subtitle">Buat kata sandi baru yang kuat untuk akun <strong class="text-dark">@Model.Email</strong></p>
        </div>

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "reset-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Token)
            @Html.HiddenFor(m => m.Email)

            <!-- Validation Summary Error Message -->
            if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3 p-3" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti ti-alert-circle fs-2 text-danger"></i>
                        <div class="small">@Html.ValidationSummary(true, "", new { @class = "mb-0 text-danger" })</div>
                    </div>
                </div>
            }

            <!-- 1. Password Baru -->
            <div class="mb-3">
                <label for="NewPassword" class="form-label-custom">Password Baru</label>
                <div class="input-group-custom">
                    <i class="ti ti-lock input-group-icon"></i>
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Minimal 6 karakter", id = "NewPassword", autocomplete = "new-password" })
                    <button type="button" class="toggle-password-btn" id="toggleNewPassword">
                        <i class="ti ti-eye" id="eyeIcon1"></i>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small mt-1 d-block" })
            </div>

            <!-- 2. Konfirmasi Password Baru -->
            <div class="mb-4">
                <label for="ConfirmPassword" class="form-label-custom">Konfirmasi Password Baru</label>
                <div class="input-group-custom">
                    <i class="ti ti-lock-check input-group-icon"></i>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Ulangi password baru di atas", id = "ConfirmPassword", autocomplete = "new-password" })
                    <button type="button" class="toggle-password-btn" id="toggleConfirmPassword">
                        <i class="ti ti-eye" id="eyeIcon2"></i>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small mt-1 d-block" })
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-reset-submit" id="btn-submit-reset">
                <span>Simpan Kata Sandi Baru</span>
                <i class="ti ti-check fs-2"></i>
            </button>
        }

        <!-- Footer Link -->
        <div class="reset-footer-text">
            Batal ubah password? <a href="@Url.Action("Login", "Account")" id="link-to-login">Kembali ke Login</a>
        </div>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function setupToggle(btnId, inputId, iconId) {
                var btn = document.getElementById(btnId);
                var input = document.getElementById(inputId);
                var icon = document.getElementById(iconId);

                if (btn && input && icon) {
                    btn.addEventListener('click', function () {
                        var type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                        input.setAttribute('type', type);
                        if (type === 'text') {
                            icon.classList.remove('ti-eye');
                            icon.classList.add('ti-eye-off');
                        } else {
                            icon.classList.remove('ti-eye-off');
                            icon.classList.add('ti-eye');
                        }
                    });
                }
            }

            setupToggle('toggleNewPassword', 'NewPassword', 'eyeIcon1');
            setupToggle('toggleConfirmPassword', 'ConfirmPassword', 'eyeIcon2');
        });
    </script>
}
