@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Token Tidak Valid - EduPulse LMS";
    ViewBag.IsPublicPage = true;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card p-4 p-md-5 shadow-sm border-0 rounded-4">
                <div class="text-danger mb-3">
                    <i class="ti ti-circle-x text-danger" style="font-size: 4rem;"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Tautan Tidak Valid atau Kadaluarsa</h2>
                <p class="text-muted mb-4">
                    @(ViewBag.ErrorMessage ?? "Token pemulihan kata sandi tidak valid atau telah melewati batas waktu kadaluarsa 1 jam.")
                </p>
                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a href="@Url.Action("ForgotPassword", "Account")" class="btn btn-primary px-4 py-2 rounded-3">
                        <i class="ti ti-refresh me-1"></i> Ajukan Ulang Lupa Password
                    </a>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary px-4 py-2 rounded-3">
                        <i class="ti ti-arrow-left me-1"></i> Kembali ke Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
