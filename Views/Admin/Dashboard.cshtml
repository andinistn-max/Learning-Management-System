@model Learning_Management_System.Models.ViewModel.AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Dashboard Real-Time Administrator - PUB Learning Hub";
}

@functions {
    public string GetTimeAgo(DateTime dt)
    {
        TimeSpan span = DateTime.Now - dt;
        if (span.TotalDays > 30)
            return dt.ToString("dd MMM yyyy HH:mm");
        if (span.TotalDays >= 1)
            return $"{(int)span.TotalDays} hari lalu";
        if (span.TotalHours >= 1)
            return $"{(int)span.TotalHours} jam lalu";
        if (span.TotalMinutes >= 1)
            return $"{(int)span.TotalMinutes} menit lalu";
        return "Baru saja";
    }
}

@section styles {
    <!-- CDN Pendukung jika di LayoutAdmin belum terpasang -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler/1.0.0-beta20/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/1.39.1/iconfont/tabler-icons.min.css" />

    <style>
        :root {
            --pub-bg: #F0F3FA;
            --pub-border-light: #D5DEEF;
            --pub-border: #B1C9EF;
            --pub-accent: #8AAEE0;
            --pub-primary: #638ECB;
            --pub-dark: #395886;
        }

        /* Hero Banner Admin */
        .pub-admin-hero {
            background: linear-gradient(135deg, var(--pub-dark) 0%, #25426b 100%);
            border-radius: 20px;
            color: #ffffff;
            padding: 2rem 2.25rem;
            border: 1px solid var(--pub-border);
            box-shadow: 0 14px 28px rgba(57, 88, 134, 0.16);
            margin-top: 0 !important;
        }

        /* Metric Cards */
        .pub-stat-card {
            background: #ffffff;
            border: 1px solid var(--pub-border-light);
            border-radius: 18px;
            transition: all 0.25s ease;
        }

            .pub-stat-card:hover {
                transform: translateY(-3px);
                border-color: var(--pub-primary);
                box-shadow: 0 10px 24px rgba(57, 88, 134, 0.08);
            }

        .pub-stat-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.65rem;
        }

        /* Tombol Palet Biru */
        .btn-pub-primary {
            background-color: var(--pub-primary);
            border-color: var(--pub-primary);
            color: #ffffff !important;
            transition: all 0.2s ease;
        }

            .btn-pub-primary:hover {
                background-color: var(--pub-dark);
                border-color: var(--pub-dark);
                transform: translateY(-1px);
            }
    </style>
}

<div class="pt-0">
    <!-- Page Header / Greeting Banner -->
    <div class="pub-admin-hero mt-0 mb-3">
        <div class="row align-items-center gy-3">
            <div class="col-lg-8">
                <span class="badge px-3 py-1 rounded-pill mb-2 fw-semibold" style="background-color: rgba(255, 255, 255, 0.2); color: #ffffff;">
                    <i class="ti ti-shield-check me-1"></i> PUSAT KONTROL RESMI BEASISWA PUB
                </span>
                <h1 class="fw-bold fs-1 text-white mb-1">
                    Dashboard Real-Time Administrator
                </h1>
                <p class="text-white-50 m-0 fs-3">
                    Ringkasan statistik pelatihan, pemantauan peserta & mentor, kelas populer, dan log audit aktivitas sistem.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end d-print-none">
                <div class="d-inline-flex flex-wrap gap-2">
                    <a href="@Url.Action("Guru", "Admin")" class="btn btn-pub-primary rounded-pill px-3 py-2 fw-semibold shadow-sm">
                        <i class="ti ti-user-plus me-1"></i> Tambah Akun Guru
                    </a>
                    <a href="@Url.Action("Laporan", "Admin")" class="btn btn-light rounded-pill px-3 py-2 fw-semibold text-dark shadow-sm">
                        <i class="ti ti-file-spreadsheet me-1"></i> Unduh Laporan
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Baris 1: Card Summary 4 Kolom -->
    <div class="row row-cards g-3 mb-4">
        <!-- 1. Total Guru / Mentor -->
        <div class="col-sm-6 col-lg-3">
            <div class="card pub-stat-card h-100 p-3">
                <div class="card-body p-1">
                    <div class="d-flex align-items-center gap-3">
                        <div class="pub-stat-icon text-white shadow-sm" style="background-color: var(--pub-dark);">
                            <i class="ti ti-users"></i>
                        </div>
                        <div>
                            <div class="fw-extrabold text-dark fs-1 mb-0 lh-1">@Model.TotalGuru</div>
                            <div class="text-muted small fw-semibold text-uppercase mt-1" style="font-size: 0.725rem; letter-spacing: 0.5px;">Mentor / Instruktur</div>
                            <span class="text-primary extra-small fw-semibold"><i class="ti ti-check me-0.5"></i>Guru Aktif</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Total Siswa / Peserta PUB -->
        <div class="col-sm-6 col-lg-3">
            <div class="card pub-stat-card h-100 p-3">
                <div class="card-body p-1">
                    <div class="d-flex align-items-center gap-3">
                        <div class="pub-stat-icon text-white shadow-sm" style="background-color: var(--pub-primary);">
                            <i class="ti ti-school"></i>
                        </div>
                        <div>
                            <div class="fw-extrabold text-dark fs-1 mb-0 lh-1">@Model.TotalSiswa</div>
                            <div class="text-muted small fw-semibold text-uppercase mt-1" style="font-size: 0.725rem; letter-spacing: 0.5px;">Peserta Beasiswa</div>
                            <span class="text-success extra-small fw-semibold"><i class="ti ti-activity me-0.5"></i>Siswa Aktif</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Total Kelas Aktif -->
        <div class="col-sm-6 col-lg-3">
            <div class="card pub-stat-card h-100 p-3">
                <div class="card-body p-1">
                    <div class="d-flex align-items-center gap-3">
                        <div class="pub-stat-icon text-white shadow-sm" style="background-color: #0284c7;">
                            <i class="ti ti-books"></i>
                        </div>
                        <div>
                            <div class="fw-extrabold text-dark fs-1 mb-0 lh-1">@Model.TotalKelas</div>
                            <div class="text-muted small fw-semibold text-uppercase mt-1" style="font-size: 0.725rem; letter-spacing: 0.5px;">Kelas Pelatihan</div>
                            <span class="text-info extra-small fw-semibold"><i class="ti ti-layers-subtract me-0.5"></i>Pondasi & Spesialisasi</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Total Materi & Tugas -->
        <div class="col-sm-6 col-lg-3">
            <div class="card pub-stat-card h-100 p-3">
                <div class="card-body p-1">
                    <div class="d-flex align-items-center gap-3">
                        <div class="pub-stat-icon text-white shadow-sm" style="background-color: #7c3aed;">
                            <i class="ti ti-file-text"></i>
                        </div>
                        <div>
                            <div class="fw-extrabold text-dark fs-1 mb-0 lh-1">@(Model.TotalMateri + Model.TotalKuisTugas)</div>
                            <div class="text-muted small fw-semibold text-uppercase mt-1" style="font-size: 0.725rem; letter-spacing: 0.5px;">Materi & Tugas/Kuis</div>
                            <span class="text-purple extra-small fw-semibold"><i class="ti ti-clipboard-check me-0.5"></i>Modul Tersedia</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Baris 2: 2 Kolom (Tabel Kelas Terpopuler & Widget Timeline Log Aktivitas) -->
    <div class="row row-cards g-4">
        <!-- Kolom Kiri: Tabel Ringkas Kelas Terpopuler -->
        <div class="col-lg-7 col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar avatar-xs rounded-2 text-white" style="background-color: var(--pub-primary);">
                            <i class="ti ti-trophy"></i>
                        </span>
                        <h3 class="card-title fw-bold text-dark mb-0">5 Kelas Terpopuler</h3>
                    </div>
                    <a href="@Url.Action("Kelas", "Admin")" class="small text-decoration-none fw-semibold" style="color: var(--pub-primary);">
                        Lihat Semua Kelas <i class="ti ti-chevron-right ms-1"></i>
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover table-striped">
                        <thead class="bg-light">
                            <tr class="text-muted small text-uppercase">
                                <th class="fw-bold">Nama Kelas</th>
                                <th class="fw-bold">Guru Pengampu</th>
                                <th class="fw-bold">Kategori</th>
                                <th class="fw-bold text-center">Siswa Enrolled</th>
                                <th class="fw-bold text-end">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.KelasTerpopuler != null && Model.KelasTerpopuler.Any())
                            {
                                foreach (var item in Model.KelasTerpopuler)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="avatar avatar-sm rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 position-relative overflow-hidden" style="background-color: #E2EAF8; color: #395886;">
                                                    <i class="ti ti-code"></i>
                                                    @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                                    {
                                                        <img src="@Url.Content(item.ThumbnailUrl)" class="w-100 h-100 position-absolute top-0 start-0 object-fit-cover rounded-3" alt="@item.NamaKelas" onerror="this.style.display='none';" />
                                                    }
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@item.NamaKelas</div>
                                                    <div class="text-muted extra-small">ID Kelas: #@item.IdKelas</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-secondary">
                                                <i class="ti ti-user-check me-1 text-muted"></i>@item.NamaGuru
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background-color: var(--pub-border-light); color: var(--pub-dark);">
                                                @item.NamaKategori
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-green-lt fw-bold px-3 py-1 fs-4 rounded-pill">
                                                <i class="ti ti-users me-1"></i>@item.JumlahSiswa Siswa
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a href="@Url.Action("Kelas", "Admin")" class="btn btn-sm btn-icon btn-ghost-secondary rounded-2" title="Detail Kelas">
                                                <i class="ti ti-eye fs-3"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        <i class="ti ti-books-off fs-1 d-block mb-1 opacity-50"></i>
                                        Belum ada data kelas terpopuler di platform.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Kolom Kanan: Timeline / Widget Log Aktivitas Terbaru -->
        <div class="col-lg-5 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar avatar-xs bg-info text-white rounded-2"><i class="ti ti-history"></i></span>
                        <h3 class="card-title fw-bold text-dark mb-0">Log Aktivitas Terbaru</h3>
                    </div>
                    <a href="@Url.Action("LogAktivitas", "Admin")" class="small text-decoration-none fw-semibold" style="color: var(--pub-primary);">
                        Semua Log <i class="ti ti-chevron-right ms-1"></i>
                    </a>
                </div>

                <div class="card-body p-3 overflow-auto" style="max-height: 440px;">
                    @if (Model.LogAktivitasTerbaru != null && Model.LogAktivitasTerbaru.Any())
                    {
                        <ul class="timeline timeline-simple">
                            @foreach (var log in Model.LogAktivitasTerbaru)
                            {
                                string badgeClass = "bg-primary";
                                string iconClass = "ti-activity";

                                if (log.TipeAktivitas.Contains("Registrasi") || log.TipeAktivitas.Contains("User"))
                                {
                                    badgeClass = "bg-success";
                                    iconClass = "ti-user-plus";
                                }
                                else if (log.TipeAktivitas.Contains("Kelas"))
                                {
                                    badgeClass = "bg-warning";
                                    iconClass = "ti-books";
                                }
                                else if (log.TipeAktivitas.Contains("Materi") || log.TipeAktivitas.Contains("Tugas"))
                                {
                                    badgeClass = "bg-purple";
                                    iconClass = "ti-file-text";
                                }

                                <li class="timeline-event">
                                    <div class="timeline-event-icon @badgeClass text-white shadow-sm">
                                        <i class="ti @iconClass"></i>
                                    </div>
                                    <div class="timeline-event-card card shadow-none border mb-2 p-3">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="fw-bold text-dark small">@log.JudulAktivitas</span>
                                            <span class="badge bg-light text-muted small border">@GetTimeAgo(log.Tanggal)</span>
                                        </div>
                                        <div class="text-muted small mb-1">@log.Deskripsi</div>
                                        <div class="d-flex align-items-center gap-1 text-secondary opacity-75" style="font-size: 0.725rem;">
                                            <i class="ti ti-user me-0.5"></i> Oleh: <strong>@log.NamaUser</strong>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="ti ti-history-off fs-1 d-block mb-1 opacity-50"></i>
                            Belum ada catatan log aktivitas sistem.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>