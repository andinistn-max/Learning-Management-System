@model Learning_Management_System.Models.ViewModel.AdminKelasListViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Monitoring Kelas & Jalur Pelatihan PUB";
}

<!-- Subtitle & Action Bar -->
<div class="row align-items-center mb-3">
    <div class="col">
        <div class="text-muted small">
            Pantau seluruh katalog kelas dari semua pengajar, kelola status publikasi, dan atur penonaktifan/pemulihan kelas.
        </div>
    </div>
    <div class="col-auto ms-auto d-print-none">
        <div class="btn-list">
            <span class="badge badge-pub-active px-3 py-2 rounded-pill fs-4 me-2">
                <i class="ti ti-books me-1"></i> Total @Model.TotalRecords Kelas
            </span>
            <a href="@Url.Action("Guru", "Admin")" class="btn btn-pub-primary shadow-sm">
                <i class="ti ti-plus me-1"></i> + Tambah Kelas Baru
            </a>
        </div>
    </div>
</div>

<!-- Card Filter Bar & Tabel Kelas -->
<div class="card border-0 shadow-sm rounded-4" style="border: 1px solid var(--pub-border-light) !important;">
    <!-- Filter Bar Header -->
    <div class="card-header bg-white py-3 border-bottom">
        @using (Html.BeginForm("Kelas", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-center w-100 m-0", id = "filter-form-kelas" }))
        {
            <!-- Input Search -->
            <div class="col-md-4">
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <i class="ti ti-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control rounded-pill" placeholder="Cari nama kelas, kode, atau guru..." value="@Model.SearchQuery" />
                </div>
            </div>

            <!-- Filter Kategori / Jalur Kurikulum -->
            <div class="col-md-3">
                @Html.DropDownListFor(m => m.KategoriFilter, Model.KategoriOptions, new { @class = "form-select rounded-pill", name = "kategori", onchange = "document.getElementById('filter-form-kelas').submit()" })
            </div>

            <!-- Filter Status -->
            <div class="col-md-3">
                <select name="status" class="form-select rounded-pill" onchange="document.getElementById('filter-form-kelas').submit()">
                    <option value="Aktif" @(Model.StatusFilter == "Aktif" ? "selected" : "")>Status: Kelas Aktif</option>
                    <option value="Terhapus" @(Model.StatusFilter == "Terhapus" || Model.StatusFilter == "SoftDeleted" ? "selected" : "")>Status: Terhapus (Soft Delete)</option>
                    <option value="Semua" @(Model.StatusFilter == "Semua" ? "selected" : "")>-- Semua Status Kelas --</option>
                </select>
            </div>

            <!-- Tombol Filter & Reset -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-pub-primary flex-fill">
                    <i class="ti ti-filter me-1"></i> Filter
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || (Model.KategoriFilter != "Semua" && !string.IsNullOrEmpty(Model.KategoriFilter)) || (Model.StatusFilter != "Aktif" && !string.IsNullOrEmpty(Model.StatusFilter)))
                {
                    <a href="@Url.Action("Kelas", "Admin")" class="btn btn-pub-outline rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" title="Reset Filter">
                        <i class="ti ti-refresh"></i>
                    </a>
                }
            </div>
        }
    </div>

    <!-- Tabel Data Kelas -->
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-hover table-striped">
            <thead>
                <tr class="text-uppercase">
                    <th class="fw-bold">Informasi Kelas</th>
                    <th class="fw-bold">Jalur Kurikulum / Kategori</th>
                    <th class="fw-bold">Mentor Pengampu</th>
                    <th class="fw-bold text-center">Peserta &amp; Modul</th>
                    <th class="fw-bold">Status</th>
                    <th class="fw-bold text-end pe-4">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DaftarKelas != null && Model.DaftarKelas.Any())
                {
                    foreach (var item in Model.DaftarKelas)
                    {
                        bool isTahapPondasi = (item.NamaKategori != null && (item.NamaKategori.Contains("C") || item.NamaKategori.Contains("Algoritma") || item.NamaKategori.Contains("SQL") || item.NamaKategori.Contains("HTML") || item.NamaKategori.Contains("Pondasi")));
                        string badgeBgStyle = isTahapPondasi ? "background-color: #395886; color: #ffffff;" : "background-color: #638ECB; color: #ffffff;";
                        string stageTitle = isTahapPondasi ? "Tahap 1 (Pondasi)" : "Tahap 2 (Spesialisasi)";

                        <tr class="@(item.IsDeleted ? "bg-light-subtle opacity-75" : "")">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <!-- Avatar / Thumbnail Kelas -->
                                    <div class="avatar rounded-3 shadow-xs d-flex align-items-center justify-content-center flex-shrink-0 position-relative overflow-hidden" 
                                         style="width: 48px; height: 48px; background-color: #E2EAF8; color: #395886; font-size: 1.25rem;">
                                        <i class="ti ti-code"></i>
                                        @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                        {
                                            <img src="@Url.Content(item.ThumbnailUrl)" 
                                                 alt="@item.NamaKelas" 
                                                 class="w-100 h-100 position-absolute top-0 start-0 object-fit-cover rounded-3" 
                                                 onerror="this.style.display='none';" />
                                        }
                                    </div>
                                 
                                    <!-- Judul & Detail Kelas -->
                                    <div class="min-w-0">
                                        <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">
                                            @item.NamaKelas
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.7rem;">@item.KodeKelas</span>
                                            <span class="text-muted extra-small" style="font-size: 0.75rem;">Terbuat: @(item.TanggalDibuat.ToString("dd MMM yyyy"))</span>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <span class="badge rounded-pill px-3 py-1 fw-bold align-self-start" style="@badgeBgStyle">
                                        @item.NamaKategori
                                    </span>
                                    <span class="extra-small text-muted fw-semibold"><i class="ti ti-git-commit me-0.5"></i>@stageTitle</span>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark small">
                                    <i class="ti ti-user-check me-1 text-muted"></i>@item.NamaGuruPengampu
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <span class="badge badge-pub-active px-3 py-1 rounded-pill">
                                        <i class="ti ti-users me-1"></i>@item.JumlahSiswa Peserta
                                    </span>
                                    <span class="extra-small text-muted">@item.JumlahMateri Modul | @item.JumlahTugas Tugas/Kuis</span>
                                </div>
                            </td>
                            <td>
                                @if (item.IsDeleted)
                                {
                                    <span class="badge badge-pub-inactive px-3 py-1 rounded-pill">
                                        <i class="ti ti-archive me-1"></i> Terhapus (Soft Delete)
                                    </span>
                                }
                                else if (item.IsPublish)
                                {
                                    <span class="badge badge-pub-active px-3 py-1 rounded-pill">
                                        <i class="ti ti-circle-check me-1"></i> Publik &amp; Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-pub-review px-3 py-1 rounded-pill">
                                        <i class="ti ti-clock me-1"></i> Draft / Privat
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    @if (!item.IsDeleted)
                                    {
                                        <!-- Form Toggle Publish -->
                                        using (Html.BeginForm("TogglePublishKelas", "Admin", new { id = item.KelasId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" title="Ubah Status Publikasi">
                                                <i class="ti ti-eye me-1"></i> Status
                                            </button>
                                        }

                                        <!-- Form Soft Delete Kelas -->
                                        using (Html.BeginForm("SoftDeleteKelas", "Admin", new { id = item.KelasId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1 ms-1" title="Arsipkan / Soft Delete Kelas" onclick="return confirm('Apakah Anda yakin ingin mengarsipkan / menonaktifkan kelas @item.NamaKelas?')">
                                                <i class="ti ti-archive me-1"></i> Arsipkan
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <!-- Form Restore Kelas -->
                                        using (Html.BeginForm("RestoreKelas", "Admin", new { id = item.KelasId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-2.5 py-1" title="Pulihkan Kelas Kembali" onclick="return confirm('Pulihkan kelas @item.NamaKelas agar aktif kembali?')">
                                                <i class="ti ti-rotate-clockwise me-1"></i> Pulihkan
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="ti ti-books-off fs-1 d-block mb-2 opacity-50"></i>
                            <div class="fw-semibold text-dark">Data Kelas Tidak Ditemukan</div>
                            <div class="small">Coba ubah kata kunci pencarian atau reset filter di atas.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer & Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
            <div class="text-muted small">
                Menampilkan <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + (Model.DaftarKelas.Any() ? 1 : 0))</strong> - <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + Model.DaftarKelas.Count)</strong> dari total <strong>@Model.TotalRecords</strong> data Kelas
            </div>

            <ul class="pagination m-0">
                <!-- Page Previous -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link rounded-pill me-1" href="@Url.Action("Kelas", "Admin", new { search = Model.SearchQuery, kategori = Model.KategoriFilter, status = Model.StatusFilter, sort = Model.SortBy, page = Model.CurrentPage - 1 })">
                        <i class="ti ti-chevron-left me-1"></i> Sblmnya
                    </a>
                </li>

                <!-- Page Numbers -->
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link rounded-circle mx-0.5" href="@Url.Action("Kelas", "Admin", new { search = Model.SearchQuery, kategori = Model.KategoriFilter, status = Model.StatusFilter, sort = Model.SortBy, page = p })">@p</a>
                    </li>
                }

                <!-- Page Next -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link rounded-pill ms-1" href="@Url.Action("Kelas", "Admin", new { search = Model.SearchQuery, kategori = Model.KategoriFilter, status = Model.StatusFilter, sort = Model.SortBy, page = Model.CurrentPage + 1 })">
                        Slanjutnya <i class="ti ti-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>
