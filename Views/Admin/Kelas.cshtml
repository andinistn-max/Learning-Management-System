@model Learning_Management_System.Models.ViewModel.AdminKelasListViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Monitoring Katalog Kelas Platform";
}

<!-- Page Header -->
<div class="row align-items-center mb-4">
    <div class="col">
        <h2 class="page-title fw-bold text-dark fs-2 mb-1">
            Monitoring Seluruh Kelas Platform
        </h2>
        <div class="text-muted small">
            Pantau seluruh katalog kelas dari semua pengajar, kelola status publikasi, dan atur penonaktifan/pemulihan kelas.
        </div>
    </div>
    <div class="col-auto ms-auto d-print-none">
        <div class="btn-list">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-4 fw-bold">
                <i class="ti ti-books me-1"></i> Total @Model.TotalRecords Kelas
            </span>
        </div>
    </div>
</div>

<!-- Card Filter Bar & Tabel Kelas -->
<div class="card border-0 shadow-sm rounded-4">
    <!-- Filter Bar Header -->
    <div class="card-header bg-white py-3 border-bottom">
        @using (Html.BeginForm("Kelas", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-center w-100 m-0", id = "filter-form-kelas" }))
        {
            <!-- Input Search -->
            <div class="col-md-4">
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <i class="ti ti-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control rounded-3" placeholder="Cari nama kelas, kode, atau guru..." value="@Model.SearchQuery" />
                </div>
            </div>

            <!-- Filter Kategori -->
            <div class="col-md-3">
                @Html.DropDownListFor(m => m.KategoriFilter, Model.KategoriOptions, new { @class = "form-select rounded-3", name = "kategori", onchange = "document.getElementById('filter-form-kelas').submit()" })
            </div>

            <!-- Filter Status -->
            <div class="col-md-3">
                <select name="status" class="form-select rounded-3" onchange="document.getElementById('filter-form-kelas').submit()">
                    <option value="Aktif" @(Model.StatusFilter == "Aktif" ? "selected" : "")>Status: Kelas Aktif</option>
                    <option value="Terhapus" @(Model.StatusFilter == "Terhapus" || Model.StatusFilter == "SoftDeleted" ? "selected" : "")>Status: Terhapus (Soft Delete)</option>
                    <option value="Semua" @(Model.StatusFilter == "Semua" ? "selected" : "")>-- Semua Status Kelas --</option>
                </select>
            </div>

            <!-- Tombol Filter & Reset -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-3 flex-fill">
                    <i class="ti ti-filter me-1"></i> Filter
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || (Model.KategoriFilter != "Semua" && !string.IsNullOrEmpty(Model.KategoriFilter)) || (Model.StatusFilter != "Aktif" && !string.IsNullOrEmpty(Model.StatusFilter)))
                {
                    <a href="@Url.Action("Kelas", "Admin")" class="btn btn-outline-secondary rounded-3" title="Reset Filter">
                        <i class="ti ti-refresh"></i>
                    </a>
                }
            </div>
        }
    </div>

    <!-- Tabel Data Kelas -->
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-hover">
            <thead>
                <tr class="text-muted small text-uppercase bg-light">
                    <th>Informasi Kelas</th>
                    <th>Kategori</th>
                    <th>Guru Pengampu</th>
                    <th class="text-center">Peserta & Konten</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Aksi Management</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DaftarKelas != null && Model.DaftarKelas.Any())
                {
                    foreach (var item in Model.DaftarKelas)
                    {
                        <tr class="@(item.IsDeleted ? "bg-light-subtle opacity-75" : "")">
                            <td>
                                <div class="d-flex align-items-center gap-2.5">
                                    @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                    {
                                        <img src="@item.ThumbnailUrl" class="avatar avatar-md rounded-3 object-cover border" alt="@item.NamaKelas" />
                                    }
                                    else
                                    {
                                        <span class="avatar avatar-md bg-blue-subtle text-blue rounded-3 fw-bold fs-3">
                                            @(string.IsNullOrEmpty(item.NamaKelas) ? "K" : item.NamaKelas.Substring(0, 1).ToUpper())
                                        </span>
                                    }
                                    <div>
                                        <div class="fw-bold text-dark mb-0">@item.NamaKelas</div>
                                        <div class="text-muted small"><span class="badge bg-secondary-subtle text-secondary font-monospace">@item.KodeKelas</span> &bull; Terbuat: @item.CreatedAt.ToString("dd MMM yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-blue-subtle text-blue border border-blue-subtle px-2.5 py-1 rounded-pill">
                                    @item.NamaKategori
                                </span>
                            </td>
                            <td>
                                <div class="fw-medium text-dark small">
                                    <i class="ti ti-user-check me-1 text-muted"></i>@item.NamaGuruPengampu
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-0.5 rounded-pill small fw-bold">
                                        <i class="ti ti-users me-1"></i>@item.JumlahSiswa Siswa
                                    </span>
                                    <span class="badge bg-purple-subtle text-purple border border-purple-subtle px-2.5 py-0.5 rounded-pill small fw-semibold">
                                        <i class="ti ti-file-text me-1"></i>@item.JumlahMateri Modul &bull; @item.JumlahTugas Kuis/Tugas
                                    </span>
                                </div>
                            </td>
                            <td>
                                @if (item.IsDeleted)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill fw-semibold">
                                        <i class="ti ti-circle-x me-1"></i> Terhapus (Soft-Delete)
                                    </span>
                                }
                                else if (item.IsPublish)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill fw-semibold">
                                        <i class="ti ti-circle-check me-1"></i> Publik & Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1 rounded-pill fw-semibold">
                                        <i class="ti ti-clock me-1"></i> Draft
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    @if (!item.IsDeleted)
                                    {
                                        <!-- Form Soft Delete Kelas -->
                                        using (Html.BeginForm("SoftDeleteKelas", "Admin", new { id = item.KelasId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-2 px-2.5 py-1" title="Arsipkan / Soft Delete Kelas" onclick="return confirm('Apakah Anda yakin ingin mengarsipkan / menonaktifkan kelas @item.NamaKelas?')">
                                                <i class="ti ti-archive me-1"></i> Arsipkan
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <!-- Form Restore Kelas -->
                                        using (Html.BeginForm("RestoreKelas", "Admin", new { id = item.KelasId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-2 px-2.5 py-1" title="Pulihkan Kelas Kembali" onclick="return confirm('Pulihkan kelas @item.NamaKelas agar aktif kembali?')">
                                                <i class="ti ti-rotate-clockwise me-1"></i> Pulihkan
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="ti ti-books-off fs-1 d-block mb-2 opacity-50"></i>
                            <div class="fw-semibold text-dark">Data Kelas Tidak Ditemukan</div>
                            <div class="small">Coba ubah kata kunci pencarian atau reset filter di atas.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer & Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
            <div class="text-muted small">
                Menampilkan <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + (Model.DaftarKelas.Any() ? 1 : 0))</strong> - <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + Model.DaftarKelas.Count)</strong> dari total <strong>@Model.TotalRecords</strong> data Kelas
            </div>

            <ul class="pagination m-0">
                <!-- Page Previous -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Kelas", "Admin", new { search = Model.SearchQuery, kategori = Model.KategoriFilter, status = Model.StatusFilter, sort = Model.SortBy, page = Model.CurrentPage - 1 })">
                        <i class="ti ti-chevron-left me-1"></i> Sblmnya
                    </a>
                </li>

                <!-- Page Numbers -->
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Kelas", "Admin", new { search = Model.SearchQuery, kategori = Model.KategoriFilter, status = Model.StatusFilter, sort = Model.SortBy, page = p })">@p</a>
                    </li>
                }

                <!-- Page Next -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Kelas", "Admin", new { search = Model.SearchQuery, kategori = Model.KategoriFilter, status = Model.StatusFilter, sort = Model.SortBy, page = Model.CurrentPage + 1 })">
                        Slanjutnya <i class="ti ti-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>
