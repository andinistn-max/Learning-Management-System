@model Learning_Management_System.Models.ViewModel.AdminLaporanViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Pusat Laporan & Ekspor Data Platform";
}

<!-- Page Header -->
<div class="row align-items-center mb-4">
    <div class="col">
        <h2 class="page-title fw-bold text-dark fs-2 mb-1">
            Pusat Laporan &amp; Ekspor Data Platform
        </h2>
        <div class="text-muted small">
            Unduh rekapitulasi data sistem LMS dalam format Microsoft Excel (.xlsx) untuk kebutuhan audit, pelaporan, dan arsip institusi.
        </div>
    </div>
</div>

<!-- Baris 1: Card Statistik & Metrik Platform -->
<div class="row row-cards mb-4">
    <!-- Card Total Guru -->
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <span class="avatar bg-blue-subtle text-blue rounded-3 me-3">
                        <i class="ti ti-users fs-2"></i>
                    </span>
                    <div>
                        <div class="text-muted small fw-medium">Total Akun Guru / Pengajar</div>
                        <div class="h2 mb-0 fw-bold text-dark">@Model.TotalGuru <span class="fs-5 text-muted fw-normal">Orang</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Total Siswa -->
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <span class="avatar bg-success-subtle text-success rounded-3 me-3">
                        <i class="ti ti-school fs-2"></i>
                    </span>
                    <div>
                        <div class="text-muted small fw-medium">Total Peserta Didik / Siswa</div>
                        <div class="h2 mb-0 fw-bold text-dark">@Model.TotalSiswa <span class="fs-5 text-muted fw-normal">Siswa</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Total Kelas Aktif -->
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <span class="avatar bg-purple-subtle text-purple rounded-3 me-3">
                        <i class="ti ti-books fs-2"></i>
                    </span>
                    <div>
                        <div class="text-muted small fw-medium">Total Kelas Aktif &amp; Publik</div>
                        <div class="h2 mb-0 fw-bold text-dark">@Model.TotalKelasAktif <span class="fs-5 text-muted fw-normal">Kelas</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Total Modul Pembelajaran -->
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <span class="avatar bg-warning-subtle text-warning rounded-3 me-3">
                        <i class="ti ti-file-text fs-2"></i>
                    </span>
                    <div>
                        <div class="text-muted small fw-medium">Total Modul Pembelajaran</div>
                        <div class="h2 mb-0 fw-bold text-dark">@Model.TotalModulPembelajaran <span class="fs-5 text-muted fw-normal">Materi</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Total Kuis & Tugas -->
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <span class="avatar bg-info-subtle text-info rounded-3 me-3">
                        <i class="ti ti-clipboard-list fs-2"></i>
                    </span>
                    <div>
                        <div class="text-muted small fw-medium">Total Kuis &amp; Tugas Aktif</div>
                        <div class="h2 mb-0 fw-bold text-dark">@Model.TotalKuisTugas <span class="fs-5 text-muted fw-normal">Item</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Partisipasi Siswa -->
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <span class="avatar bg-teal-subtle text-teal rounded-3 me-3">
                        <i class="ti ti-chart-donut fs-2"></i>
                    </span>
                    <div>
                        <div class="text-muted small fw-medium">Tingkat Partisipasi Kelas</div>
                        <div class="h2 mb-0 fw-bold text-dark">@Model.TingkatPartisipasiSiswa<span class="fs-5">%</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Baris 2: Card Opsi Download / Export Excel -->
<div class="row mb-4">
    <div class="col-12">
        <h3 class="fw-bold text-dark mb-3">
            <i class="ti ti-download me-2 text-primary"></i>Pilihan Unduh Berkas Excel (.xlsx)
        </h3>
    </div>

    <!-- Card 1: Export Laporan Guru -->
    <div class="col-md-4 mb-3 mb-md-0">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="avatar avatar-md bg-blue-subtle text-blue rounded-3 me-3">
                        <i class="ti ti-users fs-2"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">Laporan Data Pengajar</h4>
                        <span class="badge bg-blue-subtle text-blue font-monospace">@Model.TotalGuru Record Guru</span>
                    </div>
                </div>
                <p class="text-muted small mb-4 flex-fill">
                    Ekspor seluruh data akun guru/pengajar aktif dan non-aktif, alamat email, no telepon/WA, gelar/spesialisasi, serta jumlah kelas diampu.
                </p>
                <a href="@Url.Action("ExportLaporanGuru", "Admin")" class="btn btn-success w-100 rounded-3 py-2 fw-semibold shadow-sm">
                    <i class="ti ti-file-spreadsheet me-2"></i> Unduh Excel (.xlsx)
                </a>
            </div>
        </div>
    </div>

    <!-- Card 2: Export Laporan Siswa -->
    <div class="col-md-4 mb-3 mb-md-0">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="avatar avatar-md bg-success-subtle text-success rounded-3 me-3">
                        <i class="ti ti-school fs-2"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">Laporan Data Siswa</h4>
                        <span class="badge bg-success-subtle text-success font-monospace">@Model.TotalSiswa Record Siswa</span>
                    </div>
                </div>
                <p class="text-muted small mb-4 flex-fill">
                    Ekspor seluruh daftar peserta didik terdaftar, informasi kontak, status keaktifan akun, tanggal registrasi, serta jumlah kelas yang diikuti.
                </p>
                <a href="@Url.Action("ExportLaporanSiswa", "Admin")" class="btn btn-success w-100 rounded-3 py-2 fw-semibold shadow-sm">
                    <i class="ti ti-file-spreadsheet me-2"></i> Unduh Excel (.xlsx)
                </a>
            </div>
        </div>
    </div>

    <!-- Card 3: Export Laporan Katalog Kelas -->
    <div class="col-md-4 mb-3 mb-md-0">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="avatar avatar-md bg-purple-subtle text-purple rounded-3 me-3">
                        <i class="ti ti-books fs-2"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">Rekapitulasi Katalog Kelas</h4>
                        <span class="badge bg-purple-subtle text-purple font-monospace">@Model.TotalKelasAktif Kelas Terdaftar</span>
                    </div>
                </div>
                <p class="text-muted small mb-4 flex-fill">
                    Ekspor ringkasan seluruh kelas platform (kode kelas, nama kelas, kategori, pengajar, jumlah peserta, materi, tugas, dan status publikasi).
                </p>
                <a href="@Url.Action("ExportLaporanKelas", "Admin")" class="btn btn-success w-100 rounded-3 py-2 fw-semibold shadow-sm">
                    <i class="ti ti-file-spreadsheet me-2"></i> Unduh Excel (.xlsx)
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Baris 3: Tabel Ringkasan Per Kategori Pembelajaran -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
        <h4 class="card-title fw-bold text-dark mb-0">
            <i class="ti ti-category me-2 text-primary"></i>Ringkasan Per Kategori Pembelajaran
        </h4>
        <span class="badge bg-light text-muted fw-normal">@Model.RingkasanKategori.Count Kategori</span>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-hover">
            <thead>
                <tr class="text-muted small text-uppercase bg-light">
                    <th>Nama Kategori</th>
                    <th class="text-center">Jumlah Kelas Terdaftar</th>
                    <th class="text-center">Total Pendaftaran Siswa</th>
                    <th class="text-end pe-4">Status Distribusi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RingkasanKategori != null && Model.RingkasanKategori.Any())
                {
                    int maxCount = Model.RingkasanKategori.Max(x => x.TotalKelas);
                    foreach (var kat in Model.RingkasanKategori)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">
                                    <i class="ti ti-folder-check me-2 text-primary"></i>@kat.NamaKategori
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-blue-subtle text-blue font-monospace px-2.5 py-1">
                                    @kat.TotalKelas Kelas
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success font-monospace px-2.5 py-1">
                                    @kat.TotalSiswa Siswa Enrolled
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="progress progress-sm rounded-pill" style="height: 6px; min-width: 120px; display: inline-flex;">
                                    @{
                                        int pct = maxCount > 0 ? (int)Math.Round((double)kat.TotalKelas / maxCount * 100) : 0;
                                    }
                                    <div class="progress-bar bg-primary rounded-pill" style="width: @(pct)%"></div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Data kategori belum tersedia.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
