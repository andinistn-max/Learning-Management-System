@model Learning_Management_System.Models.ViewModel.AdminSiswaListViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Manajemen Siswa / Mahasiswa";
}

<!-- Page Header -->
<div class="row align-items-center mb-4">
    <div class="col">
        <h2 class="page-title fw-bold text-dark fs-2 mb-1">
            Manajemen Siswa / Mahasiswa
        </h2>
        <div class="text-muted small">
            Daftar lengkap akun peserta didik, status keaktifan akun, serta pemantauan jumlah kelas yang diikuti.
        </div>
    </div>
    <div class="col-auto ms-auto d-print-none">
        <div class="btn-list">
            <span class="badge bg-green-subtle text-green border border-green-subtle px-3 py-2 rounded-pill fs-4 fw-bold">
                <i class="ti ti-users me-1"></i> Total @Model.TotalRecords Siswa
            </span>
        </div>
    </div>
</div>

<!-- Card Filter Bar & Tabel Siswa -->
<div class="card border-0 shadow-sm rounded-4">
    <!-- Filter Bar Header -->
    <div class="card-header bg-white py-3 border-bottom">
        @using (Html.BeginForm("Siswa", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-center w-100 m-0", id = "filter-form-siswa" }))
        {
            <!-- Input Search -->
            <div class="col-md-4">
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <i class="ti ti-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control rounded-3" placeholder="Cari nama atau email siswa..." value="@Model.SearchQuery" />
                </div>
            </div>

            <!-- Filter Status -->
            <div class="col-md-3">
                <select name="status" class="form-select rounded-3" onchange="document.getElementById('filter-form-siswa').submit()">
                    <option value="Semua" @(Model.StatusFilter == "Semua" ? "selected" : "")>-- Semua Status --</option>
                    <option value="Aktif" @(Model.StatusFilter == "Aktif" ? "selected" : "")>Status: Aktif</option>
                    <option value="Nonaktif" @(Model.StatusFilter == "Nonaktif" ? "selected" : "")>Status: Nonaktif</option>
                </select>
            </div>

            <!-- Filter Sorting -->
            <div class="col-md-3">
                <select name="sort" class="form-select rounded-3" onchange="document.getElementById('filter-form-siswa').submit()">
                    <option value="Nama" @(Model.SortBy == "Nama" ? "selected" : "")>Urutkan: Nama (A-Z)</option>
                    <option value="Tanggal" @(Model.SortBy == "Tanggal" ? "selected" : "")>Urutkan: Tanggal Terdaftar</option>
                    <option value="Kelas" @(Model.SortBy == "Kelas" ? "selected" : "")>Urutkan: Kelas Diikuti Terbanyak</option>
                </select>
            </div>

            <!-- Tombol Filter & Reset -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-3 flex-fill">
                    <i class="ti ti-filter me-1"></i> Filter
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || (Model.StatusFilter != "Semua" && !string.IsNullOrEmpty(Model.StatusFilter)) || (Model.SortBy != "Nama" && !string.IsNullOrEmpty(Model.SortBy)))
                {
                    <a href="@Url.Action("Siswa", "Admin")" class="btn btn-outline-secondary rounded-3" title="Reset Filter">
                        <i class="ti ti-refresh"></i>
                    </a>
                }
            </div>
        }
    </div>

    <!-- Tabel Data Siswa -->
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-hover">
            <thead>
                <tr class="text-muted small text-uppercase bg-light">
                    <th>Profil Siswa</th>
                    <th>Kontak & Email</th>
                    <th class="text-center">Kelas Diikuti</th>
                    <th>Terdaftar Pada</th>
                    <th>Status Akun</th>
                    <th class="text-end pe-4">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DaftarSiswa != null && Model.DaftarSiswa.Any())
                {
                    foreach (var siswa in Model.DaftarSiswa)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2.5">
                                    @if (!string.IsNullOrEmpty(siswa.FotoProfile))
                                    {
                                        <img src="@siswa.FotoProfile" class="avatar avatar-md rounded-circle object-cover border" alt="@siswa.NamaLengkap" />
                                    }
                                    else
                                    {
                                        <span class="avatar avatar-md bg-green-subtle text-green rounded-circle fw-bold fs-3">
                                            @(string.IsNullOrEmpty(siswa.NamaLengkap) ? "S" : siswa.NamaLengkap.Substring(0, 1).ToUpper())
                                        </span>
                                    }
                                    <div>
                                        <div class="fw-bold text-dark">@siswa.NamaLengkap</div>
                                        <div class="text-muted small">ID Siswa: #@siswa.UserId</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-medium text-dark small"><i class="ti ti-mail me-1 text-muted"></i>@siswa.Email</div>
                                <div class="text-muted small"><i class="ti ti-phone me-1 text-muted"></i>@siswa.NoTelepon</div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-green-subtle text-green border border-green-subtle px-3 py-1.5 rounded-pill fs-4 fw-bold">
                                    <i class="ti ti-books me-1"></i>@siswa.JumlahKelasDiikuti Kelas
                                </span>
                            </td>
                            <td>
                                <div class="small text-dark">@siswa.CreatedAt.ToString("dd MMM yyyy")</div>
                                <div class="text-muted small">@siswa.CreatedAt.ToString("HH:mm") WIB</div>
                            </td>
                            <td>
                                @if (siswa.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill fw-semibold">
                                        <i class="ti ti-circle-check me-1"></i> Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill fw-semibold">
                                        <i class="ti ti-circle-x me-1"></i> Nonaktif
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <!-- Form Toggle Status -->
                                    @using (Html.BeginForm("ToggleStatusSiswa", "Admin", new { id = siswa.UserId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        if (siswa.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-2 px-2 py-1" title="Nonaktifkan Akun Siswa" onclick="return confirm('Nonaktifkan akun siswa @siswa.NamaLengkap?')">
                                                <i class="ti ti-power me-1"></i> Nonaktifkan
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-2 px-2 py-1" title="Aktifkan Akun Siswa">
                                                <i class="ti ti-check me-1"></i> Aktifkan
                                            </button>
                                        }
                                    }

                                    <!-- Form Delete Siswa -->
                                    @using (Html.BeginForm("DeleteSiswa", "Admin", new { id = siswa.UserId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger btn-icon rounded-2 ms-1" title="Hapus Akun Siswa" onclick="return confirm('Apakah Anda yakin ingin menghapus akun siswa @siswa.NamaLengkap?')">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="ti ti-school-off fs-1 d-block mb-2 opacity-50"></i>
                            <div class="fw-semibold text-dark">Data Siswa / Mahasiswa Tidak Ditemukan</div>
                            <div class="small">Coba ubah kata kunci pencarian atau reset filter di atas.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer & Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
            <div class="text-muted small">
                Menampilkan <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + (Model.DaftarSiswa.Any() ? 1 : 0))</strong> - <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + Model.DaftarSiswa.Count)</strong> dari total <strong>@Model.TotalRecords</strong> data Siswa
            </div>

            <ul class="pagination m-0">
                <!-- Page Previous -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Siswa", "Admin", new { search = Model.SearchQuery, status = Model.StatusFilter, sort = Model.SortBy, page = Model.CurrentPage - 1 })">
                        <i class="ti ti-chevron-left me-1"></i> Sblmnya
                    </a>
                </li>

                <!-- Page Numbers -->
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Siswa", "Admin", new { search = Model.SearchQuery, status = Model.StatusFilter, sort = Model.SortBy, page = p })">@p</a>
                    </li>
                }

                <!-- Page Next -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Siswa", "Admin", new { search = Model.SearchQuery, status = Model.StatusFilter, sort = Model.SortBy, page = Model.CurrentPage + 1 })">
                        Slanjutnya <i class="ti ti-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>
