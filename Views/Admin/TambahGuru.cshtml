@model Learning_Management_System.Models.ViewModel.AdminTambahGuruViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Tambah Pengajar Baru";
}

<!-- Page Header with Breadcrumb -->
<div class="row align-items-center mb-4">
    <div class="col">
        <ol class="breadcrumb breadcrumb-arrows mb-1" aria-label="breadcrumbs">
            <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Admin")">Admin</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Guru", "Admin")">Manajemen Guru</a></li>
            <li class="breadcrumb-item active" aria-current="page"><a href="#">Tambah</a></li>
        </ol>
        <h2 class="page-title fw-bold text-dark fs-2 mb-0">
            Tambah Pengajar (Guru) Baru
        </h2>
    </div>
    <div class="col-auto ms-auto d-print-none">
        <a href="@Url.Action("Guru", "Admin")" class="btn btn-outline-secondary rounded-3">
            <i class="ti ti-arrow-left me-1"></i> Kembali ke Daftar
        </a>
    </div>
</div>

<!-- Card Form Tambah Guru -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <span class="avatar avatar-xs bg-primary text-white rounded-2"><i class="ti ti-user-plus"></i></span>
            <h3 class="card-title fw-bold text-dark mb-0">Formulir Pendaftaran Akun Guru</h3>
        </div>
        <span class="text-muted small">* Menandakan bidang wajib diisi</span>
    </div>

    <div class="card-body p-4">
        @using (Html.BeginForm("TambahGuru", "Admin", FormMethod.Post, new { id = "form-tambah-guru" }))
        {
            @Html.AntiForgeryToken()

            if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible rounded-3 mb-4" role="alert">
                    <div class="d-flex gap-2">
                        <i class="ti ti-alert-triangle fs-2"></i>
                        <div>
                            <h4 class="alert-title fw-bold mb-1">Terdapat kesalahan pengisian form!</h4>
                            <div class="text-secondary small">Silakan periksa kembali input formulir di bawah ini.</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Baris 1: Nama Lengkap & Gelar / Spesialisasi -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label required fw-bold text-dark">Nama Lengkap & Gelar</label>
                    @Html.TextBoxFor(m => m.NamaLengkap, new { @class = "form-control rounded-3", placeholder = "Contoh: Dr. Budi Santoso, M.Kom", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.NamaLengkap, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Gelar / Bidang Spesialisasi</label>
                    @Html.TextBoxFor(m => m.Spesialisasi, new { @class = "form-control rounded-3", placeholder = "Contoh: Pemrograman Web & Data Science", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.Spesialisasi, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
            </div>

            <!-- Baris 2: Alamat Email & Nomor Telepon -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label required fw-bold text-dark">Alamat Email</label>
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="ti ti-mail"></i></span>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control rounded-3", type = "email", placeholder = "budi@edupulse.com", autocomplete = "off" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Nomor Telepon / WhatsApp</label>
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="ti ti-phone"></i></span>
                        @Html.TextBoxFor(m => m.NoTelepon, new { @class = "form-control rounded-3", placeholder = "081234567890", autocomplete = "off" })
                    </div>
                    @Html.ValidationMessageFor(m => m.NoTelepon, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
            </div>

            <!-- Baris 3: Password Default & Quick Actions -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label required fw-bold text-dark">Kata Sandi (Password)</label>
                    <div class="input-group">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control rounded-start-3", id = "input-password", placeholder = "Minimal 6 karakter...", value = "Password123!" })
                        <button class="btn btn-outline-secondary" type="button" id="btn-toggle-password" title="Lihat/Sembunyikan Password">
                            <i class="ti ti-eye" id="icon-eye"></i>
                        </button>
                        <button class="btn btn-outline-primary" type="button" id="btn-generate-password" title="Generate Password Acak">
                            <i class="ti ti-refresh me-1"></i> Generate Acak
                        </button>
                    </div>
                    <small class="form-hint text-muted mt-1">Default: Password123! (Guru dapat mengubahnya saat login pertama kali).</small>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                </div>
            </div>

            <!-- Baris 4: Textarea Alamat Lengkap -->
            <div class="mb-4">
                <label class="form-label fw-bold text-dark">Alamat Lengkap (Opsional)</label>
                @Html.TextAreaFor(m => m.Alamat, new { @class = "form-control rounded-3", rows = "3", placeholder = "Masukkan alamat domisili atau institusi..." })
                @Html.ValidationMessageFor(m => m.Alamat, "", new { @class = "text-danger small mt-1 d-block" })
            </div>

            <hr class="my-4" />

            <!-- Action Buttons -->
            <div class="d-flex align-items-center justify-content-end gap-2">
                <a href="@Url.Action("Guru", "Admin")" class="btn btn-outline-secondary rounded-3 px-4">
                    <i class="ti ti-x me-1"></i> Batal
                </a>
                <button type="submit" class="btn btn-primary rounded-3 px-4">
                    <i class="ti ti-check me-1"></i> Simpan Akun Guru
                </button>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const passInput = document.getElementById("input-password");
            const btnToggle = document.getElementById("btn-toggle-password");
            const iconEye = document.getElementById("icon-eye");
            const btnGenerate = document.getElementById("btn-generate-password");

            if (btnToggle && passInput && iconEye) {
                btnToggle.addEventListener("click", function () {
                    if (passInput.type === "password") {
                        passInput.type = "text";
                        iconEye.classList.remove("ti-eye");
                        iconEye.classList.add("ti-eye-off");
                    } else {
                        passInput.type = "password";
                        iconEye.classList.remove("ti-eye-off");
                        iconEye.classList.add("ti-eye");
                    }
                });
            }

            if (btnGenerate && passInput) {
                btnGenerate.addEventListener("click", function () {
                    const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@@#$%";
                    let newPass = "P@@ss";
                    for (let i = 0; i < 8; i++) {
                        newPass += chars.charAt(Math.floor(Math.random() * chars.length));
                    }
                    passInput.type = "text";
                    passInput.value = newPass;
                    if (iconEye) {
                        iconEye.classList.remove("ti-eye");
                        iconEye.classList.add("ti-eye-off");
                    }
                });
            }
        });
    </script>
}
