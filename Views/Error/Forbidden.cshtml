@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Akses Dibatasi - PUB Learning Hub";
    ViewBag.IsPublicPage = true;
    string currentRole = ViewBag.CurrentRole as string ?? "Pengguna";
    string userName = ViewBag.UserName as string ?? "Pengguna";
    string returnUrl = ViewBag.ReturnUrl as string ?? "";

    string targetDashboard = Url.Action("Index", "Home");
    if (string.Equals(currentRole, "Siswa", StringComparison.OrdinalIgnoreCase))
    {
        targetDashboard = Url.Action("Dashboard", "Siswa");
    }
    else if (string.Equals(currentRole, "Guru", StringComparison.OrdinalIgnoreCase) || string.Equals(currentRole, "Mentor", StringComparison.OrdinalIgnoreCase))
    {
        targetDashboard = Url.Action("Dashboard", "Guru");
    }
    else if (string.Equals(currentRole, "Admin", StringComparison.OrdinalIgnoreCase))
    {
        targetDashboard = Url.Action("Dashboard", "Admin");
    }
}

<div class="container-xl d-flex flex-column justify-content-center align-items-center py-5" style="min-height: calc(100vh - 120px);">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 text-center" style="max-width: 580px; width: 100%; border: 1.5px solid #B1C9EF !important; background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(10px);">
        
        <!-- Ikon Peringatan Hak Akses -->
        <div class="mb-4">
            <span class="avatar rounded-circle text-white shadow-sm d-inline-flex align-items-center justify-content-center" style="width: 76px; height: 76px; background: linear-gradient(135deg, #395886 0%, #638ECB 100%);">
                <i class="ti ti-shield-lock fs-1" style="font-size: 2.3rem;"></i>
            </span>
        </div>

        <h2 class="fw-bold mb-2" style="color: #0F172A; letter-spacing: -0.02em;">Akses Halaman Dibatasi (403)</h2>
        <p class="text-muted mb-4" style="font-size: 0.95rem; line-height: 1.6;">
            Halaman atau menu yang Anda tuju memerlukan hak akses khusus <strong>Administrator</strong>. Saat ini Anda sedang masuk dengan akun dengan peran:
        </p>

        <!-- Status Akun Saat Ini -->
        <div class="p-3 rounded-3 mb-4 text-start border" style="background-color: #EEF4F9; border-color: #D5DEEF !important;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fw-bold" style="color: #0F172A; font-size: 0.95rem;">@userName</div>
                    <div class="text-muted small">Peran Aktif: <span class="badge rounded-pill ms-1" style="background: #395886; color: #ffffff;">@currentRole</span></div>
                </div>
                <i class="ti ti-user-circle fs-1" style="color: #638ECB;"></i>
            </div>
        </div>

        <!-- Tombol Solusi Cepat -->
        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
            <!-- Kembali ke Portal Sesuai Peran Aktif -->
            <a href="@targetDashboard" class="btn btn-outline-secondary rounded-3 px-4 py-2.5 fw-semibold d-inline-flex align-items-center justify-content-center gap-2">
                <i class="ti ti-arrow-left"></i>
                <span>Kembali ke Portal @currentRole</span>
            </a>

            <!-- Ganti Akun / Masuk sebagai Admin -->
            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "m-0" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary rounded-3 px-4 py-2.5 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 w-100" style="background-color: #395886; border-color: #395886;">
                    <i class="ti ti-login"></i>
                    <span>Masuk Akun Admin</span>
                </button>
            }
        </div>

        <div class="mt-4 pt-3 border-top text-muted small">
            Butuh bantuan? Silakan hubungi tim IT PUB atau <a href="@Url.Action("Index", "Home")" class="text-decoration-none fw-semibold" style="color: #395886;">kembali ke Beranda</a>.
        </div>
    </div>
</div>
