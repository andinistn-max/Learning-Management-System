@model Learning_Management_System.Models.ViewModel.GuruBuatKelasViewModel
@{
    Layout = "~/Views/Shared/_LayoutGuru.cshtml";
    ViewBag.Title = "Buat Ruang Kelas Baru";
}

<!-- Page Header & Breadcrumb -->
<div class="row align-items-center mb-4">
    <div class="col">
        <ol class="breadcrumb breadcrumb-arrows mb-2" aria-label="breadcrumbs">
            <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Guru")" class="text-secondary"><i class="ti ti-dashboard me-1"></i>Guru</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Kelas", "Guru")" class="text-secondary">Kelas Saya</a></li>
            <li class="breadcrumb-item active" aria-current="page"><a href="#" class="fw-semibold text-dark">Buat Baru</a></li>
        </ol>
        <h2 class="page-title fw-bold text-dark fs-2 mb-1">
            Buat Ruang Kelas Pembelajaran Baru
        </h2>
        <div class="text-muted small">
            Lengkapi informasi dasar kelas, pilih kategori mata pelajaran, dan unggah gambar cover/thumbnail kelas.
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h3 class="card-title fw-bold text-dark mb-0">
                    <i class="ti ti-plus me-2 text-success"></i>Formulir Pembuatan Kelas
                </h3>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Ruang Kelas Baru</span>
            </div>

            <div class="card-body p-4">
                @using (Html.BeginForm("BuatKelas", "Guru", FormMethod.Post, new { enctype = "multipart/form-data", id = "form-buat-kelas" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 mb-4" })

                    <div class="row g-3">
                        <!-- Live Image Preview Card -->
                        <div class="col-12 mb-2">
                            <label class="form-label fw-semibold text-dark">Thumbnail / Cover Gambar Kelas</label>
                            <div class="card border border-light-subtle rounded-3 p-3 bg-light text-center">
                                <div class="position-relative mx-auto overflow-hidden rounded-3 mb-2" style="max-width: 320px; height: 160px; background: #e2e8f0;">
                                    <img id="img-preview-thumbnail" src="/Content/images/default-course.jpg" class="w-100 h-100 object-cover" alt="Preview Thumbnail Kelas" onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=500&auto=format&fit=crop&q=60';" />
                                </div>
                                <div class="w-100">
                                    <input type="file" name="ThumbnailUpload" id="ThumbnailUpload" class="form-control rounded-3" accept=".jpg,.jpeg,.png,.webp" onchange="previewThumbnail(this)" />
                                    <div class="form-text small text-muted mt-1">Format gambar: .JPG, .PNG, .WEBP (Maksimal 2MB). Kosongkan jika ingin memakai cover default.</div>
                                </div>
                            </div>
                            @Html.ValidationMessageFor(m => m.ThumbnailUpload, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Nama Kelas -->
                        <div class="col-12">
                            <label for="NamaKelas" class="form-label fw-semibold text-dark">Nama Kelas Pembelajaran <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.NamaKelas, new { @class = "form-control rounded-3 py-2", placeholder = "Contoh: Pemrograman Web Lanjutan - TI A" })
                            @Html.ValidationMessageFor(m => m.NamaKelas, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Kategori Kelas -->
                        <div class="col-md-6">
                            <label for="IdKategori" class="form-label fw-semibold text-dark">Kategori Mata Pelajaran/Kuliah <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.IdKategori, Model.KategoriOptions, "-- Pilih Kategori Kelas --", new { @class = "form-select rounded-3 py-2" })
                            @Html.ValidationMessageFor(m => m.IdKategori, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Level Kelas -->
                        <div class="col-md-6">
                            <label for="Level" class="form-label fw-semibold text-dark">Tingkat Kesulitan / Level</label>
                            @Html.DropDownListFor(m => m.Level, Model.LevelOptions, new { @class = "form-select rounded-3 py-2" })
                            @Html.ValidationMessageFor(m => m.Level, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Durasi (Jam) -->
                        <div class="col-md-6">
                            <label for="Durasi" class="form-label fw-semibold text-dark">Perkiraan Durasi Pembelajaran (Jam)</label>
                            @Html.TextBoxFor(m => m.Durasi, new { @class = "form-control rounded-3 py-2", type = "number", min = "1", max = "500", placeholder = "Contoh: 32" })
                            @Html.ValidationMessageFor(m => m.Durasi, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Deskripsi Kelas -->
                        <div class="col-12">
                            <label for="Deskripsi" class="form-label fw-semibold text-dark">Deskripsi Kelas &amp; Capaian Pembelajaran</label>
                            @Html.TextAreaFor(m => m.Deskripsi, new { @class = "form-control rounded-3", rows = 4, placeholder = "Jelaskan mengenai pokok bahasan, modul, dan capaian pembelajaran yang akan dipelajari siswa di kelas ini..." })
                            @Html.ValidationMessageFor(m => m.Deskripsi, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a href="@Url.Action("Dashboard", "Guru")" class="btn btn-outline-secondary rounded-3 px-4">
                            Batal
                        </a>
                        <button type="submit" class="btn text-white rounded-3 px-4 fw-bold shadow-sm" style="background-color: #10b981;">
                            <i class="ti ti-check me-1"></i> Terbitkan Kelas
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function previewThumbnail(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var preview = document.getElementById('img-preview-thumbnail');
                    if (preview) {
                        preview.src = e.target.result;
                    }
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
