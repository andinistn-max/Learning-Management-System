@model Learning_Management_System.Models.ViewModel.GuruDashboardViewModel
@{
    Layout = "~/Views/Shared/_LayoutGuru.cshtml";
    ViewBag.Title = "Dashboard Ruang Pengajar";
    string namaGuru = Session["NamaLengkap"] != null ? Session["NamaLengkap"].ToString() : "Pengajar";
}

<!-- Page Header -->
<div class="row align-items-center mb-4">
    <div class="col">
        <h2 class="page-title fw-bold text-dark fs-2 mb-1">
            Selamat Datang Kembali, @namaGuru! 👋
        </h2>
        <div class="text-secondary small">
            Ringkasan statistik kelas diampu, aktivitas submisi tugas siswa, dan manajemen ruang pembelajaran Anda.
        </div>
    </div>
    <div class="col-auto ms-auto d-print-none">
        <a href="@Url.Action("BuatKelas", "Guru")" class="btn btn-emerald text-white rounded-3 px-3 py-2 fw-bold shadow-sm" style="background-color: #10b981;">
            <i class="ti ti-plus me-1 fs-3"></i> Buat Kelas Baru
        </a>
    </div>
</div>

<!-- Baris 1: Card Summary 4 Metrik dengan Tabler bg-*-lt -->
<div class="row row-cards mb-4">
    <!-- Card 1: Total Kelas Diampu -->
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm bg-primary-lt border-0 rounded-4 h-100">
            <div class="card-body p-3.5">
                <div class="d-flex align-items-center">
                    <div class="subheader text-uppercase fw-bold text-muted small">Kelas Diampu</div>
                    <div class="ms-auto">
                        <span class="avatar bg-primary text-white rounded-3">
                            <i class="ti ti-books fs-2"></i>
                        </span>
                    </div>
                </div>
                <div class="h1 mb-1 fw-extrabold text-dark">@Model.TotalKelasDiampu</div>
                <div class="text-muted small">
                    <i class="ti ti-layout-grid me-1 text-primary"></i> Total kelas aktif
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Total Siswa Terdaftar -->
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm bg-success-lt border-0 rounded-4 h-100">
            <div class="card-body p-3.5">
                <div class="d-flex align-items-center">
                    <div class="subheader text-uppercase fw-bold text-muted small">Siswa Terdaftar</div>
                    <div class="ms-auto">
                        <span class="avatar bg-success text-white rounded-3">
                            <i class="ti ti-users fs-2"></i>
                        </span>
                    </div>
                </div>
                <div class="h1 mb-1 fw-extrabold text-dark">@Model.TotalSiswaTerdaftar</div>
                <div class="text-muted small">
                    <i class="ti ti-user-check me-1 text-success"></i> Akumulasi peserta didik
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Tugas Perlu Dinilai -->
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm bg-warning-lt border-0 rounded-4 h-100">
            <div class="card-body p-3.5">
                <div class="d-flex align-items-center">
                    <div class="subheader text-uppercase fw-bold text-muted small">Perlu Dikoreksi</div>
                    <div class="ms-auto">
                        <span class="avatar bg-warning text-white rounded-3">
                            <i class="ti ti-clipboard-check fs-2"></i>
                        </span>
                    </div>
                </div>
                <div class="h1 mb-1 fw-extrabold text-dark">@Model.TotalTugasPerluDikoreksi</div>
                <div class="text-muted small">
                    <i class="ti ti-clock me-1 text-warning"></i> Submisi tugas siswa
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Kuis Berjalan -->
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm bg-purple-lt border-0 rounded-4 h-100">
            <div class="card-body p-3.5">
                <div class="d-flex align-items-center">
                    <div class="subheader text-uppercase fw-bold text-muted small">Kuis Berjalan</div>
                    <div class="ms-auto">
                        <span class="avatar bg-purple text-white rounded-3">
                            <i class="ti ti-help fs-2"></i>
                        </span>
                    </div>
                </div>
                <div class="h1 mb-1 fw-extrabold text-dark">@Model.TotalKuisAktif</div>
                <div class="text-muted small">
                    <i class="ti ti-bolt me-1 text-purple"></i> Ujian kuis aktif
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Baris 2: Grid Kelas Milik Guru & Widget Aktivitas Terbaru -->
<div class="row g-4">
    <!-- Kolom Kiri: Grid Kelas Milik Guru -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h3 class="card-title fw-bold text-dark mb-0">
                    <i class="ti ti-books me-2 text-success"></i>Daftar Ruang Kelas Anda
                </h3>
                <a href="@Url.Action("Kelas", "Guru")" class="small text-emerald fw-bold text-decoration-none" style="color: #10b981;">
                    Lihat Semua <i class="ti ti-chevron-right ms-1"></i>
                </a>
            </div>
            <div class="card-body p-4">
                @if (Model.DaftarKelas != null && Model.DaftarKelas.Any())
                {
                    <div class="row row-cards g-3">
                        @foreach (var k in Model.DaftarKelas)
                        {
                            <div class="col-md-6">
                                <div class="card border border-light-subtle shadow-sm rounded-3 overflow-hidden h-100">
                                    <!-- Thumbnail -->
                                    <div class="position-relative" style="height: 140px; background: #f1f5f9;">
                                        <img src="@k.ThumbnailUrl" class="w-100 h-100 object-cover" alt="@k.NamaKelas" onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=500&auto=format&fit=crop&q=60';" />
                                        <span class="badge text-white position-absolute top-0 start-0 m-3 shadow-sm rounded-pill font-monospace" style="font-size: 0.7rem; background-color: #10b981;">
                                            @k.Kategori
                                        </span>
                                    </div>
                                    <div class="card-body p-3 d-flex flex-column">
                                        <h4 class="fw-bold text-dark mb-1 text-truncate" title="@k.NamaKelas">@k.NamaKelas</h4>
                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <span class="badge bg-light text-secondary border font-monospace" id="code-@k.IdKelas">@k.KodeKelas</span>
                                            <button type="button" class="btn btn-xs btn-ghost-secondary p-1" onclick="copyCode('@k.KodeKelas', this)" title="Salin Kode Kelas">
                                                <i class="ti ti-copy fs-4"></i>
                                            </button>
                                        </div>

                                        <div class="row text-center border-top border-bottom py-2 g-0 my-auto bg-light rounded-2">
                                            <div class="col-4 border-end">
                                                <div class="small text-muted" style="font-size: 0.675rem;">Siswa</div>
                                                <div class="fw-bold text-dark small"><i class="ti ti-users me-1 text-success"></i>@k.JumlahSiswa</div>
                                            </div>
                                            <div class="col-4 border-end">
                                                <div class="small text-muted" style="font-size: 0.675rem;">Materi</div>
                                                <div class="fw-bold text-dark small"><i class="ti ti-file-text me-1 text-primary"></i>@k.JumlahMateri</div>
                                            </div>
                                            <div class="col-4">
                                                <div class="small text-muted" style="font-size: 0.675rem;">Tugas</div>
                                                <div class="fw-bold text-dark small"><i class="ti ti-clipboard-list me-1 text-warning"></i>@k.JumlahTugas</div>
                                            </div>
                                        </div>

                                        <div class="mt-3 pt-2">
                                            <a href="@Url.Action("DetailKelas", "Guru", new { id = k.IdKelas })" class="btn text-white w-100 rounded-3 fw-semibold py-2" style="background-color: #10b981;">
                                                Kelola Ruang Kelas <i class="ti ti-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- Tabler Empty State -->
                    <div class="empty py-5">
                        <div class="empty-icon mb-3">
                            <span class="avatar avatar-xl rounded-circle p-3 text-success bg-success-lt">
                                <i class="ti ti-books-off fs-1"></i>
                            </span>
                        </div>
                        <p class="empty-title fw-bold text-dark fs-3 mb-1">Belum Ada Ruang Kelas</p>
                        <p class="empty-subtitle text-secondary small mx-auto mb-4" style="max-width: 420px;">
                            Anda belum membuat kelas pembelajaran. Mulai buat kelas pertama Anda untuk membagikan materi, kuis, dan tugas kepada siswa.
                        </p>
                        <div class="empty-action">
                            <a href="@Url.Action("BuatKelas", "Guru")" class="btn text-white rounded-3 px-4 py-2 fw-bold shadow-sm" style="background-color: #10b981;">
                                <i class="ti ti-plus me-1"></i> Buat Kelas Pertama
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Kolom Kanan: Widget Submisi Tugas Terbaru Siswa -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h3 class="card-title fw-bold text-dark mb-0">
                    <i class="ti ti-clipboard-check me-2 text-warning"></i>Submisi Tugas Terbaru
                </h3>
                <span class="badge bg-yellow-lt font-monospace">Perlu Penilaian</span>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @if (Model.AktivitasTerbaruSiswa != null && Model.AktivitasTerbaruSiswa.Any())
                    {
                        foreach (var sub in Model.AktivitasTerbaruSiswa)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(sub.FotoSiswa))
                                    {
                                        <img src="@sub.FotoSiswa" class="avatar avatar-md rounded-circle border object-cover" alt="@sub.NamaSiswa" />
                                    }
                                    else
                                    {
                                        <span class="avatar avatar-md text-white rounded-circle fw-bold" style="background-color: #10b981;">
                                            @sub.NamaSiswa.Substring(0, 1).ToUpper()
                                        </span>
                                    }
                                    <div class="flex-fill min-w-0">
                                        <div class="fw-bold text-dark text-truncate">@sub.NamaSiswa</div>
                                        <div class="text-secondary small text-truncate">@sub.JudulTugas</div>
                                        <div class="text-muted small mt-0.5" style="font-size: 0.725rem;">
                                            <i class="ti ti-school me-1"></i>@sub.NamaKelas &bull; @sub.TanggalKumpul.ToString("dd MMM HH:mm")
                                        </div>
                                    </div>
                                    <div>
                                        @if (sub.Nilai.HasValue)
                                        {
                                            <span class="badge bg-green-lt font-monospace" style="font-size: 0.675rem;">
                                                @sub.Nilai.Value.ToString("0.##")
                                            </span>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("KoreksiTugas", "Guru", new { id = sub.IdSubmisi })" class="btn btn-sm btn-outline-warning rounded-pill px-2.5 py-1" style="font-size: 0.725rem;">
                                                Koreksi
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Tabler Empty State -->
                        <div class="empty py-5">
                            <div class="empty-icon mb-2 text-warning">
                                <i class="ti ti-clipboard-x fs-1 opacity-50"></i>
                            </div>
                            <p class="empty-title fw-bold text-dark mb-1">Belum Ada Submisi Tugas</p>
                            <p class="empty-subtitle text-secondary small">Pengumpulan tugas siswa akan tampil di sini secara real-time.</p>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer bg-white text-center py-3 border-top">
                <a href="@Url.Action("Tugas", "Guru")" class="btn btn-outline-secondary w-100 rounded-3 py-2 fw-semibold">
                    <i class="ti ti-file-certificate me-1"></i> Buka Halaman Evaluasi Tugas
                </a>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function copyCode(code, btn) {
            navigator.clipboard.writeText(code).then(function () {
                var originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="ti ti-check text-success fs-4"></i>';
                setTimeout(function () {
                    btn.innerHTML = originalHtml;
                }, 2000);
            });
        }
    </script>
}
