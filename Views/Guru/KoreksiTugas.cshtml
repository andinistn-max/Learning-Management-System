@model Learning_Management_System.Models.ViewModel.GuruKoreksiTugasViewModel
@{
    Layout = "~/Views/Shared/_LayoutGuru.cshtml";
    ViewBag.Title = "Koreksi Tugas Siswa";
    string currentUrl = Request.RawUrl;
}

<!-- Breadcrumb Navigasi -->
<div class="mb-3">
    <ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Dashboard", "Guru")" class="text-secondary">
                <i class="ti ti-dashboard me-1"></i>Guru
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            <a href="#" class="fw-semibold text-dark">Koreksi Tugas Siswa</a>
        </li>
    </ol>
</div>

<!-- Header Page Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="row align-items-center g-3">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge text-white rounded-pill px-3 py-1 font-monospace" style="background-color: #10b981;">
                        <i class="ti ti-clipboard-check me-1"></i>Evaluasi &amp; Penilaian
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1 font-monospace">
                        Semua Kelas Aktif
                    </span>
                </div>
                <h1 class="fw-extrabold text-dark display-6 mb-1">Koreksi Tugas Siswa</h1>
                <p class="text-muted small mb-0">
                    Pusat evaluasi dan penilaian seluruh submisi tugas peserta didik di kelas yang Anda ampu.
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                <a href="@Url.Action("Kelas", "Guru")" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-semibold">
                    <i class="ti ti-books me-1"></i> Kelola Kelas Saya
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Stat Cards Submisi -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 text-white p-3" style="background-color: #395886;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase">Total Tugas Terbit</div>
                    <div class="display-6 fw-extrabold my-1">@Model.TotalTugas</div>
                    <div class="small opacity-75">Di seluruh kelas Anda</div>
                </div>
                <span class="avatar avatar-lg bg-white bg-opacity-20 text-white rounded-3">
                    <i class="ti ti-folders fs-1"></i>
                </span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 text-white p-3" style="background-color: #0284c7;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase">Total Submisi Masuk</div>
                    <div class="display-6 fw-extrabold my-1">@Model.TotalSubmisi</div>
                    <div class="small opacity-75">Berkas jawaban siswa</div>
                </div>
                <span class="avatar avatar-lg bg-white bg-opacity-20 text-white rounded-3">
                    <i class="ti ti-file-upload fs-1"></i>
                </span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 text-white p-3" style="background-color: #f59e0b;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase">Perlu Dikoreksi</div>
                    <div class="display-6 fw-extrabold my-1">@Model.TotalPerluDikoreksi</div>
                    <div class="small opacity-75">Menunggu penilaian</div>
                </div>
                <span class="avatar avatar-lg bg-white bg-opacity-20 text-white rounded-3">
                    <i class="ti ti-clock-hour-4 fs-1"></i>
                </span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 text-white p-3" style="background-color: #10b981;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-white opacity-75 small fw-bold text-uppercase">Sudah Dinilai</div>
                    <div class="display-6 fw-extrabold my-1">@Model.TotalSudahDinilai</div>
                    <div class="small opacity-75">Evaluasi tuntas</div>
                </div>
                <span class="avatar avatar-lg bg-white bg-opacity-20 text-white rounded-3">
                    <i class="ti ti-award fs-1"></i>
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Filter & Search Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        @using (Html.BeginForm("KoreksiTugas", "Guru", FormMethod.Get, new { id = "formFilterKoreksi" }))
        {
            <div class="row g-2 align-items-center">
                <!-- Status Tab Buttons -->
                <div class="col-12 col-md-auto">
                    <input type="hidden" name="status" id="filterStatus" value="@Model.SelectedStatus" />
                    <div class="btn-group w-100" role="group">
                        <button type="button" class="btn btn-sm rounded-start-3 px-3 fw-semibold @(Model.SelectedStatus == "PerluDikoreksi" ? "btn-warning text-dark" : "btn-outline-secondary")" onclick="document.getElementById('filterStatus').value='PerluDikoreksi'; document.getElementById('formFilterKoreksi').submit();">
                            <i class="ti ti-clock me-1"></i> Perlu Dikoreksi (@Model.TotalPerluDikoreksi)
                        </button>
                        <button type="button" class="btn btn-sm px-3 fw-semibold @(Model.SelectedStatus == "SudahDinilai" ? "btn-success text-white" : "btn-outline-secondary")" onclick="document.getElementById('filterStatus').value='SudahDinilai'; document.getElementById('formFilterKoreksi').submit();">
                            <i class="ti ti-check me-1"></i> Sudah Dinilai (@Model.TotalSudahDinilai)
                        </button>
                        <button type="button" class="btn btn-sm rounded-end-3 px-3 fw-semibold @(Model.SelectedStatus == "Semua" ? "btn-dark text-white" : "btn-outline-secondary")" onclick="document.getElementById('filterStatus').value='Semua'; document.getElementById('formFilterKoreksi').submit();">
                            Semua (@Model.TotalSubmisi)
                        </button>
                    </div>
                </div>

                <!-- Kelas Filter Dropdown -->
                <div class="col-12 col-md-auto ms-md-auto">
                    <select name="kelasId" class="form-select form-select-sm rounded-3 fw-semibold" onchange="this.form.submit();">
                        @foreach (var opt in Model.DaftarKelasOption)
                        {
                            <option value="@opt.Value" @(opt.Selected ? "selected" : "")>@opt.Text</option>
                        }
                    </select>
                </div>

                <!-- Search Input -->
                <div class="col-12 col-md-3">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search text-muted"></i>
                        </span>
                        <input type="text" name="q" value="@Model.SearchQuery" class="form-control form-control-sm rounded-3" placeholder="Cari siswa atau tugas..." />
                    </div>
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-sm text-white rounded-3 px-3 fw-semibold" style="background-color: #395886;">
                        Filter
                    </button>
                    @if (Model.SelectedKelasId.HasValue || !string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.SelectedStatus != "PerluDikoreksi")
                    {
                        <a href="@Url.Action("KoreksiTugas", "Guru")" class="btn btn-sm btn-outline-secondary rounded-3 px-2" title="Reset Filter">
                            <i class="ti ti-rotate-clockwise"></i>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Tabel Daftar Submisi Siswa -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
        <h3 class="card-title fw-bold text-dark mb-0">
            <i class="ti ti-table me-2 text-primary"></i>Daftar Submisi Tugas Siswa
        </h3>
        <span class="badge bg-light text-dark border font-monospace">
            Total: @Model.DaftarSubmisi.Count Submisi
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table mb-0">
            <thead class="bg-light text-uppercase font-monospace text-muted" style="font-size: 0.75rem;">
                <tr>
                    <th class="ps-4" style="width: 25%;">Nama Siswa</th>
                    <th style="width: 20%;">Kelas &amp; Penugasan</th>
                    <th style="width: 15%;">Waktu Kumpul</th>
                    <th style="width: 15%;">Berkas Jawaban</th>
                    <th style="width: 12%;">Status / Nilai</th>
                    <th class="text-center pe-4" style="width: 13%;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DaftarSubmisi != null && Model.DaftarSubmisi.Any())
                {
                    foreach (var item in Model.DaftarSubmisi)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2.5">
                                    @if (!string.IsNullOrEmpty(item.FotoSiswa))
                                    {
                                        <img src="@item.FotoSiswa" class="avatar avatar-md rounded-circle object-fit-cover shadow-sm border" alt="@item.NamaSiswa" />
                                    }
                                    else
                                    {
                                        <span class="avatar avatar-md text-white rounded-circle fw-bold shadow-sm" style="background-color: #395886;">
                                            @item.NamaSiswa.Substring(0, 1).ToUpper()
                                        </span>
                                    }
                                    <div class="min-w-0">
                                        <div class="fw-bold text-dark text-truncate">@item.NamaSiswa</div>
                                        <div class="text-muted small text-truncate" style="font-size: 0.725rem;">@item.EmailSiswa</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div>
                                    <span class="badge bg-dark-subtle text-dark border rounded-pill px-2 py-0.5 font-monospace me-1" style="font-size: 0.65rem;">
                                        @item.NamaKelas
                                    </span>
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-0.5 font-monospace" style="font-size: 0.65rem;">
                                        P-@item.PertemuanKe
                                    </span>
                                    <div class="fw-semibold text-dark small text-truncate mt-1" style="max-width: 240px;">
                                        @item.JudulTugas
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (item.SubmittedAt.HasValue)
                                {
                                    <div>
                                        <div class="fw-semibold text-dark small">@item.SubmittedAt.Value.ToString("dd MMM yyyy HH:mm") WIB</div>
                                        @if (item.IsLate)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill font-monospace" style="font-size: 0.65rem;">
                                                <i class="ti ti-clock-off me-1"></i>Terlambat
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill font-monospace" style="font-size: 0.65rem;">
                                                <i class="ti ti-check me-1"></i>Tepat Waktu
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.FileSubmisiUrl))
                                {
                                    <a href="@item.FileSubmisiUrl" class="btn btn-sm btn-outline-primary rounded-3 px-2.5 py-1 text-truncate" target="_blank" download style="max-width: 170px;" title="@item.NamaFileSubmisi">
                                        <i class="ti ti-download me-1"></i> @(string.IsNullOrEmpty(item.NamaFileSubmisi) ? "Unduh Berkas" : item.NamaFileSubmisi)
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted italic small">- Tidak ada file -</span>
                                }
                            </td>
                            <td>
                                @if (item.Nilai.HasValue)
                                {
                                    <div>
                                        <span class="badge text-white rounded-pill px-3 py-1 font-monospace fw-bold" style="background-color: #10b981; font-size: 0.85rem;">
                                            @item.Nilai.Value.ToString("0.##") / 100
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.Feedback))
                                        {
                                            <div class="text-muted small text-truncate mt-1" style="max-width: 140px; font-size: 0.7rem;" title="@item.Feedback">
                                                <i class="ti ti-message-2 me-1"></i>@item.Feedback
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 font-monospace fw-bold" style="font-size: 0.725rem;">
                                        <i class="ti ti-clock me-1"></i>Belum Dinilai
                                    </span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-flex align-items-center justify-content-center gap-1.5">
                                    <button type="button" class="btn btn-sm text-white rounded-3 px-2.5 py-1 fw-semibold shadow-sm" style="background-color: #10b981;" data-bs-toggle="modal" data-bs-target="#modal-koreksi-@item.SubmissionId" title="Koreksi & Beri Nilai">
                                        <i class="ti ti-edit me-1"></i> @(item.Nilai.HasValue ? "Ubah Nilai" : "Beri Nilai")
                                    </button>
                                    <a href="@Url.Action("SubmisiTugas", "Guru", new { tugasId = item.TugasId })" class="btn btn-sm btn-outline-secondary rounded-3 px-2 py-1" title="Lihat Submisi Kelas">
                                        <i class="ti ti-external-link"></i>
                                    </a>
                                </div>

                                <!-- Modal Beri Nilai Pop-up Langsung -->
                                <div class="modal modal-blur fade text-start" id="modal-koreksi-@item.SubmissionId" tabindex="-1" role="dialog" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered" role="document">
                                        <div class="modal-content border-0 shadow-lg rounded-4">
                                            @using (Html.BeginForm("BeriNilai", "Guru", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="SubmissionId" value="@item.SubmissionId" />
                                                <input type="hidden" name="TugasId" value="@item.TugasId" />
                                                <input type="hidden" name="KelasId" value="@item.KelasId" />
                                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />

                                                <div class="modal-header bg-white py-3 border-bottom">
                                                    <h3 class="modal-title fw-bold text-dark m-0">
                                                        <i class="ti ti-award me-2 text-success"></i>Koreksi Tugas: @item.NamaSiswa
                                                    </h3>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    <!-- Ringkasan Info Tugas -->
                                                    <div class="bg-light p-3 rounded-3 mb-3 border">
                                                        <div class="row g-2 small">
                                                            <div class="col-6">
                                                                <span class="text-muted d-block">Kelas:</span>
                                                                <strong class="text-dark">@item.NamaKelas</strong>
                                                            </div>
                                                            <div class="col-6">
                                                                <span class="text-muted d-block">Pertemuan:</span>
                                                                <strong class="text-dark">Pertemuan @item.PertemuanKe</strong>
                                                            </div>
                                                            <div class="col-12">
                                                                <span class="text-muted d-block">Judul Penugasan:</span>
                                                                <strong class="text-dark">@item.JudulTugas</strong>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(item.FileSubmisiUrl))
                                                            {
                                                                <div class="col-12 mt-2 pt-2 border-top">
                                                                    <span class="text-muted d-block mb-1">Berkas Submisi Siswa:</span>
                                                                    <a href="@item.FileSubmisiUrl" class="btn btn-sm btn-outline-primary rounded-3 px-2 py-1" target="_blank" download>
                                                                        <i class="ti ti-download me-1"></i> Unduh / Buka File Jawaban
                                                                    </a>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold text-dark">
                                                            Nilai Akhir Siswa (0 - 100) <span class="text-danger">*</span>
                                                        </label>
                                                        <input type="number" name="Nilai" class="form-control form-control-lg rounded-3 fs-2 font-monospace text-center fw-bold" value="@(item.Nilai.HasValue ? item.Nilai.Value.ToString("0.##") : "")" min="0" max="100" step="0.1" placeholder="85" required />
                                                        <small class="text-muted">Masukkan angka antara 0 hingga 100.</small>
                                                    </div>

                                                    <div class="mb-2">
                                                        <label class="form-label fw-semibold text-dark">Catatan &amp; Evaluasi Feedback Guru</label>
                                                        <textarea name="Feedback" class="form-control rounded-3" rows="3" placeholder="Berikan saran perbaikan, ulasan, atau apresiasi atas pekerjaan siswa...">@item.Feedback</textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer bg-light py-3">
                                                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">
                                                        Batal
                                                    </button>
                                                    <button type="submit" class="btn text-white rounded-3 px-4 fw-bold shadow-sm" style="background-color: #10b981;">
                                                        <i class="ti ti-check me-1"></i> Simpan Penilaian
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="empty py-4">
                                <div class="empty-icon mb-2 text-muted">
                                    <i class="ti ti-clipboard-check fs-1 opacity-50"></i>
                                </div>
                                <p class="empty-title fw-bold text-dark mb-1">Tidak Ada Submisi Tugas</p>
                                <p class="empty-subtitle text-secondary small">
                                    @if (Model.SelectedStatus == "PerluDikoreksi")
                                    {
                                        <span>Semua tugas siswa yang masuk telah selesai Anda nilai. Kerja bagus!</span>
                                    }
                                    else
                                    {
                                        <span>Belum ada berkas tugas siswa yang sesuai dengan kriteria filter saat ini.</span>
                                    }
                                </p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
