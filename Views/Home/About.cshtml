@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Tentang Kami - PUB Learning Hub";
    ViewBag.IsPublicPage = true;

    string rawRole = Session["RoleName"] != null ? Session["RoleName"].ToString() : "";
    string targetDashboardUrl = Url.Action("Dashboard", "Siswa");
    if (rawRole.IndexOf("Admin", StringComparison.OrdinalIgnoreCase) >= 0)
    {
        targetDashboardUrl = Url.Action("Dashboard", "Admin");
    }
    else if (rawRole.IndexOf("Guru", StringComparison.OrdinalIgnoreCase) >= 0 || rawRole.IndexOf("Mentor", StringComparison.OrdinalIgnoreCase) >= 0)
    {
        targetDashboardUrl = Url.Action("Dashboard", "Guru");
    }
}

@section styles {
    <style>
        .hero-about {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            position: relative;
            padding: 4.5rem 0 5.5rem 0;
            color: #ffffff;
            overflow: hidden;
        }

        .hero-about::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle at 50% 0%, rgba(57, 88, 134, 0.35), transparent 70%);
            pointer-events: none;
        }

        .hero-badge {
            background: rgba(56, 189, 248, 0.12);
            border: 1px solid rgba(56, 189, 248, 0.3);
            color: #7dd3fc;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.4rem 1.1rem;
            border-radius: 50px;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .hero-title {
            font-size: 2.75rem;
            font-weight: 800;
            line-height: 1.22;
            letter-spacing: -0.8px;
            margin-top: 1rem;
            margin-bottom: 1.25rem;
            background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-subtitle {
            font-size: 1.15rem;
            color: #94a3b8;
            font-weight: 400;
            line-height: 1.65;
            max-width: 720px;
        }

        .vision-card {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid rgba(177, 201, 239, 0.3);
            border-radius: 20px;
            padding: 2.5rem;
            color: #ffffff;
            height: 100%;
        }

        .mission-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 2.5rem;
            height: 100%;
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.04);
        }

        .mission-item {
            display: flex;
            align-items: start;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .mission-number {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: #eff6ff;
            color: #2563eb;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .about-feature-box {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 1.75rem;
            transition: all 0.3s ease;
            height: 100%;
        }

        .about-feature-box:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.06);
            border-color: #93c5fd;
        }

        .icon-box-about {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 1.25rem;
        }

        .cta-banner {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
            border-radius: 24px;
            padding: 4rem 2rem;
            color: #ffffff;
        }

        .pub-footer {
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
            padding: 4rem 0 2rem 0;
            margin-top: 5rem;
        }
    </style>
}

<!-- ============================================================================ -->
<!-- 1. HERO ABOUT SECTION -->
<!-- ============================================================================ -->
<section class="hero-about" id="hero-about">
    <div class="container-xl position-relative text-center">
        <div class="max-w-xl mx-auto">
            <div class="hero-badge mb-3">
                <i class="ti ti-info-circle"></i> Profil &amp; Tentang PUB Learning Hub
            </div>
            <h1 class="hero-title">
                Mencetak Software Engineer Berkarakter Melalui Beasiswa PUB
            </h1>
            <p class="hero-subtitle mx-auto">
                PUB Learning Hub adalah platform pembelajaran dan inkubasi IT terpusat Beasiswa PUB (Program Pemberdayaan Umat Berkelanjutan) untuk memfasilitasi transfer keahlian pemrograman, distribusi modul materi, evaluasi tugas praktikum, dan kuis mingguan secara transparan.
            </p>
        </div>
    </div>
</section>

<!-- ============================================================================ -->
<!-- 2. SECTION VISI & MISI -->
<!-- ============================================================================ -->
<section class="py-6 bg-white" id="visi-misi">
    <div class="container-xl">
        <div class="row g-4 align-items-stretch">
            <!-- Visi Card -->
            <div class="col-lg-5">
                <div class="vision-card" id="vision-card">
                    <span class="badge bg-primary-subtle text-primary font-weight-bold px-3 py-2 rounded-pill mb-3">
                        <i class="ti ti-eye me-1"></i> Visi Utama
                    </span>
                    <h2 class="h1 font-weight-extrabold text-white mb-3">Pusat Pembinaan &amp; Inkubasi IT Unggulan</h2>
                    <p class="text-slate-300 fs-3 lh-base mb-0">
                        "Mewujudkan ekosistem pelatihan IT berbasis beasiswa yang melahirkan software engineer berdaya saing tinggi, berintegritas, mandiri, dan siap berkontribusi nyata bagi industri teknologi serta kemaslahatan umat."
                    </p>
                </div>
            </div>

            <!-- Misi Card -->
            <div class="col-lg-7">
                <div class="mission-card" id="mission-card">
                    <span class="badge bg-purple-subtle text-purple font-weight-bold px-3 py-2 rounded-pill mb-3">
                        <i class="ti ti-target me-1"></i> Misi Program
                    </span>
                    <h2 class="h2 font-weight-bold text-slate-900 mb-4">Langkah Strategis Pembinaan Beasiswa PUB</h2>

                    <div class="mission-item">
                        <div class="mission-number">1</div>
                        <div>
                            <h4 class="font-weight-bold text-dark mb-1">Kurikulum Berjenjang &amp; Berkelanjutan</h4>
                            <p class="text-muted fs-4 mb-0">Menyelenggarakan pelatihan rutin mingguan mulai dari fondasi logika dasar (C, Struktur Data, SQL, Web) hingga spesialisasi enterprise (Java, .NET, React).</p>
                        </div>
                    </div>

                    <div class="mission-item">
                        <div class="mission-number">2</div>
                        <div>
                            <h4 class="font-weight-bold text-dark mb-1">Evaluasi Objektif &amp; Standar Mutu Minimum 70</h4>
                            <p class="text-muted fs-4 mb-0">Menerapkan sistem penilaian terpadu berbasis tugas praktikum coding, kuis, dan kedisiplinan presensi kehadiran dengan rekapitulasi nilai transparan.</p>
                        </div>
                    </div>

                    <div class="mission-item mb-0">
                        <div class="mission-number">3</div>
                        <div>
                            <h4 class="font-weight-bold text-dark mb-1">Budaya Mentoring &amp; Transfer Knowledge</h4>
                            <p class="text-muted fs-4 mb-0">Memfasilitasi kolaborasi intensif antara Instruktur (senior/alumni) dan Peserta beasiswa (adik tingkat) tanpa hambatan alat komunikasi terpisah.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================================ -->
<!-- 3. SECTION FITUR OPERASIONAL PLATFORM -->
<!-- ============================================================================ -->
<section class="py-6" style="background-color: #f8fafc;" id="fitur-utama">
    <div class="container-xl">
        <div class="text-center max-w-xl mx-auto mb-5">
            <span class="badge bg-blue-subtle text-blue font-weight-semibold px-3 py-2 rounded-pill mb-2">
                <i class="ti ti-layout-grid me-1"></i> Fitur Ekosistem
            </span>
            <h2 class="h1 font-weight-extrabold text-dark">Modul Pembelajaran PUB Learning Hub</h2>
            <p class="text-muted fs-3">Seluruh modul dirancang untuk menyokong kebutuhan praktikum coding dan manajemen kelas intensif.</p>
        </div>

        <div class="row g-4">
            <!-- Modul 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="about-feature-box">
                    <div class="icon-box-about bg-primary-subtle text-primary">
                        <i class="ti ti-books"></i>
                    </div>
                    <h3 class="h3 font-weight-bold text-dark mb-2">Distribusi Modul Materi</h3>
                    <p class="text-muted fs-4">Instruktur mengunggah modul pembelajaran (PDF, DOCX, Video MP4) per pertemuan dengan fitur tracking pembacaan mandiri oleh peserta.</p>
                </div>
            </div>

            <!-- Modul 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="about-feature-box">
                    <div class="icon-box-about bg-purple-subtle text-purple">
                        <i class="ti ti-bulb"></i>
                    </div>
                    <h3 class="h3 font-weight-bold text-dark mb-2">Kuis Pilihan Ganda Ter-Timer</h3>
                    <p class="text-muted fs-4">Ujian pemahaman konsep coding dengan batasan waktu, auto-grading otomatis, dan kalkulasi nilai yang langsung terakumulasi ke buku nilai.</p>
                </div>
            </div>

            <!-- Modul 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="about-feature-box">
                    <div class="icon-box-about bg-success-subtle text-success">
                        <i class="ti ti-code"></i>
                    </div>
                    <h3 class="h3 font-weight-bold text-dark mb-2">Tugas Praktikum Koding</h3>
                    <p class="text-muted fs-4">Peserta mengumpulkan source code praktikum sesuai deadline, dan Instruktur dapat mengunduh serta memberikan koreksi skor dan masukan langsung.</p>
                </div>
            </div>

            <!-- Modul 4 -->
            <div class="col-md-6 col-lg-4">
                <div class="about-feature-box">
                    <div class="icon-box-about bg-warning-subtle text-warning">
                        <i class="ti ti-calendar-check"></i>
                    </div>
                    <h3 class="h3 font-weight-bold text-dark mb-2">Presensi Kehadiran Terpantau</h3>
                    <p class="text-muted fs-4">Pencatatan kehadiran sesi kelas mingguan berbasis token dan jadwal aktif guna menjamin kedisiplinan peserta di setiap pertemuan.</p>
                </div>
            </div>

            <!-- Modul 5 -->
            <div class="col-md-6 col-lg-4">
                <div class="about-feature-box">
                    <div class="icon-box-about bg-danger-subtle text-danger">
                        <i class="ti ti-chart-arrows"></i>
                    </div>
                    <h3 class="h3 font-weight-bold text-dark mb-2">Buku Nilai &amp; Standar Kelulusan</h3>
                    <p class="text-muted fs-4">Kalkulasi nilai otomatis multi-komponen (Tugas 40%, Kuis 30%, Materi 15%, Presensi 15%) dengan standar kelulusan minimum 70.</p>
                </div>
            </div>

            <!-- Modul 6 -->
            <div class="col-md-6 col-lg-4">
                <div class="about-feature-box">
                    <div class="icon-box-about bg-teal-subtle text-teal" style="background: #e6fffa; color: #0d9488;">
                        <i class="ti ti-speakerphone"></i>
                    </div>
                    <h3 class="h3 font-weight-bold text-dark mb-2">Stream Diskusi &amp; Notifikasi</h3>
                    <p class="text-muted fs-4">Ruang stream pengumuman kelas, tanya-jawab teknis, dan notifikasi real-time bagi Instruktur maupun Peserta beasiswa.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================================ -->
<!-- 4. CALL-TO-ACTION BANNER -->
<!-- ============================================================================ -->
<section class="py-6 bg-white">
    <div class="container-xl">
        <div class="cta-banner text-center position-relative shadow-lg" id="cta-banner-about">
            <div class="max-w-xl mx-auto position-relative z-index-1">
                <h2 class="h1 font-weight-extrabold mb-3 text-white">Komitmen Pembinaan Karakter &amp; Kompetensi</h2>
                <p class="fs-3 text-blue-100 mb-4 opacity-90">
                    Bersama Beasiswa PUB, kembangkan kompetensi rekayasa perangkat lunak terbaik untuk membangun masa depan teknologi yang mandiri.
                </p>
                @if (Session["UserId"] != null)
                {
                    <a href="@targetDashboardUrl" class="btn btn-light btn-lg font-weight-bold px-4 rounded-pill shadow-sm" id="btn-cta-about-register">
                        <i class="ti ti-layout-dashboard me-2"></i> Buka Dashboard Ruang Belajar
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="btn btn-light btn-lg font-weight-bold px-4 rounded-pill shadow-sm" id="btn-cta-about-register">
                        <i class="ti ti-login me-2"></i> Masuk ke Portal Belajar
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<!-- ============================================================================ -->
<!-- 5. FOOTER HALAMAN -->
<!-- ============================================================================ -->
<footer class="pub-footer">
    <div class="container-xl">
        <div class="row gy-4 mb-4">
            <!-- Brand Info -->
            <div class="col-lg-5">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="avatar rounded-circle shadow-sm border overflow-hidden bg-white d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; min-width: 44px; border-color: #B1C9EF !important;">
                        <img src="@Url.Content("~/Content/images/logo-pub.png")" alt="Logo PUB" class="w-100 h-100 object-fit-contain" style="padding: 2px;" />
                    </span>
                    <span class="fw-bold text-dark fs-2">PUB Learning Hub</span>
                </div>
                <p class="text-muted fs-4 lh-base" style="max-width: 440px;">
                    Platform pembelajaran dan inkubasi IT resmi Beasiswa PUB (Program Pemberdayaan Umat Berkelanjutan) untuk membina talenta rekayasa perangkat lunak berkarakter dan berintegritas tinggi.
                </p>
            </div>

            <!-- Links -->
            <div class="col-6 col-lg-2 ms-lg-auto">
                <h4 class="fw-bold text-dark mb-3">Navigasi</h4>
                <div class="d-flex flex-column gap-2">
                    <a href="@Url.Action("Index", "Home")" class="text-muted text-decoration-none">Beranda</a>
                    <a href="@Url.Action("Index", "Home")#jalur-pelatihan" class="text-muted text-decoration-none">Jalur Pelatihan</a>
                    <a href="@Url.Action("Index", "Home")#evaluasi" class="text-muted text-decoration-none">Sistem Evaluasi</a>
                    <a href="@Url.Action("About", "Home")" class="text-muted text-decoration-none">Tentang Kami</a>
                </div>
            </div>

            <div class="col-6 col-lg-2">
                <h4 class="fw-bold text-dark mb-3">Portal Akses</h4>
                <div class="d-flex flex-column gap-2">
                    <a href="@Url.Action("Login", "Account")" class="text-muted text-decoration-none">Masuk Peserta / Instruktur</a>
                    <a href="@Url.Action("Register", "Account")" class="text-muted text-decoration-none">Registrasi Akun</a>
                </div>
            </div>

            <div class="col-lg-3">
                <h4 class="fw-bold text-dark mb-3">Sekretariat</h4>
                <div class="text-muted fs-4 lh-base">
                    Program Pemberdayaan Umat Berkelanjutan (PUB)<br />
                    Inkubasi Rekayasa Perangkat Lunak<br />
                    Email: admin@pub.or.id
                </div>
            </div>
        </div>

        <div class="pt-4 border-top text-center text-muted fs-5">
            &copy; @DateTime.Now.Year PUB Learning Hub &bull; Program Pemberdayaan Umat Berkelanjutan. All Rights Reserved.
        </div>
    </div>
</footer>
