</section>

<!-- ============================================================================ -->
<!-- 5. ALUR KERJA & PEMBELAJARAN PESERTA -->
<!-- ============================================================================ -->
<section class="py-6 bg-white" id="cara-kerja">
    <div class="container-xl">
        <div class="text-center mb-5">
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 font-monospace mb-2">
                WORKFLOW PEMBELAJARAN
            </span>
            <h2 class="pub-section-title">Alur Kegiatan Belajar Peserta</h2>
            <p class="pub-section-subtitle mx-auto">
                Langkah terpadu peserta dalam menjalani rangkaian modul pelatihan setiap pekannya.
            </p>
        </div>

        <div class="row g-4 position-relative">
            <!-- Step 1 -->
            <div class="col-6 col-lg-3">
                <div class="pub-step-card">
                    <div class="pub-step-icon-wrapper">
                        <i class="ti ti-id-badge-2"></i>
                        <span class="pub-step-badge">1</span>
                    </div>
                    <div class="pub-step-title">Akses Akun Resmi</div>
                    <div class="pub-step-desc">Masuk portal dengan kredensial peserta beasiswa terdaftar.</div>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="col-6 col-lg-3">
                <div class="pub-step-card">
                    <div class="pub-step-icon-wrapper">
                        <i class="ti ti-book-2"></i>
                        <span class="pub-step-badge">2</span>
                    </div>
                    <div class="pub-step-title">Pelajari Modul</div>
                    <div class="pub-step-desc">Unduh berkas materi, tandai baca, dan hadiri sesi presensi mingguan.</div>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col-6 col-lg-3">
                <div class="pub-step-card">
                    <div class="pub-step-icon-wrapper">
                        <i class="ti ti-code-plus"></i>
                        <span class="pub-step-badge">3</span>
                    </div>
                    <div class="pub-step-title">Tugas &amp; Kuis Coding</div>
                    <div class="pub-step-desc">Kumpulkan source code tugas praktikum dan ikuti kuis pilihan ganda.</div>
                </div>
            </div>

            <!-- Step 4 -->
            <div class="col-6 col-lg-3">
                <div class="pub-step-card">
                    <div class="pub-step-icon-wrapper">
                        <i class="ti ti-chart-dots"></i>
                        <span class="pub-step-badge">4</span>
                    </div>
                    <div class="pub-step-title">Evaluasi &amp; Penjurusan</div>
                    <div class="pub-step-desc">Raih nilai rata-rata di atas 70 untuk kelulusan dan penjurusan karir.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================================ -->
<!-- 6. BOTTOM CTA BANNER -->
<!-- ============================================================================ -->
<section class="container-xl">
    <div class="pub-cta-box">
        <div class="row align-items-center gy-4">
            <div class="col-lg-2 text-center">
                <span class="avatar rounded-circle shadow-lg border border-white border-opacity-25 bg-white d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <img src="@Url.Content("~/Content/images/logo-pub.png")" alt="Logo PUB" class="w-100 h-100 object-fit-contain" style="padding: 4px;" />
                </span>
            </div>

            <div class="col-lg-7">
                <h3 class="fw-extrabold text-white fs-2 mb-2">Siap Memulai Pelatihan Coding Pekan Ini?</h3>
