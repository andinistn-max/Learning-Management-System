                    </div>
                </div>
            </div>

            <!-- Stat 2 -->
            <div class="col-6 col-lg-3">
                <div class="pub-stat-card">
                    <div class="pub-stat-icon" style="background: #ede9fe; color: #7c3aed;">
                        <i class="ti ti-git-fork"></i>
                    </div>
                    <div>
                        <div class="pub-stat-number">2 Tahap</div>
                        <div class="pub-stat-label">Pondasi &amp; Spesialisasi</div>
                    </div>
                </div>
            </div>

            <!-- Stat 3 -->
            <div class="col-6 col-lg-3">
                <div class="pub-stat-card">
                    <div class="pub-stat-icon" style="background: #d1fae5; color: #059669;">
                        <i class="ti ti-user-check"></i>
                    </div>
                    <div>
                        <div class="pub-stat-number">Instruktur</div>
                        <div class="pub-stat-label">Alumni &amp; Senior Terpilih</div>
                    </div>
                </div>
            </div>

            <!-- Stat 4 -->
            <div class="col-6 col-lg-3">
                <div class="pub-stat-card">
                    <div class="pub-stat-icon" style="background: #fef3c7; color: #d97706;">
                        <i class="ti ti-award"></i>
                    </div>
                    <div>
                        <div class="pub-stat-number">70 Min</div>
                        <div class="pub-stat-label">Passing Grade Kelulusan</div>
                    </div>
                </div>
            </div>
        </div>
