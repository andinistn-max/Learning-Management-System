                    Masuk ke ruang belajar portal untuk mengakses materi modul, presensi pertemuan, dan mengumpulkan tugas praktikum bersama Instruktur.
                </p>
            </div>

            <div class="col-lg-3 text-lg-end">
                @if (Session["UserId"] != null)
                {
                    <a href="@targetDashboardUrl" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm" style="background-color: var(--pub-accent); border-color: var(--pub-accent);">
                        Buka Dashboard <i class="ti ti-arrow-right ms-1"></i>
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm" style="background-color: var(--pub-accent); border-color: var(--pub-accent);">
                        Masuk Ruang Belajar <i class="ti ti-arrow-right ms-1"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

