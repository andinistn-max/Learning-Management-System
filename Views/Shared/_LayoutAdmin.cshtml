@{
    string currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string userName = Session["NamaLengkap"] != null ? Session["NamaLengkap"].ToString() : "Administrator";
    string userEmail = Session["Email"] != null ? Session["Email"].ToString() : "admin@pub.or.id";
    string userFoto = Session["FotoProfile"] != null ? Session["FotoProfile"].ToString() : null;
}
<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewBag.Title - PUB Learning Hub</title>

    <!-- Google Font Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Core CSS: Tabler UI & Icons via jsDelivr (Bebas Blokir) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@("@")tabler/core@1.0.0-beta20/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@("@")tabler/icons-webfont@latest/dist/tabler-icons.min.css" />

    <style>
        :root {
            --pub-bg: #F0F3FA;
            --pub-border-light: #D5DEEF;
            --pub-border: #B1C9EF;
            --pub-accent: #8AAEE0;
            --pub-primary: #638ECB;
            --pub-dark: #395886;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--pub-bg) !important;
            color: #1e293b;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }

        /* 1. KUNCI SUSUNAN DUA KOLOM: KIRI SIDEBAR, KANAN KONTEN */
        .page {
            display: flex !important;
            flex-direction: row !important;
            min-height: 100vh !important;
            width: 100% !important;
        }

        /* 2. SIDEBAR DI PINGGIR KIRI (TIDAK AKAN NAIK KE ATAS) */
        aside.pub-sidebar-locked {
            width: 260px !important;
            min-width: 260px !important;
            max-width: 260px !important;
            min-height: 100vh !important;
            height: 100vh !important;
            background-color: var(--pub-dark) !important;
            position: sticky !important;
            top: 0 !important;
            left: 0 !important;
            z-index: 1020 !important;
            display: flex !important;
            flex-direction: column !important;
            border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
            overflow-y: auto !important;
        }

            aside.pub-sidebar-locked .navbar-brand {
                padding: 1.25rem 1.5rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            aside.pub-sidebar-locked .nav-link {
                color: #D5DEEF !important;
                font-weight: 500;
                font-size: 0.9rem;
                padding: 0.7rem 1.25rem !important;
                margin: 0.15rem 0.75rem !important;
                border-radius: 8px !important;
                display: flex !important;
                align-items: center !important;
                transition: all 0.2s ease;
            }

                aside.pub-sidebar-locked .nav-link:hover {
                    color: #ffffff !important;
                    background: rgba(255, 255, 255, 0.1) !important;
                }

            aside.pub-sidebar-locked .nav-item.active > .nav-link {
                color: #ffffff !important;
                background: var(--pub-primary) !important;
                font-weight: 700 !important;
                box-shadow: 0 4px 12px rgba(99, 142, 203, 0.4) !important;
            }

            aside.pub-sidebar-locked .nav-link-icon {
                color: var(--pub-accent);
                font-size: 1.25rem;
                margin-right: 0.75rem;
            }

            aside.pub-sidebar-locked .nav-item.active .nav-link-icon {
                color: #ffffff !important;
            }

        .nav-header-heading {
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--pub-accent);
            opacity: 0.85;
            padding: 1.25rem 1.5rem 0.4rem 1.5rem;
        }

        /* 3. AREA KONTEN SEBELAH KANAN (TIDAK AKAN TERTINDAS) */
        .page-wrapper {
            flex: 1 1 auto !important;
            min-width: 0 !important;
            display: flex !important;
            flex-direction: column !important;
            background-color: var(--pub-bg) !important;
        }

        .admin-topbar {
            background: #ffffff !important;
            border-bottom: 1px solid var(--pub-border-light);
            padding: 0.75rem 2rem;
            box-shadow: 0 2px 4px rgba(57, 88, 134, 0.03);
            position: sticky;
            top: 0;
            z-index: 1010;
        }

        .btn-pub-primary {
            background-color: var(--pub-primary) !important;
            border-color: var(--pub-primary) !important;
            color: #ffffff !important;
        }

            .btn-pub-primary:hover {
                background-color: var(--pub-dark) !important;
                border-color: var(--pub-dark) !important;
            }
    </style>
    @RenderSection("styles", required: false)
</head>

<body class="layout-fluid">
    <div class="page">
        <!-- 1. SIDEBAR VERTIKAL KIRI -->
        <aside class="navbar navbar-vertical navbar-dark pub-sidebar-locked d-print-none">
            <div class="container-fluid flex-column align-items-stretch p-0">
                <!-- Brand Logo & Nama PUB -->
                <div class="navbar-brand">
                    <a href="@Url.Action("Dashboard", "Admin")" class="d-flex align-items-center gap-2 text-decoration-none">
                        <span class="avatar rounded-circle shadow-sm border overflow-hidden bg-white d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; min-width: 44px; border-color: #B1C9EF !important;">
                            <img src="@Url.Content("~/Content/images/logo-pub.png")" alt="Logo PUB" class="w-100 h-100 object-fit-contain" style="padding: 2px;" onerror="this.outerHTML='<span class=\'fw-bold text-white fs-4 w-100 h-100 rounded-circle d-flex align-items-center justify-content-center\' style=\'background-color: #395886;\'>PUB</span>';" />
                        </span>
                        <div class="text-start">
                            <span class="fw-bold d-block lh-1 text-white fs-3">PUB Hub</span>
                            <span class="badge text-white rounded-pill mt-1" style="font-size: 0.625rem; padding: 0.2rem 0.5rem; background-color: #ef4444;">ADMIN PORTAL</span>
                        </div>
                    </a>
                </div>

                <!-- Menu Navigasi Tegak Lurus -->
                <div class="w-100" id="sidebar-menu">
                    <ul class="navbar-nav flex-column pt-2">
                        <div class="nav-header-heading">MENU UTAMA</div>

                        <!-- 1. Dashboard Admin -->
                        <li class="nav-item @(currentCtrl.Equals("Admin", StringComparison.OrdinalIgnoreCase) && (currentAct.Equals("Dashboard", StringComparison.OrdinalIgnoreCase) || currentAct.Equals("Index", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">
                                <span class="nav-link-icon"><i class="ti ti-dashboard"></i></span>
                                <span class="nav-link-title">Dashboard</span>
                            </a>
                        </li>

                        <div class="nav-header-heading">PELATIHAN BEASISWA PUB</div>

                        <!-- 2. Manajemen Guru / Mentor -->
                        <li class="nav-item @(currentCtrl.Equals("Admin", StringComparison.OrdinalIgnoreCase) && currentAct.Equals("Guru", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("Guru", "Admin")">
                                <span class="nav-link-icon"><i class="ti ti-users"></i></span>
                                <span class="nav-link-title">Mentor / Instruktur</span>
                            </a>
                        </li>

                        <!-- 3. Manajemen Siswa / Peserta PUB -->
                        <li class="nav-item @(currentCtrl.Equals("Admin", StringComparison.OrdinalIgnoreCase) && currentAct.Equals("Siswa", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("Siswa", "Admin")">
                                <span class="nav-link-icon"><i class="ti ti-school"></i></span>
                                <span class="nav-link-title">Peserta Beasiswa</span>
                            </a>
                        </li>

                        <!-- 4. Manajemen Kelas (Pondasi & Spesialisasi) -->
                        <li class="nav-item @(currentCtrl.Equals("Admin", StringComparison.OrdinalIgnoreCase) && currentAct.Equals("Kelas", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("Kelas", "Admin")">
                                <span class="nav-link-icon"><i class="ti ti-books"></i></span>
                                <span class="nav-link-title">Monitoring Kelas</span>
                            </a>
                        </li>

                        <div class="nav-header-heading">PELAPORAN & AUDIT</div>

                        <!-- 5. Menu Laporan & Rekap Kelulusan -->
                        <li class="nav-item @(currentCtrl.Equals("Admin", StringComparison.OrdinalIgnoreCase) && currentAct.Equals("Laporan", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("Laporan", "Admin")">
                                <span class="nav-link-icon"><i class="ti ti-file-spreadsheet"></i></span>
                                <span class="nav-link-title">Laporan Penjurusan</span>
                            </a>
                        </li>

                        <!-- 6. Menu Log Aktivitas -->
                        <li class="nav-item @(currentCtrl.Equals("Admin", StringComparison.OrdinalIgnoreCase) && currentAct.Equals("LogAktivitas", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("LogAktivitas", "Admin")">
                                <span class="nav-link-icon"><i class="ti ti-history"></i></span>
                                <span class="nav-link-title">Log Aktivitas</span>
                            </a>
                        </li>

                        <div class="nav-header-heading">PENGATURAN</div>

                        <!-- 7. Pengaturan Profil -->
                        <li class="nav-item @(currentCtrl.Equals("Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("Index", "Profile")">
                                <span class="nav-link-icon"><i class="ti ti-settings"></i></span>
                                <span class="nav-link-title">Pengaturan Profil</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </aside>

        <!-- 2. MAIN BODY KANAN -->
        <div class="page-wrapper">
            <!-- Header Topbar Admin -->
            <header class="navbar navbar-expand-md d-print-none admin-topbar sticky-top">
                <div class="container-fluid p-0">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Panel Kontrol Beasiswa PUB</span>
                        <span class="text-muted opacity-50">/</span>
                        <span class="fw-bold" style="color: var(--pub-dark);">@(ViewBag.Title ?? "Dashboard Admin")</span>
                    </div>

                    <div class="navbar-nav flex-row ms-auto align-items-center gap-3">
                        <!-- User Profile Info -->
                        <div class="d-flex align-items-center gap-2">
                            <span class="avatar avatar-sm text-white rounded-circle fw-bold" style="background-color: var(--pub-primary);">
                                @userName.Substring(0, 1).ToUpper()
                            </span>
                            <div class="d-none d-md-block text-start">
                                <div class="fw-bold text-dark lh-1 small">@userName</div>
                                <div class="text-muted extra-small" style="font-size: 0.72rem;">Super Administrator</div>
                            </div>
                            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutFormAdminTop", @class = "m-0 ms-2" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="ti ti-logout me-1"></i> Keluar
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content Body -->
            <div class="page-body pt-2 pb-4">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </div>

            <!-- Footer Admin -->
            <footer class="footer footer-transparent d-print-none border-top py-3 mt-auto bg-white">
                <div class="container-xl">
                    <div class="row text-center align-items-center flex-row-reverse">
                        <div class="col-lg-auto ms-lg-auto">
                            <span class="text-secondary small">PUB Learning Hub &bull; Pelatihan Beasiswa Terpadu</span>
                        </div>
                        <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                            <span class="text-secondary small">&copy; @DateTime.Now.Year Adinata LMS - Hak Cipta Dilindungi.</span>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@("@")tabler/core@1.0.0-beta20/dist/js/tabler.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>