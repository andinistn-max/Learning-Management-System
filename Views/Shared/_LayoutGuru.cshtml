@{
    string currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string userName = Session["NamaLengkap"] != null ? Session["NamaLengkap"].ToString() : "Guru LMS";
    string userEmail = Session["Email"] != null ? Session["Email"].ToString() : "guru@pub.or.id";
    string userFoto = Session["FotoProfile"] != null ? Session["FotoProfile"].ToString() : null;
}
<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewBag.Title - Portal Pengajar PUB Learning Hub</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Tabler UI Official CDN via jsDelivr (Bebas Blokir) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@("@")tabler/core@1.0.0-beta20/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@("@")tabler/icons-webfont@latest/dist/tabler-icons.min.css" />

    <!-- Custom CSS Polish -->
    <link rel="stylesheet" href="~/Content/Site.css" />

    <style>
        :root {
            --pub-bg: #F0F3FA;
            --pub-border-light: #D5DEEF;
            --pub-border: #B1C9EF;
            --pub-accent: #8AAEE0;
            --pub-primary: #638ECB;
            --pub-dark: #395886;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--pub-bg) !important;
            color: #1e293b;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }

        /* Struktur Flexbox Kiri-Kanan */
        .page {
            display: flex !important;
            flex-direction: row !important;
            min-height: 100vh !important;
            width: 100% !important;
        }

        /* Sidebar Guru Terkunci di Kiri */
        aside.pub-sidebar-guru {
            width: 260px !important;
            min-width: 260px !important;
            max-width: 260px !important;
            min-height: 100vh !important;
            height: 100vh !important;
            background-color: var(--pub-dark) !important;
            position: sticky !important;
            top: 0 !important;
            left: 0 !important;
            z-index: 1020 !important;
            display: flex !important;
            flex-direction: column !important;
            border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
            overflow-y: auto !important;
        }

            aside.pub-sidebar-guru .navbar-brand {
                padding: 1.25rem 1.5rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            aside.pub-sidebar-guru .nav-link {
                color: #D5DEEF !important;
                font-weight: 500;
                font-size: 0.9rem;
                padding: 0.7rem 1.25rem !important;
                margin: 0.15rem 0.75rem !important;
                border-radius: 8px !important;
                display: flex !important;
                align-items: center !important;
                transition: all 0.2s ease;
            }

                aside.pub-sidebar-guru .nav-link:hover {
                    color: #ffffff !important;
                    background: rgba(255, 255, 255, 0.1) !important;
                }

            aside.pub-sidebar-guru .nav-item.active > .nav-link {
                color: #ffffff !important;
                background: var(--pub-primary) !important;
                font-weight: 700 !important;
                box-shadow: 0 4px 12px rgba(99, 142, 203, 0.4) !important;
            }

            aside.pub-sidebar-guru .nav-link-icon {
                color: var(--pub-accent);
                font-size: 1.25rem;
                margin-right: 0.75rem;
            }

            aside.pub-sidebar-guru .nav-item.active .nav-link-icon {
                color: #ffffff !important;
            }

        .nav-header-heading {
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--pub-accent);
            opacity: 0.85;
            padding: 1.25rem 1.5rem 0.4rem 1.5rem;
        }

        /* Area Konten Kanan */
        .page-wrapper {
            flex: 1 1 auto !important;
            min-width: 0 !important;
            display: flex !important;
            flex-direction: column !important;
            background-color: var(--pub-bg) !important;
        }

        .admin-topbar {
            background: #ffffff !important;
            border-bottom: 1px solid var(--pub-border-light);
            padding: 0.75rem 2rem;
            box-shadow: 0 2px 4px rgba(57, 88, 134, 0.03);
            position: sticky;
            top: 0;
            z-index: 1010;
        }
    </style>

    @RenderSection("styles", required: false)
</head>
<body class="layout-fluid">
    <div class="page">
        <!-- Sidebar Navigasi Kiri (Vertical Navbar Guru PUB) -->
        <aside class="navbar navbar-vertical navbar-dark pub-sidebar-guru d-print-none">
            <div class="container-fluid flex-column align-items-stretch p-0">
                <!-- Brand Logo & Badge Guru / Pengajar -->
                <div class="navbar-brand">
                    <a href="@Url.Action("Dashboard", "Guru")" class="d-flex align-items-center gap-2 text-decoration-none">
                        <span class="avatar rounded-circle shadow-sm border overflow-hidden bg-white d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; min-width: 44px; border-color: #B1C9EF !important;">
                            <img src="@Url.Content("~/Content/images/logo-pub.png")" alt="Logo PUB" class="w-100 h-100 object-fit-contain" style="padding: 2px;" onerror="this.outerHTML='<span class=\'fw-bold text-white fs-4 w-100 h-100 rounded-circle d-flex align-items-center justify-content-center\' style=\'background-color: #395886;\'>PUB</span>';" />
                        </span>
                        <div class="text-start">
                            <span class="fw-bold d-block lh-1 text-white fs-3">PUB Hub</span>
                            <span class="badge text-white rounded-pill mt-1" style="font-size: 0.625rem; padding: 0.2rem 0.5rem; background-color: #10b981;">GURU / MENTOR</span>
                        </div>
                    </a>
                </div>

                <!-- Menu Navigasi Tegak Lurus -->
                <div class="w-100" id="sidebar-menu">
                    <ul class="navbar-nav flex-column pt-2">
                        <div class="nav-header-heading">MENU UTAMA</div>

                        <li class="nav-item @(currentAct.Equals("Dashboard", StringComparison.OrdinalIgnoreCase) || currentAct.Equals("Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("Dashboard", "Guru")">
                                <span class="nav-link-icon"><i class="ti ti-layout-dashboard"></i></span>
                                <span class="nav-link-title">Dashboard Pengajar</span>
                            </a>
                        </li>

                        <li class="nav-item @(currentAct.Equals("Kelas", StringComparison.OrdinalIgnoreCase) || currentAct.Equals("RuangKelas", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("Kelas", "Guru")">
                                <span class="nav-link-icon"><i class="ti ti-books"></i></span>
                                <span class="nav-link-title">Kelas Saya</span>
                            </a>
                        </li>

                        <li class="nav-item @(currentAct.Equals("BuatKelas", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("BuatKelas", "Guru")">
                                <span class="nav-link-icon"><i class="ti ti-circle-plus"></i></span>
                                <span class="nav-link-title">Buat Kelas Baru</span>
                            </a>
                        </li>

                        <div class="nav-header-heading">EVALUASI &amp; PENILAIAN</div>

                        <li class="nav-item @(currentAct.Equals("Tugas", StringComparison.OrdinalIgnoreCase) || currentAct.Equals("KoreksiTugas", StringComparison.OrdinalIgnoreCase) || currentAct.Equals("SubmisiTugas", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("KoreksiTugas", "Guru")">
                                <span class="nav-link-icon"><i class="ti ti-clipboard-check"></i></span>
                                <span class="nav-link-title">Koreksi Tugas Siswa</span>
                            </a>
                        </li>

                        <li class="nav-item @(currentAct.Equals("Nilai", StringComparison.OrdinalIgnoreCase) || currentAct.Equals("Gradebook", StringComparison.OrdinalIgnoreCase) || currentAct.Equals("RekapNilaiKalkulasi", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("Gradebook", "Guru")">
                                <span class="nav-link-icon"><i class="ti ti-report-analytics"></i></span>
                                <span class="nav-link-title">Rekap Gradebook</span>
                            </a>
                        </li>

                        <div class="nav-header-heading">PENGATURAN</div>

                        <li class="nav-item @(currentCtrl.Equals("Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("Index", "Profile")">
                                <span class="nav-link-icon"><i class="ti ti-user-cog"></i></span>
                                <span class="nav-link-title">Pengaturan Profil</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </aside>

        <!-- Main Body Wrapper -->
        <div class="page-wrapper">
            <!-- Header Topbar Guru -->
            <header class="navbar navbar-expand-md d-print-none admin-topbar sticky-top">
                <div class="container-fluid p-0">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Ruang Mentor PUB</span>
                        <span class="text-muted opacity-50">/</span>
                        <span class="fw-bold" style="color: var(--pub-dark);">@(ViewBag.Title ?? "Dashboard Pengajar")</span>
                    </div>

                    <div class="navbar-nav flex-row ms-auto align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(userFoto))
                            {
                                <img src="@userFoto" class="avatar avatar-sm rounded-circle border" alt="@userName" />
                            }
                            else
                            {
                                <span class="avatar avatar-sm text-white rounded-circle fw-bold" style="background-color: var(--pub-primary);">
                                    @userName.Substring(0, 1).ToUpper()
                                </span>
                            }
                            <div class="d-none d-md-block text-start">
                                <div class="fw-bold text-dark lh-1 small">@userName</div>
                                <div class="text-muted extra-small" style="font-size: 0.72rem;">Instruktur / Mentor</div>
                            </div>
                            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutFormGuruTop", @class = "m-0 ms-2" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="ti ti-logout me-1"></i> Keluar
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content Body -->
            <div class="page-body py-4">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </div>

            <!-- Footer -->
            <footer class="footer footer-transparent d-print-none border-top py-3 mt-auto bg-white">
                <div class="container-xl">
                    <div class="row text-center align-items-center flex-row-reverse">
                        <div class="col-lg-auto ms-lg-auto">
                            <span class="text-secondary small">PUB Learning Hub &bull; Portal Pengajar &amp; Mentor</span>
                        </div>
                        <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                            <span class="text-secondary small">&copy; @DateTime.Now.Year PUB Learning Hub - Hak Cipta Dilindungi.</span>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Global Toast Notification Component -->
    @Html.Partial("_ToastNotification")

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@("@")tabler/core@1.0.0-beta20/dist/js/tabler.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>