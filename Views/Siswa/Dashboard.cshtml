</div>

<!-- ==========================================================================
     BARIS 2: KELAS YANG DIIKUTI (KIRI) & KALENDER + DEADLINE (KANAN)
     ========================================================================== -->
<div class="row g-4 mb-4">
    <!-- Kolom Kiri (8 Kolom): Kartu Kelas Google Classroom Modern -->
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2" style="font-size: 1.15rem;">
                <i class="ti ti-books text-primary"></i> Kelas Yang Diikuti
            </h3>
            <span class="badge bg-white text-secondary border font-monospace px-3 py-1.5 rounded-pill shadow-none" style="font-size: 0.75rem;">
                @Model.TotalKelasDiikuti Kelas Terdaftar
            </span>
        </div>

        @if (Model.DaftarKelasSiswa != null && Model.DaftarKelasSiswa.Any())
        {
            <div class="row g-3">
                @foreach (var k in Model.DaftarKelasSiswa)
                {
                    string cardGradient = getCategoryGradient(k.Kategori);
                    string catIcon = getCategoryIcon(k.Kategori);

                    <div class="col-md-6">
                        <div class="classroom-card h-100 d-flex flex-column">
                            <!-- 1. Header Banner Tematik -->
                            <div class="classroom-banner" style="background: @cardGradient;">
                                <!-- Pola Abstrak Vektor Samar di Latar Belakang -->
                                <svg class="classroom-banner-svg" viewBox="0 0 200 130" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M0,0 C60,40 80,10 140,50 C180,75 190,110 200,130 L200,0 Z" fill="#FFFFFF"></path>
                                    <circle cx="170" cy="30" r="25" fill="#FFFFFF"></circle>
                                    <circle cx="130" cy="90" r="15" fill="#FFFFFF"></circle>
                                </svg>

                                <!-- Watermark Ikon Tematik Samar -->
                                <div class="classroom-watermark">
                                    <i class="@catIcon" style="font-size: 6.8rem; line-height: 1;"></i>
                                </div>

                                <!-- Gambar Cover Thumbnail Jika Ada -->
                                @if (!string.IsNullOrEmpty(k.ThumbnailUrl))
                                {
                                    <img src="@k.ThumbnailUrl" alt="" class="w-100 h-100 object-fit-cover position-absolute top-0 start-0" style="z-index: 1;" onerror="this.remove();" />
                                }

                                <!-- Badge Kategori Kaca (Kiri Atas) & Badge Kode Kelas (Kanan Atas) -->
                                <div class="position-absolute top-0 start-0 end-0 p-3 d-flex justify-content-between align-items-center" style="z-index: 3;">
                                    <span class="glass-category-badge" title="@k.Kategori">
                                        <i class="@catIcon me-1"></i> @k.Kategori
                                    </span>
                                    <span class="glass-code-badge" title="Kode Kelas">
                                        <i class="ti ti-key me-1 text-muted"></i>@k.KodeKelas
                                    </span>
                                </div>

                                <!-- 2. Avatar Pengajar Melayang (Floating Overlap di Sudut Kanan) -->
                                <div class="floating-instructor-avatar" title="@k.NamaGuru">
                                    @if (!string.IsNullOrEmpty(k.FotoGuru))
                                    {
                                        <img src="@k.FotoGuru" alt="@k.NamaGuru" onerror="this.remove();" />
                                    }
                                    else
                                    {
                                        <div class="floating-instructor-avatar-fallback">
                                            @(!string.IsNullOrEmpty(k.NamaGuru) ? k.NamaGuru.Substring(0, 1).ToUpper() : "G")
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- 3. Bodi Kartu -->
                            <div class="classroom-body d-flex flex-column flex-fill">
                                <!-- Judul Kelas -->
                                <h4 class="classroom-title" title="@k.NamaKelas">
                                    @k.NamaKelas
                                </h4>

                                <!-- Nama Instruktur -->
                                <div class="classroom-teacher">
                                    <i class="ti ti-user-check text-muted" style="font-size: 0.9rem;"></i>
                                    <span>@(string.IsNullOrEmpty(k.NamaGuru) ? "Pengajar Terdaftar" : k.NamaGuru)</span>
                                </div>

                                <!-- Baris Progres Belajar Ramping & Persentase Rapi -->
                                <div class="mt-auto">
                                    <div class="d-flex align-items-center justify-content-between mb-1.5">
                                        <span class="extra-small fw-semibold text-secondary">
                                            <i class="ti ti-chart-pie me-1 text-primary"></i>Progres Belajar
                                        </span>
                                        <span class="extra-small fw-bold text-primary font-monospace">
                                            @k.PersentaseProgresBelajar.ToString("0")%
                                        </span>
                                    </div>
                                    <div class="progress rounded-pill mb-3" style="height: 6px; background-color: #F1F5F9;">
                                        <div class="progress-bar rounded-pill" 
                                             role="progressbar" 
                                             style="width: @k.PersentaseProgresBelajar.ToString("0")%; background: linear-gradient(90deg, #2563EB 0%, #60A5FA 100%);" 
                                             aria-valuenow="@k.PersentaseProgresBelajar" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100"></div>
                                    </div>

                                    <!-- Tombol Masuk Ruang Kelas Pill Modern -->
                                    <a href="@Url.Action("RuangKelas", "Siswa", new { id = k.KelasId })" class="btn-enter-class">
                                        <span>Masuk Ruang Kelas</span>
                                        <i class="ti ti-arrow-right fs-3"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Tampilan Kosong (Empty State) Elegan -->
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <div class="empty">
                    <div class="empty-icon mb-3">
                        <span class="avatar avatar-xl rounded-circle p-3 text-white shadow-sm" style="background: linear-gradient(135deg, #2563EB, #60A5FA);">
                            <i class="ti ti-school-off fs-1"></i>
                        </span>
                    </div>
                    <h4 class="empty-title fw-bold text-dark fs-3 mb-1">Belum Terdaftar di Kelas Apapun</h4>
                    <p class="empty-subtitle text-secondary small mx-auto mb-4" style="max-width: 420px;">
                        Anda belum mengikuti ruang belajar. Masukkan kode token kelas dari guru Anda untuk mulai mengakses kurikulum dan tugas.
                    </p>
                    <div class="empty-action">
                        <button type="button" class="btn btn-join-class-pill px-4" data-bs-toggle="modal" data-bs-target="#modal-gabung-kelas">
                            <i class="ti ti-plus fs-2"></i> Gabung Kelas Sekarang
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Kolom Kanan (4 Kolom): Kalender Akademik & Agenda Deadline -->
    <div class="col-lg-4">
        <!-- 1. WIDGET KALENDER AKADEMIK -->
        <div class="academic-calendar-card mb-4">
            <div class="cal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs rounded-circle bg-blue-subtle text-primary">
                        <i class="ti ti-calendar" style="font-size: 0.9rem;"></i>
                    </span>
                    <span class="cal-title" id="cal-month-year">Kalender Akademik</span>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="cal-nav-btn" id="cal-prev" title="Bulan Sebelumnya">
                        <i class="ti ti-chevron-left"></i>
                    </button>
                    <button type="button" class="cal-nav-btn" id="cal-next" title="Bulan Berikutnya">
                        <i class="ti ti-chevron-right"></i>
                    </button>
                </div>
            </div>

            <!-- Hari-hari dalam Seminggu -->
            <div class="cal-weekdays">
                <span>Min</span>
                <span>Sen</span>
                <span>Sel</span>
                <span>Rab</span>
                <span>Kam</span>
                <span>Jum</span>
                <span>Sab</span>
            </div>

            <!-- Grid Tanggal -->
            <div class="cal-days-grid" id="cal-grid">
                <!-- Diisi secara dinamis lewat script kalender -->
            </div>

            <div class="d-flex align-items-center justify-content-between mt-3 pt-2 border-top extra-small text-muted">
                <span class="d-flex align-items-center gap-1.5">
                    <span style="display:inline-block; width:10px; height:10px; border-radius:3px; background:#2563EB;"></span> Hari Ini
                </span>
                <span class="d-flex align-items-center gap-1.5">
                    <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#F59E0B;"></span> Ada Agenda/Tugas
                </span>
            </div>
        </div>

        <!-- 2. WIDGET AGENDA PENUGASAN & UJIAN -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2" style="font-size: 1.05rem;">
                <i class="ti ti-clock-play text-warning"></i> Agenda Deadline
            </h4>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white" style="border: 1px solid #E2E8F0 !important;">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h5 class="card-title fw-bold text-dark mb-0" style="font-size: 0.9rem;">Agenda Penugasan &amp; Ujian</h5>
                <span class="badge bg-light text-secondary border font-monospace extra-small rounded-pill">
                    @(Model.DaftarDeadlineMendekat != null ? Model.DaftarDeadlineMendekat.Count : 0) Item
                </span>
            </div>

            @if (Model.DaftarDeadlineMendekat != null && Model.DaftarDeadlineMendekat.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var d in Model.DaftarDeadlineMendekat)
                    {
                        <div class="list-group-item p-3 border-bottom">
                            <div class="d-flex align-items-start gap-2.5">
                                <span class="avatar avatar-sm rounded-3 @(d.ItemType == "Tugas" ? "bg-warning-subtle text-warning-emphasis" : "bg-purple-subtle text-purple") mt-0.5" style="@(d.ItemType == "Quiz" ? "color: #7C3AED !important;" : "")">
                                    <i class="ti @(d.ItemType == "Tugas" ? "ti-clipboard-text" : "ti-help-hexagon") fs-3"></i>
                                </span>
                                <div class="flex-fill">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="badge @(d.ItemType == "Tugas" ? "bg-warning-subtle text-warning-emphasis" : "bg-purple-subtle text-purple") rounded-pill font-monospace" style="@(d.ItemType == "Quiz" ? "color: #7C3AED !important;" : ""); font-size: 0.68rem;">
                                            @d.ItemType.ToUpper()
                                        </span>
                                        <span class="badge @(d.IsOverdue ? "bg-danger-subtle text-danger" : "bg-light text-dark border") font-monospace" style="font-size: 0.675rem;">
                                            @d.TimeRemainingFormatted
                                        </span>
                                    </div>
                                    <h5 class="fw-bold text-dark mb-1 fs-4" style="line-height: 1.35;">@d.Judul</h5>
                                    <div class="text-muted extra-small">
                                        <i class="ti ti-building-community me-1"></i>@d.NamaKelas
                                    </div>
                                    @if (d.Deadline.HasValue)
                                    {
                                        <div class="text-muted extra-small mt-1">
                                            <i class="ti ti-calendar-due me-1 text-primary"></i>Batas: <strong>@d.Deadline.Value.ToString("dd MMM yyyy HH:mm") WIB</strong>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State Deadline yang Elegan -->
                <div class="py-5 px-3 text-center">
                    <div class="mb-3">
                        <span class="avatar avatar-lg rounded-circle bg-success-subtle text-success shadow-none">
                            <i class="ti ti-circle-check fs-1"></i>
                        </span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Tidak Ada Deadline</h5>
                    <p class="text-muted extra-small mb-0 mx-auto" style="max-width: 240px;">
                        Semua tugas dan kuis telah dikerjakan tepat waktu!
                    </p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ==========================================================================
     SCRIPT ENGINE KALENDER AKADEMIK INTERAKTIF
     ========================================================================== -->
<script>
    (function () {
        const eventsData = @Html.Raw(string.IsNullOrEmpty(eventDatesJson) ? "[]" : eventDatesJson);

        // Simpan tanggal-tanggal yang memiliki agenda ke dalam Set untuk pencarian cepat (YYYY-MM-DD)
        const eventDatesSet = new Set(eventsData.map(e => e.date));

        const monthNames = [
            "Januari", "Februari", "Maret", "April", "Mei", "Juni",
            "Juli", "Agustus", "September", "Oktober", "November", "Desember"
        ];

        let currentDate = new Date();
        let displayMonth = currentDate.getMonth();
        let displayYear = currentDate.getFullYear();

        const monthYearEl = document.getElementById("cal-month-year");
        const gridEl = document.getElementById("cal-grid");
        const prevBtn = document.getElementById("cal-prev");
        const nextBtn = document.getElementById("cal-next");

        function padZero(num) {
            return num < 10 ? '0' + num : '' + num;
        }

        function renderCalendar(year, month) {
            if (!monthYearEl || !gridEl) return;

            monthYearEl.textContent = `${monthNames[month]} ${year}`;
            gridEl.innerHTML = '';

            const today = new Date();
            const isCurrentMonthReal = (today.getFullYear() === year && today.getMonth() === month);
            const realTodayDate = today.getDate();

            // Hari pertama bulan ini (0 = Minggu, 1 = Senin, ...)
            const firstDayIndex = new Date(year, month, 1).getDay();
            // Jumlah hari di bulan ini
            const lastDayDate = new Date(year, month + 1, 0).getDate();
            // Jumlah hari di bulan sebelumnya
            const prevMonthLastDate = new Date(year, month, 0).getDate();

            // Render sisa hari bulan lalu
            for (let i = firstDayIndex; i > 0; i--) {
                const cell = document.createElement("div");
                cell.className = "cal-day-cell other-month";
                cell.textContent = (prevMonthLastDate - i + 1);
                gridEl.appendChild(cell);
            }

            // Render hari bulan ini
            for (let day = 1; day <= lastDayDate; day++) {
                const cell = document.createElement("div");
                cell.className = "cal-day-cell";

                const dateStr = `${year}-${padZero(month + 1)}-${padZero(day)}`;

                // Cek apakah hari ini
                if (isCurrentMonthReal && day === realTodayDate) {
                    cell.classList.add("today");
                }

                // Angka tanggal
                const numSpan = document.createElement("span");
                numSpan.textContent = day;
                cell.appendChild(numSpan);

                // Cek apakah ada agenda di tanggal ini
                if (eventDatesSet.has(dateStr)) {
                    const dot = document.createElement("span");
                    dot.className = "cal-day-dot";
                    cell.appendChild(dot);
                    
                    // Tooltip item
                    const items = eventsData.filter(e => e.date === dateStr);
                    if (items.length > 0) {
                        cell.title = items.map(it => `[${it.type}] ${it.title} (${it.kelas})`).join("\n");
                    }
                }

                gridEl.appendChild(cell);
            }

            // Render awal hari bulan berikutnya agar kelipatan 7 pas
            const totalRendered = firstDayIndex + lastDayDate;
            const remainingCells = (7 - (totalRendered % 7)) % 7;
            for (let j = 1; j <= remainingCells; j++) {
                const cell = document.createElement("div");
                cell.className = "cal-day-cell other-month";
                cell.textContent = j;
                gridEl.appendChild(cell);
            }
        }

        if (prevBtn) {
            prevBtn.addEventListener("click", function () {
                displayMonth--;
                if (displayMonth < 0) {
                    displayMonth = 11;
                    displayYear--;
                }
                renderCalendar(displayYear, displayMonth);
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener("click", function () {
                displayMonth++;
                if (displayMonth > 11) {
                    displayMonth = 0;
                    displayYear++;
                }
                renderCalendar(displayYear, displayMonth);
            });
        }

        // Inisialisasi tampilan pertama
        renderCalendar(displayYear, displayMonth);
    })();
</script>
