@model Learning_Management_System.Models.ViewModel.SiswaDashboardViewModel
@{
    Layout = "~/Views/Shared/_LayoutSiswa.cshtml";
    ViewBag.Title = "Dashboard Siswa";
    string namaSiswa = Session["NamaLengkap"] != null ? Session["NamaLengkap"].ToString() : "Siswa LMS";

    // Helper Gradient Tematik Segar Berdasarkan Kategori Kelas (Modern Vibrant Classroom)
    Func<string, string> getCategoryGradient = (cat) =>
    {
        if (string.IsNullOrEmpty(cat)) return "linear-gradient(135deg, #0F172A 0%, #2563EB 100%)";
        string c = cat.ToLower();
        if (c.Contains("pemrograman") || c.Contains("software") || c.Contains("it") || c.Contains("web"))
            return "linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%)"; // Biru Teknologi
        if (c.Contains("desain") || c.Contains("ui/ux") || c.Contains("grafis") || c.Contains("multimedia"))
            return "linear-gradient(135deg, #701A75 0%, #EC4899 100%)"; // Ungu-Pink UI/UX & Desain
        if (c.Contains("bisnis") || c.Contains("manajemen") || c.Contains("marketing") || c.Contains("digital") || c.Contains("ekonomi"))
            return "linear-gradient(135deg, #047857 0%, #10B981 100%)"; // Zamrud/Hijau Bisnis & Manajemen
        if (c.Contains("cyber") || c.Contains("jaringan") || c.Contains("security"))
            return "linear-gradient(135deg, #0F766E 0%, #14B8A6 100%)";
        if (c.Contains("data") || c.Contains("intelligence") || c.Contains("ai"))
            return "linear-gradient(135deg, #4338CA 0%, #818CF8 100%)";
        return "linear-gradient(135deg, #0F172A 0%, #2563EB 100%)";
    };

    // Helper Icon Dekoratif Berdasarkan Kategori
    Func<string, string> getCategoryIcon = (cat) =>
    {
        if (string.IsNullOrEmpty(cat)) return "ti ti-school";
        string c = cat.ToLower();
        if (c.Contains("pemrograman") || c.Contains("software") || c.Contains("it") || c.Contains("web")) return "ti ti-code";
        if (c.Contains("cyber") || c.Contains("jaringan") || c.Contains("security")) return "ti ti-shield-lock";
        if (c.Contains("desain") || c.Contains("ui/ux") || c.Contains("grafis") || c.Contains("multimedia")) return "ti ti-palette";
        if (c.Contains("data") || c.Contains("intelligence") || c.Contains("ai")) return "ti ti-brain";
        if (c.Contains("bisnis") || c.Contains("manajemen") || c.Contains("marketing") || c.Contains("digital") || c.Contains("ekonomi")) return "ti ti-chart-line";
        return "ti ti-school";
    };

    // JSON event dates untuk kalender akademik
    var eventDatesJson = Newtonsoft.Json.JsonConvert.SerializeObject(
        (Model.DaftarDeadlineMendekat ?? new List<Learning_Management_System.Models.ViewModel.DeadlineItemDto>())
            .Where(d => d.Deadline.HasValue)
            .Select(d => new {
                date = d.Deadline.Value.ToString("yyyy-MM-dd"),
                title = d.Judul,
                type = d.ItemType,
                kelas = d.NamaKelas
            })
            .ToList()
    );

    // Kalkulasi Diagram Radial Progres Rata-Rata Nilai
    double gradeVal = (double)Model.RataRataNilaiKeseluruhan;
    double gradePct = gradeVal > 0 ? Math.Min(100.0, gradeVal) : 91.2;
    string gradeDashOffset = (131.95 * (1.0 - (gradePct / 100.0))).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
}

<style>
    /* ==========================================================================
       DASHBOARD SISWA MODERN & ESTETIK
       ========================================================================== */

    /* Tipografi Sambutan */
    .welcome-heading {
        font-size: 1.85rem !important;
        font-weight: 800 !important;
        background: linear-gradient(135deg, #0F172A 30%, #2563EB 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.025em;
        line-height: 1.25;
    }
    .welcome-subtext {
        color: #64748B !important;
        font-size: 0.92rem;
        font-weight: 450;
    }
    .learning-cap-icon {
        display: inline-block;
        -webkit-text-fill-color: initial;
        font-size: 1.85rem;
        cursor: default;
        transition: transform 0.25s ease;
        line-height: 1;
    }
    .learning-cap-icon:hover {
        transform: scale(1.18) rotate(-8deg);
    }

    /* Tombol Gabung Kelas Royal Blue Pill */
    .btn-join-class-pill {
        background-color: #2563EB !important;
        border: none !important;
        border-radius: 50px !important;
        color: #FFFFFF !important;
        font-weight: 700 !important;
        font-size: 0.88rem !important;
        padding: 0.65rem 1.4rem !important;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.28) !important;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
    }
    .btn-join-class-pill:hover {
        background-color: #1D4ED8 !important;
        color: #FFFFFF !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.38) !important;
    }
    .btn-join-class-pill:active {
        transform: translateY(0);
    }

    /* Kartu Metrik Ringkasan (Soft Blue Glass & Squircle Modern) */
    .dashboard-stat-card {
        border-radius: 20px !important;
        background: linear-gradient(135deg, #FFFFFF 0%, #F0F7FF 100%) !important;
        border: 1px solid #D6E8FA !important;
        padding: 1.35rem 1.25rem !important;
        min-height: 150px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.07) !important;
        transform: translateY(0);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    .dashboard-stat-card:hover {
        transform: translateY(-4px) !important;
        border-color: #BFDBFE !important;
        box-shadow: 0 14px 28px rgba(37, 99, 235, 0.12) !important;
    }

    .stat-card-label {
        color: #64748B !important;
        font-size: 0.78rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.04em !important;
        text-transform: uppercase !important;
        display: block;
    }
    .stat-card-value {
        font-size: 1.9rem !important;
        font-weight: 800 !important;
        color: #1E3A8A !important;
        line-height: 1.1 !important;
    }
    .stat-card-badge {
        background: #E0F2FE !important;
        color: #0369A1 !important;
        font-weight: 600 !important;
        border-radius: 12px !important;
        padding: 3px 10px !important;
        font-size: 0.75rem !important;
        border: none !important;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        width: fit-content;
    }

    /* Diagram Lingkaran Progres Radial (Donut SVG) */
    .stat-radial-wrap {
        width: 52px;
        height: 52px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .stat-radial-svg {
        width: 52px;
        height: 52px;
        transform: rotate(-90deg);
        filter: drop-shadow(0 2px 4px rgba(37, 99, 235, 0.1));
    }
    .stat-radial-icon {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        pointer-events: none;
    }

    /* Kartu Kelas Google Classroom Modern */
    .classroom-card {
        border-radius: 20px !important;
        overflow: hidden !important;
        background: #FFFFFF !important;
        border: 1px solid #E2E8F0 !important;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03) !important;
        position: relative;
    }
    .classroom-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08) !important;
        border-color: #CBD5E1 !important;
    }

    /* Banner Tematik */
    .classroom-banner {
        height: 135px;
        position: relative;
        overflow: hidden;
    }
    .classroom-banner-svg {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        opacity: 0.15;
        pointer-events: none;
        user-select: none;
    }
    .classroom-watermark {
        position: absolute;
        right: 10px;
        bottom: -15px;
        color: #FFFFFF;
        opacity: 0.22;
        pointer-events: none;
        user-select: none;
        transition: transform 0.35s ease;
    }
    .classroom-card:hover .classroom-watermark {
        transform: scale(1.1) rotate(-6deg);
        opacity: 0.3;
    }

    /* Glassmorphism Badges */
    .glass-category-badge {
        background: rgba(255, 255, 255, 0.22) !important;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.35) !important;
        color: #FFFFFF !important;
        font-size: 0.72rem !important;
        padding: 4px 12px !important;
        border-radius: 50px !important;
        font-weight: 600 !important;
        letter-spacing: 0.3px;
        max-width: 65%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: inline-flex;
        align-items: center;
    }
    .glass-code-badge {
        background: rgba(255, 255, 255, 0.92) !important;
        backdrop-filter: blur(8px);
        color: #0F172A !important;
        font-family: 'SFMono-Regular', Menlo, Monaco, Consolas, monospace !important;
        font-size: 0.72rem !important;
        font-weight: 700 !important;
        padding: 4px 11px !important;
        border-radius: 50px !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
        letter-spacing: 0.5px;
    }

    /* Avatar Instruktur */
    .floating-instructor-avatar {
        position: absolute;
        right: 16px;
        bottom: 12px;
        width: 48px;
        height: 48px;
        border-radius: 50% !important;
        border: 3px solid #FFFFFF !important;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.22) !important;
        z-index: 10;
        object-fit: cover;
        background: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.25s ease;
    }
    .classroom-card:hover .floating-instructor-avatar {
        transform: scale(1.08);
    }
    .floating-instructor-avatar img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }
    .floating-instructor-avatar-fallback {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: linear-gradient(135deg, #0F172A, #2563EB);
        color: #FFFFFF;
        font-weight: 700;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Bodi Kartu Kelas */
    .classroom-body {
        padding: 1.15rem 1.25rem 1.15rem !important;
    }
    .classroom-title {
        color: #0F172A !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
        line-height: 1.4 !important;
        margin-bottom: 0.35rem !important;
        min-height: 2.8rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .classroom-teacher {
        color: #64748B !important;
        font-size: 0.82rem !important;
        margin-bottom: 1.15rem !important;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Tombol Masuk Ruang Kelas Modern Pill */
    .btn-enter-class {
        background-color: #F8FAFC !important;
        color: #334155 !important;
        font-weight: 700 !important;
        font-size: 0.85rem !important;
        border: 1px solid #E2E8F0 !important;
        border-radius: 50px !important;
        padding: 0.58rem 1rem !important;
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        text-decoration: none !important;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }
    .btn-enter-class:hover {
        background-color: #2563EB !important;
        color: #FFFFFF !important;
        border-color: #2563EB !important;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25) !important;
        transform: translateY(-1px);
    }

    /* ==========================================================================
       WIDGET KALENDER AKADEMIK
       ========================================================================== */
    .academic-calendar-card {
        border-radius: 20px !important;
        border: 1px solid #E2E8F0 !important;
        background: #FFFFFF !important;
        padding: 1.25rem !important;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03) !important;
    }
    .cal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }
    .cal-title {
        font-weight: 700;
        font-size: 0.95rem;
        color: #0F172A;
    }
    .cal-nav-btn {
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 1px solid #E2E8F0;
        background: #FFFFFF;
        color: #475569;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .cal-nav-btn:hover {
        background: #F1F5F9;
        color: #0F172A;
        border-color: #CBD5E1;
    }
    .cal-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
        font-size: 0.72rem;
        font-weight: 700;
        color: #94A3B8;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .cal-days-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
        text-align: center;
    }
    .cal-day-cell {
        aspect-ratio: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 0.82rem;
        font-weight: 500;
        color: #334155;
        border-radius: 10px;
        cursor: pointer;
        position: relative;
        transition: all 0.2s ease;
        padding: 2px 0;
    }
    .cal-day-cell:hover:not(.empty-day) {
        background: #F1F5F9;
    }
    .cal-day-cell.other-month {
        color: #CBD5E1;
        opacity: 0.6;
    }
    /* Highlight Hari Ini */
    .cal-day-cell.today {
        background: #2563EB !important;
        color: #FFFFFF !important;
        font-weight: 700 !important;
        border-radius: 12px !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3) !important;
    }
    /* Dot Aksen Tugas/Kegiatan */
    .cal-day-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #F59E0B;
        margin-top: 2px;
    }
    .cal-day-cell.today .cal-day-dot {
        background: #FFFFFF !important;
    }

    /* Modal Styling */
    .modal-join-card {
        border-radius: 20px !important;
        border: none !important;
        overflow: hidden !important;
        box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25) !important;
    }
    .token-input {
        text-align: center !important;
        text-transform: uppercase !important;
        font-weight: 800 !important;
        letter-spacing: 3px !important;
        font-size: 1.4rem !important;
        border-radius: 14px !important;
        border: 2px solid #E2E8F0 !important;
        padding: 0.85rem 1rem !important;
        color: #0F172A !important;
        background: #F8FAFC !important;
        transition: all 0.2s ease;
    }
    .token-input:focus {
        border-color: #2563EB !important;
        background: #FFFFFF !important;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15) !important;
        outline: none !important;
    }
    .token-input::placeholder {
        color: #94A3B8 !important;
        letter-spacing: 2px !important;
        font-weight: 600 !important;
    }
</style>

<!-- ==========================================================================
     AREA SAMBUTAN (WELCOME SECTION) & TOMBOL GABUNG KELAS
     ========================================================================== -->
<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="welcome-heading mb-1 d-flex align-items-center flex-wrap gap-2">
            <span>Selamat Datang, @namaSiswa!</span>
            <span class="learning-cap-icon" title="Akademik & Pembelajaran">&#127891;</span>
        </h1>
        <div class="welcome-subtext">
            Pantau progres belajar, akses materi &amp; tugas kelas, serta jadilah siswa yang berprestasi hari ini.
        </div>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0 d-print-none">
        <button type="button" class="btn btn-join-class-pill" data-bs-toggle="modal" data-bs-target="#modal-gabung-kelas">
            <i class="ti ti-plus fs-2"></i>
            <span>Gabung Kelas Baru</span>
        </button>
    </div>
</div>

<!-- ==========================================================================
     MODAL GABUNG KELAS BARU DENGAN TOKEN KELAS
     ========================================================================== -->
<div class="modal modal-blur fade" id="modal-gabung-kelas" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 440px;">
        <div class="modal-content modal-join-card">
            @using (Html.BeginForm("GabungKelas", "Siswa", FormMethod.Post, new { id = "form-gabung-kelas" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header bg-white py-3 px-4 border-bottom">
                    <div class="d-flex align-items-center gap-2.5">
                        <span class="avatar avatar-sm rounded-3 text-white shadow-sm" style="background: #2563EB;">
                            <i class="ti ti-key fs-2"></i>
                        </span>
                        <div>
                            <h4 class="modal-title fw-bold text-dark m-0" style="font-size: 1.05rem;">Gabung Kelas Pembelajaran</h4>
                            <div class="text-muted extra-small">Koneksikan akun ke ruang belajar instruktur</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark mb-2 text-start d-block" style="font-size: 0.85rem;">
                            Kode Akses / Token Kelas <span class="text-danger">*</span>
                        </label>
                        <input type="text" 
                               name="KodeKelas" 
                               class="form-control token-input" 
                               placeholder="KLS-XXX" 
                               required 
                               autocomplete="off" 
                               maxlength="20" />
                    </div>
                    <p class="text-muted small mb-0" style="font-size: 0.82rem; line-height: 1.45;">
                        <i class="ti ti-info-circle text-primary me-1"></i>
                        Masukkan kode token unik kelas yang Anda peroleh dari instruktur untuk langsung masuk ke materi dan penugasan.
                    </p>
                </div>
                <div class="modal-footer bg-light py-3 px-4 d-flex justify-content-end gap-2 border-top">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" data-bs-dismiss="modal" style="font-size: 0.85rem;">
                        Batal
                    </button>
                    <button type="submit" class="btn text-white rounded-pill px-4 fw-bold shadow-sm" style="background: #2563EB; border: none; font-size: 0.85rem;">
                        <i class="ti ti-check me-1.5"></i> Verifikasi &amp; Gabung
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- ==========================================================================
     BARIS 1: 4 KARTU STATISTIK RINGKASAN MODERN
     ========================================================================== -->
<div class="row g-3 mb-4">
    <!-- Card 1: Kelas Diikuti -->
    <div class="col-6 col-md-3">
        <div class="card dashboard-stat-card h-100">
            <div class="d-flex align-items-start justify-content-between mb-2">
                <div>
                    <span class="stat-card-label">Kelas Diikuti</span>
                    <div class="stat-card-value">@Model.TotalKelasDiikuti</div>
                </div>
                <div class="stat-radial-wrap" title="@Model.TotalKelasDiikuti Kelas Aktif">
                    <svg class="stat-radial-svg" viewBox="0 0 52 52">
                        <circle cx="26" cy="26" r="21" fill="none" stroke="#DBEAFE" stroke-width="4.5" />
                        <circle cx="26" cy="26" r="21" fill="none" stroke="#3B82F6" stroke-width="4.5" 
                                stroke-dasharray="131.95" stroke-dashoffset="33" stroke-linecap="round" />
                    </svg>
                    <div class="stat-radial-icon" style="color: #2563EB;">
                        <i class="ti ti-school"></i>
                    </div>
                </div>
            </div>
            <div>
                <span class="stat-card-badge">
                    <i class="ti ti-circle-check"></i> Kelas Aktif
                </span>
            </div>
        </div>
    </div>

    <!-- Card 2: Tugas Belum Selesai -->
    <div class="col-6 col-md-3">
        <div class="card dashboard-stat-card h-100">
            <div class="d-flex align-items-start justify-content-between mb-2">
                <div>
                    <span class="stat-card-label">Tugas Belum Selesai</span>
                    <div class="stat-card-value">@Model.TotalTugasPending</div>
                </div>
                <div class="stat-radial-wrap" title="@(Model.TotalTugasPending == 0 ? "Semua tugas tuntas" : Model.TotalTugasPending + " tugas pending")">
                    <svg class="stat-radial-svg" viewBox="0 0 52 52">
                        <defs>
                            <linearGradient id="cardDonutGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#38BDF8" />
                                <stop offset="100%" stop-color="#60A5FA" />
                            </linearGradient>
                        </defs>
                        <circle cx="26" cy="26" r="21" fill="none" stroke="#E0F2FE" stroke-width="4.5" />
                        <circle cx="26" cy="26" r="21" fill="none" stroke="url(#cardDonutGrad2)" stroke-width="4.5" 
                                stroke-dasharray="131.95" stroke-dashoffset="@(Model.TotalTugasPending > 0 ? "45" : "0")" stroke-linecap="round" />
                    </svg>
                    <div class="stat-radial-icon" style="color: #0284C7;">
                        <i class="ti @(Model.TotalTugasPending > 0 ? "ti-clock-hour-4" : "ti-check")"></i>
                    </div>
                </div>
            </div>
            <div>
                <span class="stat-card-badge">
                    <i class="ti @(Model.TotalTugasPending > 0 ? "ti-alert-circle" : "ti-circle-check")"></i>
                    @(Model.TotalTugasPending > 0 ? "Perlu Dikumpulkan" : "Semua Tuntas")
                </span>
            </div>
        </div>
    </div>

    <!-- Card 3: Kuis Tersedia -->
    <div class="col-6 col-md-3">
        <div class="card dashboard-stat-card h-100">
            <div class="d-flex align-items-start justify-content-between mb-2">
                <div>
                    <span class="stat-card-label">Kuis Tersedia</span>
                    <div class="stat-card-value">@Model.TotalKuisTersedia</div>
                </div>
                <div class="stat-radial-wrap" title="@Model.TotalKuisTersedia Kuis Tersedia">
                    <svg class="stat-radial-svg" viewBox="0 0 52 52">
                        <defs>
                            <linearGradient id="cardDonutGrad3" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#93C5FD" />
                                <stop offset="100%" stop-color="#3B82F6" />
                            </linearGradient>
                        </defs>
                        <circle cx="26" cy="26" r="21" fill="none" stroke="#DBEAFE" stroke-width="4.5" />
                        <circle cx="26" cy="26" r="21" fill="none" stroke="url(#cardDonutGrad3)" stroke-width="4.5" 
                                stroke-dasharray="131.95" stroke-dashoffset="42" stroke-linecap="round" />
                    </svg>
                    <div class="stat-radial-icon" style="color: #2563EB;">
                        <i class="ti ti-help-hexagon"></i>
                    </div>
                </div>
            </div>
            <div>
                <span class="stat-card-badge">
                    <i class="ti ti-player-play"></i> Siap Dikerjakan
                </span>
            </div>
        </div>
    </div>

    <!-- Card 4: Rata-rata Nilai -->
    <div class="col-6 col-md-3">
        <div class="card dashboard-stat-card h-100">
            <div class="d-flex align-items-start justify-content-between mb-2">
                <div>
                    <span class="stat-card-label">Rata-Rata Nilai</span>
                    <div class="stat-card-value">@Model.RataRataNilaiKeseluruhan.ToString("0.0")</div>
                </div>
                <div class="stat-radial-wrap" title="Indeks Prestasi: @Model.RataRataNilaiKeseluruhan.ToString("0.0")">
                    <svg class="stat-radial-svg" viewBox="0 0 52 52">
                        <defs>
                            <linearGradient id="cardDonutGrad4" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#2563EB" />
                                <stop offset="100%" stop-color="#60A5FA" />
                            </linearGradient>
                        </defs>
                        <circle cx="26" cy="26" r="21" fill="none" stroke="#DBEAFE" stroke-width="4.5" />
                        <circle cx="26" cy="26" r="21" fill="none" stroke="url(#cardDonutGrad4)" stroke-width="4.5" 
                                stroke-dasharray="131.95" stroke-dashoffset="@gradeDashOffset" stroke-linecap="round" />
                    </svg>
                    <div class="stat-radial-icon" style="color: #2563EB;">
                        <i class="ti ti-award"></i>
                    </div>
