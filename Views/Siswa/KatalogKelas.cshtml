@model Learning_Management_System.Models.ViewModel.SiswaKatalogKelasViewModel
@{
    Layout = "~/Views/Shared/_LayoutSiswa.cshtml";
    ViewBag.Title = "Katalog & Cari Kelas";

    // Helper Gradient Dinamis Sesuai Kategori Kelas
    Func<string, string> getCategoryGradient = (cat) =>
    {
        if (string.IsNullOrEmpty(cat)) return "linear-gradient(135deg, #395886 0%, #638ECB 100%)";
        string c = cat.ToLower();
        if (c.Contains("pemrograman") || c.Contains("software")) return "linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%)";
        if (c.Contains("cyber") || c.Contains("jaringan") || c.Contains("security")) return "linear-gradient(135deg, #064e3b 0%, #10b981 100%)";
        if (c.Contains("desain") || c.Contains("ui/ux") || c.Contains("grafis")) return "linear-gradient(135deg, #701a75 0%, #ec4899 100%)";
        if (c.Contains("data") || c.Contains("intelligence") || c.Contains("ai")) return "linear-gradient(135deg, #312e81 0%, #8b5cf6 100%)";
        if (c.Contains("bisnis") || c.Contains("marketing") || c.Contains("digital")) return "linear-gradient(135deg, #7c2d12 0%, #f59e0b 100%)";
        return "linear-gradient(135deg, #395886 0%, #638ECB 100%)";
    };

    // Helper Icon Dekoratif Sesuai Kategori
    Func<string, string> getCategoryIcon = (cat) =>
    {
        if (string.IsNullOrEmpty(cat)) return "ti ti-books";
        string c = cat.ToLower();
        if (c.Contains("pemrograman") || c.Contains("software")) return "ti ti-code";
        if (c.Contains("cyber") || c.Contains("jaringan") || c.Contains("security")) return "ti ti-shield-lock";
        if (c.Contains("desain") || c.Contains("ui/ux") || c.Contains("grafis")) return "ti ti-palette";
        if (c.Contains("data") || c.Contains("intelligence") || c.Contains("ai")) return "ti ti-brain";
        if (c.Contains("bisnis") || c.Contains("marketing") || c.Contains("digital")) return "ti ti-chart-line";
        return "ti ti-school";
    };
}

<style>
    .katalog-card {
        border: 1px solid #e2e8f0 !important;
        border-radius: 16px !important;
        background: #ffffff;
        transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
        overflow: hidden;
    }
    .katalog-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 28px -8px rgba(57, 88, 134, 0.16) !important;
        border-color: #b1c9ef !important;
    }
    .card-banner-wrapper {
        height: 145px;
        position: relative;
        overflow: hidden;
    }
    .category-glass-badge {
        background: rgba(15, 23, 42, 0.68);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: #ffffff !important;
        font-size: 0.72rem;
        padding: 5px 12px;
        border-radius: 50px;
        font-weight: 600;
        letter-spacing: 0.2px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        max-width: 65%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .watermark-bg-icon {
        position: absolute;
        right: -10px;
        bottom: -15px;
        color: #ffffff;
        opacity: 0.16;
        pointer-events: none;
        user-select: none;
        transition: transform 0.3s ease;
    }
    .katalog-card:hover .watermark-bg-icon {
        transform: scale(1.08) rotate(-4deg);
        opacity: 0.22;
    }
</style>

<!-- Breadcrumb Navigasi -->
<div class="mb-3">
    <ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Dashboard", "Siswa")" class="text-secondary">
                <i class="ti ti-dashboard me-1"></i>Siswa
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            <a href="#" class="fw-semibold text-dark">Katalog &amp; Cari Kelas</a>
        </li>
    </ol>
</div>

<!-- Page Header Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge text-white rounded-pill px-3 py-1 font-monospace" style="background-color: #395886;">
                        <i class="ti ti-books me-1"></i>Katalog Pelatihan PUB Hub
                    </span>
                    <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 font-monospace">
                        @Model.TotalKelasTersedia Kelas Tersedia
                    </span>
                </div>
                <h1 class="fw-extrabold text-dark display-6 mb-1">Katalog &amp; Eksplorasi Kelas</h1>
                <p class="text-muted small mb-0">
                    Jelajahi seluruh kurikulum kompetensi yang tersedia. Masukkan kode akses kelas untuk langsung bergabung ke materi belajar.
                </p>
            </div>
            <div class="col-lg-5 text-lg-end">
                <!-- Form Gabung Kelas Cepat dengan Kode -->
                <div class="card bg-light border-0 rounded-3 p-3 shadow-none text-start d-inline-block w-100" style="max-width: 420px;">
                    <div class="small fw-bold text-dark mb-1.5 d-flex align-items-center gap-1.5">
                        <i class="ti ti-key text-primary"></i> Punya Kode Akses Kelas?
                    </div>
                    @using (Html.BeginForm("GabungKelas", "Siswa", FormMethod.Post, new { @class = "m-0" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <input type="text" name="KodeKelas" id="inputKodeAksesGlobal" class="form-control form-control-sm font-monospace text-uppercase fw-bold rounded-start-3" placeholder="Contoh: KLS-001" required autocomplete="off" />
                            <button type="submit" class="btn btn-sm btn-primary rounded-end-3 px-3 fw-bold" style="background-color: #395886; border-color: #395886;">
                                <i class="ti ti-user-plus me-1"></i> Gabung
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter & Search Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        @using (Html.BeginForm("KatalogKelas", "Siswa", FormMethod.Get, new { @class = "row g-2 align-items-center m-0" }))
        {
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted">
                        <i class="ti ti-search"></i>
                    </span>
                    <input type="text" name="search" value="@Model.SearchKeyword" class="form-control rounded-end-3 border-start-0" placeholder="Cari nama kelas, pengajar, atau deskripsi..." />
                </div>
            </div>

            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted">
                        <i class="ti ti-category"></i>
                    </span>
                    <select name="kategori" class="form-select rounded-end-3 border-start-0">
                        <option value="">-- Semua Kategori --</option>
                        @foreach (var kat in Model.DaftarKategoriOptions)
                        {
                            <option value="@kat" @(Model.FilterKategori == kat ? "selected" : "")>@kat</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill rounded-3 fw-bold" style="background-color: #638ECB; border-color: #638ECB;">
                    <i class="ti ti-filter me-1"></i> Terapkan Filter
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchKeyword) || !string.IsNullOrEmpty(Model.FilterKategori))
                {
                    <a href="@Url.Action("KatalogKelas", "Siswa")" class="btn btn-sm btn-outline-secondary rounded-3 px-2.5" title="Reset filter">
                        <i class="ti ti-refresh"></i>
                    </a>
                }
            </div>
        }
    </div>
</div>

<!-- Grid Daftar Kelas -->
@if (Model.DaftarKelas != null && Model.DaftarKelas.Any())
{
    <div class="row g-3 mb-4">
        @foreach (var k in Model.DaftarKelas)
        {
            string cardGradient = getCategoryGradient(k.NamaKategori);
            string catIcon = getCategoryIcon(k.NamaKategori);

            <div class="col-md-6 col-lg-4">
                <div class="card katalog-card h-100 d-flex flex-column">
                    <!-- Banner Visual Kelas -->
                    <div class="card-banner-wrapper" style="background: @cardGradient;">
                        <!-- Watermark Dekoratif Icon di Latar Belakang -->
                        <div class="watermark-bg-icon">
                            <i class="@catIcon" style="font-size: 6.8rem; line-height: 1;"></i>
                        </div>

                        <!-- Gambar Banner Riil (Jika Valid, dan Hapus Otomatis jika File 404) -->
                        @if (!string.IsNullOrEmpty(k.BannerImage))
                        {
                            <img src="@k.BannerImage" alt="" class="w-100 h-100 object-fit-cover position-absolute top-0 start-0" style="z-index: 1;" onerror="this.remove();" />
                        }

                        <!-- Overlay Badge Atas (Kategori di Kiri, Status Terdaftar / Kode di Kanan) -->
                        <div class="position-absolute top-0 start-0 end-0 p-3 d-flex justify-content-between align-items-center" style="z-index: 2;">
                            <span class="category-glass-badge" title="@k.NamaKategori">
                                <i class="@catIcon me-1"></i>@k.NamaKategori
                            </span>

                            @if (k.IsEnrolled)
                            {
                                <span class="badge bg-success text-white rounded-pill px-2.5 py-1.5 shadow-sm font-semibold">
                                    <i class="ti ti-circle-check me-1"></i>Terdaftar
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-white text-dark rounded-pill px-2.5 py-1.5 shadow-sm font-monospace small fw-bold">
                                    <i class="ti ti-key text-muted me-1"></i>@k.KodeKelas
                                </span>
                            }
                        </div>

                        <!-- Overlay Badge Bawah (Kode Akses jika Sudah Terdaftar) -->
                        @if (k.IsEnrolled)
                        {
                            <div class="position-absolute bottom-0 start-0 p-3" style="z-index: 2;">
                                <span class="badge bg-white text-dark rounded-pill px-2.5 py-1 shadow-sm font-monospace extra-small fw-bold">
                                    <i class="ti ti-key text-muted me-1"></i>@k.KodeKelas
                                </span>
                            </div>
                        }
                    </div>

                    <!-- Body Card -->
                    <div class="card-body p-3.5 d-flex flex-column flex-fill">
                        <!-- Judul Kelas -->
                        <h3 class="fw-bold text-dark mb-1.5 fs-4" style="line-height: 1.35; height: 48px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@k.NamaKelas">
                            @k.NamaKelas
                        </h3>

                        <!-- Deskripsi Singkat -->
                        <p class="text-secondary small mb-3 flex-fill" style="line-height: 1.45; height: 38px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrWhiteSpace(k.Deskripsi) ? "Pelatihan kurikulum terpadu dan terstruktur bersama instruktur berpengalaman." : k.Deskripsi)
                        </p>

                        <!-- Profil Instruktur / Guru -->
                        <div class="d-flex align-items-center gap-2 mb-3 pt-2 border-top">
                            @if (!string.IsNullOrEmpty(k.FotoGuru))
                            {
                                <img src="@k.FotoGuru" class="avatar avatar-sm rounded-circle border shadow-sm" alt="@k.NamaGuru" onerror="this.remove();" />
                            }
                            else
                            {
                                <span class="avatar avatar-sm text-white rounded-circle fw-bold shadow-sm" style="background: linear-gradient(135deg, #395886, #638ECB);">
                                    @(!string.IsNullOrEmpty(k.NamaGuru) ? k.NamaGuru.Substring(0, 1).ToUpper() : "G")
                                </span>
                            }
                            <div class="min-w-0">
                                <div class="fw-semibold text-dark text-truncate small">@k.NamaGuru</div>
                                <div class="text-muted extra-small">Instruktur Pengajar</div>
                            </div>
                        </div>

                        <!-- Metrik Fasilitas Kelas -->
                        <div class="row g-1 text-center small text-muted py-2 bg-light rounded-3 mb-3 border border-light-subtle">
                            <div class="col-3 border-end">
                                <div class="fw-bold text-dark fs-5">@k.TotalSiswa</div>
                                <div class="extra-small text-muted">Siswa</div>
                            </div>
                            <div class="col-3 border-end">
                                <div class="fw-bold text-dark fs-5">@k.TotalMateri</div>
                                <div class="extra-small text-muted">Materi</div>
                            </div>
                            <div class="col-3 border-end">
                                <div class="fw-bold text-dark fs-5">@k.TotalQuiz</div>
                                <div class="extra-small text-muted">Kuis</div>
                            </div>
                            <div class="col-3">
                                <div class="fw-bold text-dark fs-5">@k.TotalTugas</div>
                                <div class="extra-small text-muted">Tugas</div>
                            </div>
                        </div>

                        <!-- Tombol Aksi -->
                        <div class="mt-auto">
                            @if (k.IsEnrolled)
                            {
                                <a href="@Url.Action("RuangKelas", "Siswa", new { id = k.IdKelas, tab = "stream" })" class="btn btn-sm btn-primary w-100 rounded-3 py-2 fw-bold shadow-sm" style="background-color: #059669; border-color: #059669;">
                                    <i class="ti ti-door-enter me-1"></i> Buka Ruang Kelas
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary w-100 rounded-3 py-2 fw-bold" style="border-color: #395886; color: #395886;" onclick="quickFillAndFocus('@k.KodeKelas')">
                                    <i class="ti ti-login me-1"></i> Gabung Kelas Ini
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Empty State -->
    <div class="card border-0 shadow-sm rounded-4 text-center py-5">
        <div class="card-body py-5">
            <div class="empty-icon mb-3 text-muted">
                <i class="ti ti-books-off fs-1 opacity-50" style="font-size: 3.5rem;"></i>
            </div>
            <h2 class="empty-title fw-bold text-dark mb-2">Kelas Tidak Ditemukan</h2>
            <p class="empty-subtitle text-secondary mx-auto mb-4" style="max-width: 480px;">
                Tidak ada kelas yang sesuai dengan kata kunci pencarian atau filter kategori yang dipilih. Silakan coba filter lainnya.
            </p>
            <a href="@Url.Action("KatalogKelas", "Siswa")" class="btn btn-sm btn-outline-primary rounded-3 px-4 py-2 fw-bold">
                <i class="ti ti-refresh me-1"></i> Tampilkan Semua Kelas
            </a>
        </div>
    </div>
}

@section scripts {
    <script>
        function quickFillAndFocus(kodeKelas) {
            var input = document.getElementById('inputKodeAksesGlobal');
            if (input) {
                input.value = kodeKelas;
                input.focus();
                input.scrollIntoView({ behavior: 'smooth', block: 'center' });
                // Efek animasi highlight sementara
                input.classList.add('is-valid');
                setTimeout(function () {
                    input.classList.remove('is-valid');
                }, 2000);
            }
        }
    </script>
}
