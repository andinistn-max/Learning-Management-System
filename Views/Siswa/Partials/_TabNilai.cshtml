@model Learning_Management_System.Models.ViewModel.SiswaRincianNilaiKelasViewModel

<!-- Card Summary Nilai Akhir Kumulatif -->
<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
    <div class="card-body p-4 p-md-5">
        <div class="row align-items-center g-4">
            <div class="col-md-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge font-monospace px-3 py-1" style="background-color: rgba(57, 88, 134, 0.1); color: #395886; border: 1px solid rgba(57, 88, 134, 0.25);">
                        REKAPITULASI EVALUASI KELAS
                    </span>
                    <span class="badge @(Model.StatusKelulusan == "Lulus" ? "bg-success text-white" : "bg-warning text-dark") rounded-pill px-3 py-1 font-semibold">
                        <i class="ti @(Model.StatusKelulusan == "Lulus" ? "ti-circle-check" : "ti-alert-triangle") me-1"></i>Status: @Model.StatusKelulusan
                    </span>
                </div>
                <h2 class="fw-bold text-dark mb-2">Transkrip &amp; Rincian Perolehan Nilai</h2>
                <p class="text-secondary small mb-4">
                    Kalkulasi nilai akhir dihitung berdasarkan pembobotan resmi: <strong>15% Presensi</strong>, <strong>15% Progres Materi</strong>, <strong>40% Rata-rata Kuis</strong>, dan <strong>30% Rata-rata Tugas</strong>.
                </p>

                <a href="@Url.Action("CetakRaportKelas", "Siswa", new { id = Model.KelasId })" target="_blank" class="btn text-white rounded-3 px-4 py-2.5 fw-bold shadow-sm" style="background-color: #395886;">
                    <i class="ti ti-printer me-1.5"></i> Cetak / Unduh Lembar Raport
                </a>
            </div>

            <div class="col-md-5 text-center text-md-end">
                <div class="p-4 bg-light rounded-4 border d-inline-block text-center w-100" style="max-width: 280px;">
                    <div class="extra-small text-muted font-monospace text-uppercase tracking-wider">NILAI AKHIR KUMULATIF</div>
                    <div class="display-4 fw-extrabold my-1" style="color: #395886;">
                        @Model.NilaiAkhirKumulatif.ToString("0.00")
                    </div>
                    <div class="d-flex align-items-center justify-content-center gap-2 mt-2">
                        <span class="badge bg-dark text-white fs-3 px-3 py-1 rounded-3">Grade @Model.PredikatHuruf</span>
                        <span class="small text-muted font-monospace">/ 100 Poin</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 4 Component Cards (Breakdown Pembobotan) -->
<div class="row g-3 mb-4">
    <!-- 1. Presensi (15%) -->
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="extra-small font-monospace text-muted">BOBOT 15%</span>
                <span class="avatar avatar-xs bg-success-subtle text-success rounded-circle">
                    <i class="ti ti-user-check"></i>
                </span>
            </div>
            <div class="fw-bold text-dark mb-1">Presensi Kelas</div>
            <div class="fs-2 fw-extrabold text-success">@Model.PoinBobotAbsensi.ToString("0.00") <span class="fs-5 text-muted font-normal">/15</span></div>
            <div class="progress progress-xs rounded-pill my-2" style="height: 6px;">
                <div class="progress-bar bg-success rounded-pill" style="width: @Model.SkorAbsensi.ToString("0")%;"></div>
            </div>
            <div class="extra-small text-muted">@Model.TotalHadir dari @Model.TotalSesi Sesi (@Model.SkorAbsensi.ToString("0")%)</div>
        </div>
    </div>

    <!-- 2. Materi (15%) -->
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="extra-small font-monospace text-muted">BOBOT 15%</span>
                <span class="avatar avatar-xs rounded-circle" style="background-color: rgba(57, 88, 134, 0.12); color: #395886 !important;">
                    <i class="ti ti-book"></i>
                </span>
            </div>
            <div class="fw-bold text-dark mb-1">Progres Materi</div>
            <div class="fs-2 fw-extrabold" style="color: #395886 !important;">@Model.PoinBobotMateri.ToString("0.00") <span class="fs-5 text-muted font-normal">/15</span></div>
            <div class="progress progress-xs rounded-pill my-2" style="height: 6px;">
                <div class="progress-bar rounded-pill" style="width: @Model.SkorMateri.ToString("0")%; background-color: #395886 !important;"></div>
            </div>
            <div class="extra-small text-muted">@Model.TotalMateriSelesai dari @Model.TotalMateri Modul (@Model.SkorMateri.ToString("0")%)</div>
        </div>
    </div>

    <!-- 3. Quiz (40%) -->
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="extra-small font-monospace text-muted">BOBOT 40%</span>
                <span class="avatar avatar-xs bg-purple-subtle text-purple rounded-circle" style="color: #8b5cf6 !important;">
                    <i class="ti ti-help-hexagon"></i>
                </span>
            </div>
            <div class="fw-bold text-dark mb-1">Rata-rata Quiz</div>
            <div class="fs-2 fw-extrabold text-purple" style="color: #8b5cf6 !important;">@Model.PoinBobotQuiz.ToString("0.00") <span class="fs-5 text-muted font-normal">/40</span></div>
            <div class="progress progress-xs rounded-pill my-2" style="height: 6px;">
                <div class="progress-bar bg-purple rounded-pill" style="width: @Model.RataRataQuiz.ToString("0")%; background-color: #8b5cf6 !important;"></div>
            </div>
            <div class="extra-small text-muted">Rata-rata Skor: @Model.RataRataQuiz.ToString("0.0")</div>
        </div>
    </div>

    <!-- 4. Tugas (30%) -->
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="extra-small font-monospace text-muted">BOBOT 30%</span>
                <span class="avatar avatar-xs bg-warning-subtle text-warning-emphasis rounded-circle">
                    <i class="ti ti-clipboard-list"></i>
                </span>
            </div>
            <div class="fw-bold text-dark mb-1">Rata-rata Tugas</div>
            <div class="fs-2 fw-extrabold text-warning-emphasis">@Model.PoinBobotTugas.ToString("0.00") <span class="fs-5 text-muted font-normal">/30</span></div>
            <div class="progress progress-xs rounded-pill my-2" style="height: 6px;">
                <div class="progress-bar bg-warning rounded-pill" style="width: @Model.RataRataTugas.ToString("0")%;"></div>
            </div>
            <div class="extra-small text-muted">Rata-rata Skor: @Model.RataRataTugas.ToString("0.0")</div>
        </div>
    </div>
</div>

<!-- Breakdown Details Tables -->
<div class="row g-4 mb-4">
    <!-- Tabel Nilai Quiz -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h4 class="card-title fw-bold text-dark m-0">
                    <i class="ti ti-help-hexagon me-2 text-purple" style="color: #8b5cf6 !important;"></i>Rincian Nilai Kuis Online
                </h4>
                <span class="badge bg-light text-dark font-monospace border">
                    Bobot: 40%
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-vcenter card-table align-middle">
                    <thead class="bg-light text-secondary extra-small text-uppercase font-monospace">
                        <tr>
                            <th>Judul Kuis</th>
                            <th>Waktu Submit</th>
                            <th class="text-end">Skor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DaftarNilaiQuiz != null && Model.DaftarNilaiQuiz.Any())
                        {
                            foreach (var q in Model.DaftarNilaiQuiz)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@q.JudulQuiz</td>
                                    <td class="small text-muted font-monospace">
                                        @(q.Tanggal.HasValue ? q.Tanggal.Value.ToString("dd MMM yyyy HH:mm") : "-")
                                    </td>
                                    <td class="text-end">
                                        @if (q.SkorPerolehan.HasValue)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace px-3 py-1 fs-5">
                                                @q.SkorPerolehan.Value.ToString("0")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border font-monospace px-2 py-1">
                                                Belum Dikerjakan
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted p-4 small">Belum ada data kuis pada kelas ini.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Tabel Nilai Tugas -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h4 class="card-title fw-bold text-dark m-0">
                    <i class="ti ti-file-certificate me-2 text-warning"></i>Rincian Nilai Penugasan
                </h4>
                <span class="badge bg-light text-dark font-monospace border">
                    Bobot: 30%
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-vcenter card-table align-middle">
                    <thead class="bg-light text-secondary extra-small text-uppercase font-monospace">
                        <tr>
                            <th>Judul Tugas</th>
                            <th>Status &amp; Submisi</th>
                            <th class="text-end">Nilai</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DaftarNilaiTugas != null && Model.DaftarNilaiTugas.Any())
                        {
                            foreach (var t in Model.DaftarNilaiTugas)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@t.JudulTugas</div>
                                        @if (!string.IsNullOrEmpty(t.FeedbackGuru))
                                        {
                                            <div class="extra-small text-muted fst-italic">
                                                <i class="ti ti-message-dots me-1 text-info"></i>"@t.FeedbackGuru"
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (t.Status == "Sudah Dinilai")
                                        {
                                            <span class="badge bg-success text-white rounded-pill px-2.5 py-0.5 extra-small">Dinilai</span>
                                        }
                                        else if (t.Status == "Diserahkan")
                                        {
                                            <span class="badge text-white rounded-pill px-2.5 py-0.5 extra-small" style="background-color: #395886 !important;">Diserahkan</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-0.5 extra-small">Belum</span>
                                        }
                                        <div class="extra-small text-muted font-monospace mt-0.5">
                                            Deadline: @t.Deadline.ToString("dd MMM")
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        @if (t.NilaiTugas.HasValue)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle font-monospace px-3 py-1 fs-5">
                                                @t.NilaiTugas.Value.ToString("0")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border font-monospace px-2 py-1">
                                                -
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted p-4 small">Belum ada data tugas pada kelas ini.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
