@model Learning_Management_System.Models.ViewModel.SiswaGlobalMateriViewModel
@{
    Layout = "~/Views/Shared/_LayoutSiswa.cshtml";
    ViewBag.Title = "Semua Materi Modul Siswa";
}

<style type="text/css">
    /* ==========================================================================
       HALAMAN SEMUA MATERI MODUL SISWA - MODERN SOFT BLUE THEME
       ========================================================================== */

    /* 1. Bar Pencarian & Filter Presisi */
    .filter-search-container {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 18px;
        padding: 1.1rem 1.25rem;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
        margin-bottom: 1.5rem;
    }
    .input-filter-control {
        height: 44px !important;
        border-radius: 12px !important;
        border: 1px solid #CBD5E1 !important;
        font-size: 0.9rem !important;
        transition: all 0.2s ease;
    }
    .input-filter-control:focus {
        border-color: #2563EB !important;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
    }
    .btn-filter-submit {
        height: 44px !important;
        background: #2563EB !important;
        color: #FFFFFF !important;
        font-weight: 600 !important;
        border: none !important;
        padding: 0 1.5rem !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 8px !important;
        border-radius: 12px !important;
        transition: all 0.2s ease !important;
        font-size: 0.9rem !important;
        width: 100%;
        text-decoration: none !important;
    }
    .btn-filter-submit:hover {
        background: #1D4ED8 !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25) !important;
        color: #FFFFFF !important;
    }

    /* 2. File Card ala Recent Files Medcare */
    .materi-file-card {
        border-radius: 18px !important;
        background: #FFFFFF !important;
        border: 1px solid #E2E8F0 !important;
        padding: 1.25rem 1.5rem !important;
        margin-bottom: 1rem !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03) !important;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
    }
    .materi-file-card:hover {
        background: #F8FAFC !important;
        border-color: #BFDBFE !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.08) !important;
    }

    .file-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        flex-shrink: 0;
    }
    .file-icon-pdf {
        background: #FEE2E2;
        color: #DC2626;
    }
    .file-icon-pptx {
        background: #EFF6FF;
        color: #2563EB;
    }
    .file-icon-video {
        background: #F3E8FF;
        color: #9333EA;
    }
    .file-icon-doc {
        background: #E0F2FE;
        color: #0284C7;
    }

    .badge-class-pill {
        background: #EFF6FF;
        color: #1D4ED8;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 20px;
        padding: 2px 10px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .badge-status-read {
        background: #DCFCE7;
        color: #15803D;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 20px;
        padding: 2px 10px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .badge-status-unread {
        background: #FEF3C7;
        color: #B45309;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 20px;
        padding: 2px 10px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .materi-title-text {
        color: #0F172A;
        font-weight: 700;
        font-size: 1.05rem;
        margin: 4px 0;
        line-height: 1.35;
    }

    .materi-meta-sub {
        color: #64748B;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .btn-action-materi {
        background: #2563EB !important;
        color: #FFFFFF !important;
        border-radius: 10px !important;
        padding: 8px 18px !important;
        font-size: 0.85rem !important;
        font-weight: 600 !important;
        text-decoration: none !important;
        border: none !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        transition: all 0.2s ease !important;
        white-space: nowrap !important;
    }
    .btn-action-materi:hover {
        background: #1D4ED8 !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25) !important;
        color: #FFFFFF !important;
    }
</style>

<!-- ==========================================================================
     BAR PENCARIAN & TOMBOL FILTER PRESISI (HEIGHT: 44PX)
     ========================================================================== -->
<div class="filter-search-container">
    @using (Html.BeginForm("SemuaMateri", "Siswa", FormMethod.Get, new { id = "form-filter-materi" }))
    {
        <div class="row g-3 align-items-center">
            <div class="col-md-6 col-lg-7">
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <i class="ti ti-search text-secondary"></i>
                    </span>
                    <input type="text" name="search" class="form-control input-filter-control ps-5" placeholder="Cari judul materi atau nama kelas..." value="@Model.SearchKeyword" />
                </div>
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="kategori" class="form-select input-filter-control" onchange="document.getElementById('form-filter-materi').submit();">
                    <option value="">-- Semua Kategori --</option>
                    @if (Model.DaftarKategoriOptions != null)
                    {
                        foreach (var cat in Model.DaftarKategoriOptions)
                        {
                            <option value="@cat" @(Model.FilterKategori == cat ? "selected" : "")>@cat</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <button type="submit" class="btn-filter-submit">
                    <i class="ti ti-filter"></i>
                    <span>Filter</span>
                </button>
            </div>
        </div>
    }
</div>

<!-- ==========================================================================
     DAFTAR KARTU BERKAS MODUL MATERI (RECENT FILES STYLE)
     ========================================================================== -->
@if (Model.DaftarMateri != null && Model.DaftarMateri.Any())
{
    <div class="row">
        @foreach (var m in Model.DaftarMateri)
        {
            string iconBoxClass = "file-icon-pptx";
            string iconName = "ti ti-presentation";
            string extensionText = "PPTX";

            if (m.TipeFile != null && m.TipeFile.Equals("PDF", StringComparison.OrdinalIgnoreCase))
            {
                iconBoxClass = "file-icon-pdf";
                iconName = "ti ti-file-type-pdf";
                extensionText = "PDF";
            }
            else if (m.TipeFile != null && m.TipeFile.Equals("Video", StringComparison.OrdinalIgnoreCase))
            {
                iconBoxClass = "file-icon-video";
                iconName = "ti ti-video";
                extensionText = "MP4";
            }
            else if (m.NamaFile != null && m.NamaFile.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                iconBoxClass = "file-icon-pdf";
                iconName = "ti ti-file-type-pdf";
                extensionText = "PDF";
            }
            else if (m.NamaFile != null && (m.NamaFile.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || m.NamaFile.EndsWith(".docx", StringComparison.OrdinalIgnoreCase)))
            {
                iconBoxClass = "file-icon-doc";
                iconName = "ti ti-file-text";
                extensionText = "DOC";
            }

            <div class="col-12">
                <div class="materi-file-card flex-column flex-md-row align-items-start align-items-md-center">
                    <!-- Tata Letak Kiri (Ikon & Informasi Materi) -->
                    <div class="d-flex align-items-center gap-3 flex-fill w-100">
                        <div class="file-icon-box @iconBoxClass" title="Tipe Berkas: @(m.TipeFile ?? extensionText)">
                            <i class="@iconName" style="font-size: 1.45rem;"></i>
                        </div>

                        <div class="flex-fill min-w-0">
                            <!-- Baris 1: Badge Nama Kelas & Badge Status -->
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <span class="badge-class-pill" title="Kelas: @m.NamaKelas">
                                    <i class="ti ti-building-community" style="font-size: 0.75rem;"></i>
                                    <span class="text-truncate" style="max-width: 240px;">@m.NamaKelas</span>
                                </span>

                                @if (m.IsSudahDipelajari)
                                {
                                    <span class="badge-status-read">
                                        <i class="ti ti-circle-check" style="font-size: 0.75rem;"></i>
                                        <span>Sudah Dipelajari</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status-unread">
                                        <i class="ti ti-clock" style="font-size: 0.75rem;"></i>
                                        <span>Belum Dibaca</span>
                                    </span>
                                }
                            </div>

                            <!-- Baris 2: Judul Materi -->
                            <h4 class="materi-title-text text-truncate" title="@m.JudulMateri">@m.JudulMateri</h4>

                            <!-- Baris 3: Nama file berkas & tanggal rilis -->
                            <div class="materi-meta-sub">
                                <span><i class="ti ti-paperclip me-1"></i>@m.NamaFile</span>
                                <span>&bull;</span>
                                <span><i class="ti ti-calendar me-1"></i>Rilis: @m.TanggalUpload.ToString("dd MMM yyyy HH:mm")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Tata Letak Kanan (Tombol Aksi yang Proporsional) -->
                    <div class="flex-shrink-0 align-self-stretch align-self-md-center d-flex align-items-center justify-content-end mt-2 mt-md-0">
                        <a href="@Url.Action("RuangKelas", "Siswa", new { id = m.KelasId, tab = "materi" })" class="btn-action-materi">
                            <i class="ti ti-book-2" style="font-size: 0.95rem;"></i>
                            <span>Pelajari / Buka Modul</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Empty State Modern Soft Blue -->
    <div class="card border-0 rounded-4 p-5 text-center" style="background: linear-gradient(135deg, #FFFFFF 0%, #F0F7FF 100%); border: 1px solid #BFDBFE !important; box-shadow: 0 4px 20px rgba(37, 99, 235, 0.05);">
        <div class="mb-3">
            <div class="d-inline-flex align-items-center justify-content-center" style="width: 72px; height: 72px; background: #EFF6FF; border-radius: 20px; color: #2563EB;">
                <i class="ti ti-file-off" style="font-size: 2.2rem;"></i>
            </div>
        </div>
        <h3 class="fw-bold mb-1" style="color: #0F172A;">Materi Tidak Ditemukan</h3>
        <p class="text-muted small mx-auto mb-0" style="max-width: 420px;">
            Tidak ada modul pembelajaran yang sesuai dengan kata kunci pencarian atau filter kategori yang ditentukan.
        </p>
    </div>
}
