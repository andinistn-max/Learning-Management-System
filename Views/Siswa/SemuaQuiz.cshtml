@model Learning_Management_System.Models.ViewModel.SiswaGlobalQuizViewModel
@{
    Layout = "~/Views/Shared/_LayoutSiswa.cshtml";
    ViewBag.Title = "Semua Kuis Online Siswa";
}

<!-- Page Header -->
<div class="row align-items-center mb-4">
    <div class="col">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill px-3 py-1 font-monospace" style="color: #8b5cf6 !important;">
                <i class="ti ti-help-hexagon me-1"></i>Evaluasi Ujian &amp; Quiz
            </span>
        </div>
        <h1 class="fw-extrabold text-dark display-6 mb-1">Semua Kuis &amp; Ujian Online</h1>
        <div class="text-muted small">
            Daftar kuis interaktif dari seluruh kelas Anda. Dapatkan skor instan dan tingkatkan pemahaman materi.
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <span class="avatar avatar-md bg-purple-subtle text-purple rounded-3" style="color: #8b5cf6 !important;">
                    <i class="ti ti-help-hexagon fs-2"></i>
                </span>
                <div>
                    <div class="text-muted extra-small fw-semibold">TOTAL KUIS</div>
                    <div class="fw-extrabold text-dark fs-2 mb-0">@Model.TotalKuis</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <span class="avatar avatar-md bg-success-subtle text-success rounded-3">
                    <i class="ti ti-circle-check fs-2"></i>
                </span>
                <div>
                    <div class="text-muted extra-small fw-semibold">SUDAH DIKERJAKAN</div>
                    <div class="fw-extrabold text-dark fs-2 mb-0">@Model.TotalSudahDikerjakan</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <span class="avatar avatar-md bg-warning-subtle text-warning rounded-3">
                    <i class="ti ti-clock-hour-4 fs-2"></i>
                </span>
                <div>
                    <div class="text-muted extra-small fw-semibold">BELUM DIKERJAKAN</div>
                    <div class="fw-extrabold text-dark fs-2 mb-0">@Model.TotalBelumDikerjakan</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Grid Cards Kuis Lintas Kelas -->
@if (Model.DaftarQuiz != null && Model.DaftarQuiz.Any())
{
    <div class="row g-3">
        @foreach (var q in Model.DaftarQuiz)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 d-flex flex-column">
                    <div class="card-body p-4 d-flex flex-column flex-fill">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-dark text-white rounded-pill px-2.5 py-1 font-monospace" style="font-size: 0.7rem;">
                                <i class="ti ti-building-community me-1"></i>@q.NamaKelas
                            </span>

                            @if (q.StatusPengerjaan == "Sudah Dikerjakan")
                            {
                                <span class="badge bg-success text-white rounded-pill px-2.5 py-1 font-semibold">
                                    <i class="ti ti-star me-1"></i>Skor: @(q.Skor.HasValue ? q.Skor.Value.ToString("0") : "0")
                                </span>
                            }
                            else if (q.StatusPengerjaan == "Waktu Habis")
                            {
                                <span class="badge bg-danger text-white rounded-pill px-2.5 py-1 font-semibold">
                                    Expired
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 font-semibold">
                                    Belum Dikerjakan
                                </span>
                            }
                        </div>

                        <h4 class="fw-bold text-dark mb-2 text-truncate" title="@q.JudulQuiz">@q.JudulQuiz</h4>

                        <div class="d-flex align-items-center gap-3 text-muted small mb-3">
                            <div><i class="ti ti-clock me-1 text-info"></i>@q.DurasiMenit Menit</div>
                            <div><i class="ti ti-list-check me-1 text-primary"></i>@q.TotalSoal Soal</div>
                        </div>

                        <div class="text-muted extra-small mb-3 mt-auto">
                            <i class="ti ti-calendar me-1"></i>Batas Akhir: @q.WaktuSelesaiFormat
                        </div>

                        <div class="pt-3 border-top mt-auto">
                            <a href="@Url.Action("RuangKelas", "Siswa", new { id = q.KelasId, tab = "quiz" })" class="btn text-white rounded-3 w-100 py-2 fw-bold shadow-sm" style="background-color: #8b5cf6;">
                                @(q.StatusPengerjaan == "Sudah Dikerjakan" ? "Lihat Hasil Kuis" : "Mulai Kuis Sekarang") <i class="ti ti-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Empty State -->
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
        <div class="mb-3">
            <span class="avatar avatar-xl bg-purple-subtle text-purple rounded-circle p-3" style="color: #8b5cf6 !important;">
                <i class="ti ti-help-off fs-1"></i>
            </span>
        </div>
        <h3 class="fw-bold text-dark mb-1">Belum Ada Kuis Tersedia</h3>
        <p class="text-muted small mx-auto mb-0" style="max-width: 420px;">
            Guru belum menerbitkan kuis atau ujian online pada kelas yang Anda ikuti.
        </p>
    </div>
}
